@inject CompanioNationSignalRClient? SignalRClient
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedStrings> Loc
@implements IAsyncDisposable

<button class="feedbackButtonClass" aria-label="@Loc["Feedback_SendFeedback"]">
    <img src="/images/feedback-icon.png" alt="@Loc["Feedback_Alt"]" draggable="false" />
</button>

@if (showPopup)
{
    <div class="blurred-background" @onclick="CancelPopup"></div>
    <div class="popupClass">
        <div class="feedback-encouragement">@Loc["Feedback_Encouragement"]</div>
        <textarea @bind="feedbackText" @bind:event="oninput" placeholder="@Loc["Feedback_Placeholder"]" maxlength="2000"></textarea>
        <div class="popup-buttons">
            <button class="sendButton" @onclick="SubmitFeedback" disabled="@isSubmitDisabled">
                <span class="send-icon">▶</span> @Loc["Feedback_Send"]
            </button>
            <button class="cancelButton" @onclick="CancelPopup">@Loc["Report_Cancel"]</button>
        </div>
    </div>
}

@if (showThankYouMessage)
{
    <div class="thank-you-message">@Loc["Feedback_ThankYou"]</div>
}

@code {
    private bool showPopup;
    private bool showThankYouMessage;
    private string feedbackText = string.Empty;
    private bool isSubmitDisabled => string.IsNullOrWhiteSpace(feedbackText);
    private IJSObjectReference? module;
    private DotNetObjectReference<FeedbackButton>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            module = await JSRuntime.ImportModuleAsync(
                "/Components/FeedbackButton.razor.js",
                SignalRClient is not null ? SignalRClient.LogError : null);
            if (module is not null)
            {
                await module.InvokeVoidAsync("initializeFeedbackButton", dotNetRef);
            }
        }
    }

    [JSInvokable]
    public void ShowPopup()
    {
        showPopup = true;
        StateHasChanged();
    }

    private void CancelPopup()
    {
        showPopup = false;
        feedbackText = string.Empty;
    }

    private async Task SubmitFeedback()
    {
        if (!string.IsNullOrWhiteSpace(feedbackText) && SignalRClient is not null)
        {
            try
            {
                await SignalRClient.Initialize();
                await SignalRClient.SendFeedback(feedbackText);

                feedbackText = string.Empty;
                showPopup = false;
                showThankYouMessage = true;

                await Task.Delay(3000);
                showThankYouMessage = false;
            }
            catch (Exception ex)
            {
                SignalRClient.LogError(ex, "SubmitFeedback");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.DisposeAsync();
        }
        dotNetRef?.Dispose();
    }
}
