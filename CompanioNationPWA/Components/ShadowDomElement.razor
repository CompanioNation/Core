@inject ICompanioNationSignalRClient? SignalRClient
@inject IJSRuntime JSRuntime
@using CompanioNation.Shared

@if (OperatingSystem.IsBrowser())
{
    <div @ref="ShadowContainer"></div>
}
else
{
    // SSR/no-JS: AI-authored HTML must be rendered style-isolated so its own
    // <style> cannot leak onto the host page. Discard the AI's CSS and apply the
    // curated .cn-advice editorial design instead.
    <div>@((MarkupString)Util.RenderAdviceContent(Html, Compact))</div>
}

@code {
        private string? _renderedHtml;

    [Parameter, EditorRequired]
    public string Html { get; set; } = string.Empty;

    /// <summary>
    /// When true, applies the compact CompanioNita style variant so AI output in
    /// tight chat bubbles uses less vertical spacing. Only the main-page chat opts
    /// in; daily-advice and messages-pane output keep the full editorial spacing.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    private ElementReference ShadowContainer;
    private IJSObjectReference? module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!OperatingSystem.IsBrowser())
            return;

        if (firstRender)
        {
            module = await JSRuntime.ImportModuleAsync(
                "/Components/ShadowDomElement.razor.js",
                SignalRClient is not null ? SignalRClient.LogError : null);
        }

        // Paint whenever the module is ready and the current Html hasn't been
        // pushed to the shadow root yet. This runs after every render, so it can
        // never be stranded blank by a first-render/import race or by the value
        // being set before the JS module finished loading.
        if (module is not null && _renderedHtml != Html)
        {
            _renderedHtml = Html;
            try
            {
                // Render the AI content style-isolated: discard its own <style> and
                // inject the curated .cn-advice design into the shadow root.
                await JSRuntime.InvokeVoidAsync("loadHtmlIntoShadowDOM", ShadowContainer, Util.RenderAdviceContent(Html, Compact));
            }
            catch (Exception ex)
            {
                SignalRClient?.LogError(ex);
            }
        }
    }

    public void Dispose()
    {
        if (module is not null)
        {
            module.DisposeAsync();
        }
    }

}
