@inherits ComponentBase
@inject IStringLocalizer<SharedStrings> Loc


<button type="button" @onclick="HandleClick" class="x-sign-in-button" style="width:26em; max-width: calc(100% - 2em);">
    <div class="x-sign-in-button-content">
        <div class="x-sign-in-button-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" style="display:block;">
                <path fill="#fff" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
        </div>
        <span class="x-sign-in-button-text">@Loc["SignIn_X"]</span>
    </div>
</button>


@code {
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
