@inject IJSRuntime JSRuntime
@inject ICompanioNationSignalRClient? SignalRClient
@inject HttpClient Http
@inject NavigationManager NavManager
@inject IStringLocalizer<SharedStrings> Loc
@using CompanioNation.Shared
@using CompanioNationPWA.Services
@using System.Net.Http.Json


<div class="advice-card">
    <h3><img src="/images/CompanioNita.png" alt="" width="512" height="512" class="companionita-icon" /> @Loc["Advice_Title"]</h3>

    @if (_loadingAdvice)
    {
        <h3>@Loc["Advice_Loading"]</h3>
        <img src="/favicon.png" alt="" width="512" height="512" class="advice-loading-icon" />
    }
    else
    {
        <ShareButton ShareTitle="@Loc["Advice_ShareTitle"]"
                     ShareText="@shareText"
                     ShareUrl="https://companionation.com/" />
        <ShadowDomElement Html="@dailyAdvice"></ShadowDomElement>
    }

    <div class="nav-button-wrapper">
        <a href="/CompanioNitasCorner/">@Loc["Advice_ReadPast"]</a>
    </div>


</div>

@code {

    private string dailyAdvice = "Loading advice...";
    private string shareText = "";
    private bool _loadingAdvice = true;

    protected override async Task OnInitializedAsync()
    {
        if (SignalRClient is null || !SignalRClient.IsPrerendering) return;

        // SSR prerendering: fetch daily advice via REST API so bots/crawlers
        // and JS-disabled visitors see the actual advice content, not a loading spinner.
        try
        {
            Settings? settings = await Http.GetFromJsonAsync<Settings>(
                $"{NavManager.BaseUri}api/settings?lang={CultureService.GetCurrentCulture()}");

            dailyAdvice = string.IsNullOrWhiteSpace(settings?.DailyAdvice)
                ? Loc["Advice_NoAdvice"]
                : settings.DailyAdvice;
            shareText = $"{Loc["Advice_ShareText"]}\n{Util.StripHtmlTags(dailyAdvice)}";
            _loadingAdvice = false;
        }
        catch { /* silently fail — WASM boot will retry via SignalR */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SignalRClient is null || SignalRClient.IsPrerendering) return;

        if (firstRender)
        {
            // Load the daily advice when the component is initialized
            await LoadCachedAdvice();
            await LoadDailyAdvice();
            StateHasChanged();
        }
    }

    private async Task LoadCachedAdvice()
    {
        try
        {
            // Retrieve the cached advice from localStorage
            var cachedAdvice = await JSRuntime.InvokeAsync<string>("localStorage.getItem", $"dailyAdvice:{CultureService.GetCurrentCulture()}");
            if (!string.IsNullOrEmpty(cachedAdvice))
            {
                dailyAdvice = cachedAdvice;
                shareText = $"{Loc["Advice_ShareText"]}\n{Util.StripHtmlTags(dailyAdvice)}";
                _loadingAdvice = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load cached advice: {ex.Message}");
        }
        StateHasChanged();
    }

    private async Task LoadDailyAdvice()
    {
        if (SignalRClient is null) return;

        try
        {
            // Interactive clients always use the SignalR data plane.
            // REST is only used during SSR prerendering (see OnInitializedAsync).
            CompanioNation.Shared.Settings settings = await SignalRClient.GetSettingsAsync();

            dailyAdvice = string.IsNullOrWhiteSpace(settings?.DailyAdvice)
                ? Loc["Advice_NoAdvice"]
                : settings.DailyAdvice;
            shareText = $"{Loc["Advice_ShareText"]}\n{Util.StripHtmlTags(dailyAdvice)}";
            _loadingAdvice = false;
        }
        catch (Exception ex)
        {
            dailyAdvice = Loc["Advice_NoAdvice"];
            _loadingAdvice = false;
            SignalRClient?.LogError(ex);
        }
        StateHasChanged();
    }

}
