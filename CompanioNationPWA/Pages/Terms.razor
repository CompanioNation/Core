@inject ICompanioNationSignalRClient? SignalRClient
@inject NavigationManager NavManager
@inject IStringLocalizer<Terms> Loc
@using CompanioNation.Shared

<div class="terms-overlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;">
    <div class="terms-card" style="background:#fff;border-radius:12px;max-width:600px;width:90%;max-height:85vh;display:flex;flex-direction:column;padding:24px;box-sizing:border-box;">
        <h2 style="text-align:center;margin-top:0;">@Loc["Terms_Title"]</h2>
        <div style="overflow-y:auto;flex:1;padding-right:8px;font-size:0.92em;line-height:1.6;">
            <p><strong>@Loc["Terms_LastUpdated"]</strong> July 2025</p>

            <p>@Loc["Terms_Intro"]</p>

            <h3>@Loc["Terms_AgeHeading"]</h3>
            <p>@Loc["Terms_AgeBody"]</p>

            <h3>@Loc["Terms_CommunityHeading"]</h3>
            <p>@Loc["Terms_CommunityIntro"]</p>
            <ul>
                <li>@Loc["Terms_Community1"]</li>
                <li>@Loc["Terms_Community2"]</li>
                <li>@Loc["Terms_Community3"]</li>
                <li>@Loc["Terms_Community4"]</li>
                <li>@Loc["Terms_Community5"]</li>
                <li>@Loc["Terms_Community6"]</li>
            </ul>

            <h3>@Loc["Terms_AccountabilityHeading"]</h3>
            <p>@Loc["Terms_AccountabilityBody"]</p>

            <h3>@Loc["Terms_ContentHeading"]</h3>
            <p>@Loc["Terms_ContentBody"]</p>

            <h3>@Loc["Terms_ModerationHeading"]</h3>
            <p>@Loc["Terms_ModerationBody"]</p>

            <h3>@Loc["Terms_PrivacyHeading"]</h3>
            <p>@Loc["Terms_PrivacyBody"]</p>

            <h3>@Loc["Terms_ChangesHeading"]</h3>
            <p>@Loc["Terms_ChangesBody"]</p>
        </div>

        <div style="margin-top:16px;text-align:center;">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div style="color:#d32f2f;margin-bottom:8px;font-size:0.9em;">@_errorMessage</div>
            }
            <button type="button" class="blueButton" @onclick="AcceptTerms" disabled="@_accepting" style="min-width:200px;">
                @(_accepting ? Loc["Terms_Processing"] : Loc["Terms_Agree"])
            </button>
        </div>
    </div>
</div>

@code {
        public const int CURRENT_TERMS_VERSION = 1;

    [Parameter] public EventCallback OnTermsAccepted { get; set; }

    private bool _accepting = false;
    private string _errorMessage = "";

    private async Task AcceptTerms()
    {
        _accepting = true;
        _errorMessage = "";
        StateHasChanged();

        try
        {
            var result = await SignalRClient.AcceptTermsAsync(CURRENT_TERMS_VERSION);
            if (result.IsSuccess)
            {
                if (SignalRClient.CurrentUser != null)
                    SignalRClient.CurrentUser.AcceptedTermsVersion = CURRENT_TERMS_VERSION;

                await OnTermsAccepted.InvokeAsync();
            }
            else
            {
                _errorMessage = result.Message ?? Loc["Terms_Failed"];
            }
        }
        catch (Exception ex)
        {
            _errorMessage = Loc["Terms_Error"];
            SignalRClient?.LogError(ex, "AcceptTerms");
        }

        _accepting = false;
        StateHasChanged();
    }
}
