@page "/EnterBasicInfo"
@inject IJSRuntime JSRuntime
@inject ICompanioNationSignalRClient? SignalRClient
@inject NavigationManager NavManager
@inject IStringLocalizer<EnterBasicInfo> Loc
@using CompanioNationPWA.CitySelect
@using System.ComponentModel.DataAnnotations

<div class="complete-profile">

    <div class="form-header">
        <h3>@Loc["EnterBasicInfo_Title"]</h3>
        <button @onclick="HandleLogout" class="btn btn-danger">@Loc["EnterBasicInfo_Logout"]</button>
    </div>

    @if (_editContext == null)
    {
        <p>@Loc["EnterBasicInfo_Loading"]</p>
    }
    else
    {
        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="name">@Loc["EnterBasicInfo_NameLabel"] <span class="text-danger">*</span></label>
                <InputText id="name" @bind-Value="_userDetails.Name" class="form-control" />
                <ValidationMessage For="@(() => _userDetails.Name)" />
            </div>

            <div class="form-group">
                <label for="description">@Loc["EnterBasicInfo_DescriptionLabel"] <span class="text-danger">*</span></label>
                <InputTextArea id="description" @bind-Value="_userDetails.Description" class="form-control" />
                <ValidationMessage For="@(() => _userDetails.Description)" />
            </div>

            <div class="form-group">
                <label for="gender">@Loc["EnterBasicInfo_GenderLabel"] <span class="text-danger">*</span></label>
                <InputSelect id="gender" @bind-Value="_userDetails.Gender" class="form-control">
                    <option value="0" disabled selected hidden class="text-muted">@Loc["EnterBasicInfo_SelectGender"]</option>
                    <option value="2">@Loc["EnterBasicInfo_GenderMale"]</option>
                    <option value="4">@Loc["EnterBasicInfo_GenderFemale"]</option>
                    <option value="8">@Loc["EnterBasicInfo_GenderOther"]</option>
                    <option value="16">@Loc["EnterBasicInfo_GenderTransMale"]</option>
                    <option value="32">@Loc["EnterBasicInfo_GenderTransFemale"]</option>
                </InputSelect>
                <ValidationMessage For="@(() => _userDetails.Gender)" />
            </div>

            <div class="form-group">
                <label for="dateOfBirth">@Loc["EnterBasicInfo_DateOfBirthLabel"] <span class="text-danger">*</span></label>
                <InputDate id="dateOfBirth" @bind-Value="_userDetails.DateOfBirth" class="form-control" />
                <ValidationMessage For="@(() => _userDetails.DateOfBirth)" />
            </div>

            <div class="form-group">
                <label for="city">@Loc["EnterBasicInfo_CityLabel"] <span class="text-danger">*</span></label>
                <CitySelect OnCitySelected="HandleCitySelected" />
                <ValidationMessage For="@(() => _userDetails.Geonameid)" />
            </div>

            <div class="form-group">
                <label for="searchable">@Loc["EnterBasicInfo_SearchableLabel"]</label>
                <label class="switch">
                    <input type="checkbox" @bind="_userDetails.Searchable">
                    <span class="slider round"></span>
                </label>
            </div>

            <div class="form-group">
                @if (_userDetails.Thumbnail != Guid.Empty)
                {
                    <label for="profilePicture">@Loc["EnterBasicInfo_ProfilePicture"]</label>
                    <img src="@Util.GetPhotoUrl(_userDetails.Thumbnail)" alt="@Loc["EnterBasicInfo_ProfilePictureAlt"]" class="img-thumbnail" />
                    <label for="profilePicture">@Loc["EnterBasicInfo_UploadDifferent"]</label>
                }
                else
                {
                    <label for="profilePicture">@Loc["EnterBasicInfo_UploadProfile"] <span class="text-danger">*</span></label>
                }
                <InputFile id="profilePicture" OnChange="HandleProfilePictureUpload" class="form-control" disabled="@_isUploading" />
                <ValidationMessage For="@(() => _userDetails.Thumbnail)" />

                @if (_isUploading)
                {
                    <div class="alert alert-info" role="status">
                        @Loc["EnterBasicInfo_Uploading"]
                    </div>
                }
            </div>

            <ActionButton OnClick="HandleFormSubmit" Color="#4CAF50">
                @Loc["EnterBasicInfo_SaveProfile"]
            </ActionButton>
            <br />
        </EditForm>
    }

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }

    @if (_isSuccess)
    {
        <div class="alert alert-success">@Loc["EnterBasicInfo_Success"]</div>
    }

</div>

@code {
        [CascadingParameter] protected MainLayout MainLayoutInstance { get; set; }

    private UserDetails _userDetails = new UserDetails();
    private EditContext? _editContext;
    private bool _isSuccess = false;
    private string _errorMessage = string.Empty;
    private bool _isUploading;

    protected override async Task OnInitializedAsync()
    {
    }
    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (SignalRClient is null)
            {
                NavManager.NavigateTo("/");
                return;
            }

            await SignalRClient.Initialize();
            if (SignalRClient.CurrentUser == null)
            {
                NavManager.NavigateTo("/");
                return;
            }

            _userDetails = SignalRClient.CurrentUser;
            _editContext = new EditContext(_userDetails); // Initialize EditContext after data is loaded
            StateHasChanged();
        }
    }

    private async Task HandleLogout()
    {
        if (MainLayoutInstance != null)
        {
            MainLayoutInstance.Logout();
        }
        else
        {
            // Handle the case where MainLayoutInstance is null
            _errorMessage = Loc["EnterBasicInfo_LogoutError"];
        }
    }

    private async Task HandleCitySelected(City city)
    {
        _userDetails.Geonameid = city.Geonameid;
        _editContext?.NotifyFieldChanged(FieldIdentifier.Create(() => _userDetails.Geonameid));
    }

    private async Task HandleProfilePictureUpload(InputFileChangeEventArgs e)
    {
        if (_isUploading)
        {
            return;
        }

        if (SignalRClient is null)
        {
            _errorMessage = Loc["EnterBasicInfo_FileUnexpected"];
            return;
        }

        _isUploading = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var file = e.File;

            int result;
            Guid imageGuid;
            (result, imageGuid) = await SignalRClient.UploadPhotoAsync(file);

            if (result == 0) _userDetails.Thumbnail = imageGuid;
            else if (result == -1) _errorMessage = Loc["EnterBasicInfo_FileTooLarge"];
            else if (result == -2) _errorMessage = Loc["EnterBasicInfo_FileInvalid"];
            else if (result == -3) _errorMessage = Loc["EnterBasicInfo_FileFace"];
            else _errorMessage = Loc["EnterBasicInfo_FileError"];
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "EnterBasicInfo.UploadPhoto");
            _errorMessage = Loc["EnterBasicInfo_FileUnexpected"];
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private async Task HandleFormSubmit(MouseEventArgs e)
    {
        _errorMessage = string.Empty;
        _isSuccess = false;

        if (SignalRClient is null || _editContext is null)
        {
            _errorMessage = Loc["EnterBasicInfo_UpdateError"];
            return;
        }

        if (_userDetails.Thumbnail == Guid.Empty)
        {
            _errorMessage = Loc["EnterBasicInfo_ProfilePictureRequired"];
            return;
        }

        // Perform form validation manually
        if (_editContext.Validate())
        {
            try
            {
                var result = await SignalRClient.UpdateUserDetailsAsync(_userDetails);

                if (result)
                {
                    _isSuccess = true;
                    MainLayoutInstance?.HandleBasicInfoCompleted();
                    try
                    {
                        await JSRuntime.InvokeVoidAsync("gaEvent", "profile_created", null);
                    }
                    catch (Exception gaEx)
                    {
                        Console.WriteLine($"[Analytics] Failed to emit 'profile_created': {gaEx.Message}");
                    }
                    NavManager.NavigateTo("/");
                }
                else
                {
                    _errorMessage = Loc["EnterBasicInfo_UpdateError"];
                }
            }
            catch (Exception ex)
            {
                SignalRClient?.LogError(ex, "EnterBasicInfo.Submit");
                _errorMessage = $"{Loc["EnterBasicInfo_ErrorOccurred"]} {ex.Message}";
            }
        }
        else
        {
            _errorMessage = Loc["EnterBasicInfo_FormErrors"];
        }
    }
}
