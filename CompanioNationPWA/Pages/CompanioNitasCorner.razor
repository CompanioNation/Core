@page "/CompanioNitasCorner/{adviceId:int?}"
@inject CompanioNationSignalRClient? SignalRClient
@inject NavigationManager NavManager
@inject HttpClient Http
@inject IStringLocalizer<CompanioNitasCorner> Loc
@using CompanioNation.Shared
@using CompanioNationPWA.Services
@using System.Net.Http.Json


<h3><img src="/images/CompanioNita.png" class="companionita-icon" /> @Loc["CompanioNitasCorner_Title"]</h3>
<p>@Loc["CompanioNitasCorner_Subtitle"]</p>

<div>
    <h4>@Loc["CompanioNitasCorner_SelectDate"]</h4>
    @if (adviceList == null)
    {
        <p>@Loc["CompanioNitasCorner_Loading"]</p>
    }
    else if (adviceList.Count == 0)
    {
        <p>@Loc["CompanioNitasCorner_NoAdvice"]</p>
    }
    else
    {
        <ul>
            @foreach (var advice in adviceList)
            {
                var adviceToShow = advice;
                <li>
                    <a href="/CompanioNitasCorner/@adviceToShow.AdviceId" @onclick="() => ShowAdvice(adviceToShow)" @onclick:preventDefault>
                        @advice.DateCreated.ToString("MMMM dd, yyyy")
                    </a>
                </li>
            }
        </ul>

        <!-- Pagination controls -->
        <div class="pagination">
            @if (canGoBack)
            {
                <a href="/CompanioNitasCorner/?page=@(currentPage)" class="page-link" @onclick="PreviousPage" @onclick:preventDefault>@Loc["CompanioNitasCorner_Previous"]</a>
            }
            else
            {
                <span class="page-disabled">@Loc["CompanioNitasCorner_Previous"]</span>
            }
            @if (canGoForward)
            {
                <a href="/CompanioNitasCorner/?page=@(currentPage + 2)" class="page-link" @onclick="NextPage" @onclick:preventDefault>@Loc["CompanioNitasCorner_Next"]</a>
            }
            else
            {
                <span class="page-disabled">@Loc["CompanioNitasCorner_Next"]</span>
            }
        </div>
    }
</div>

<div>
    <h4>@string.Format(Loc["CompanioNitasCorner_AdviceFor"], selectedDateDisplay)</h4>
    <div class="advice-card">
        @if (selectedAdvice == null)
        {
            <p>@Loc["CompanioNitasCorner_SelectAdvice"]</p>
        }
        else
        {
            <strong>@selectedDateDisplay</strong>

            <br />

            <ShareButton ShareTitle="@Loc["CompanioNitasCorner_ShareTitle"]"
            ShareText="@shareText"
            ShareUrl="@shareUrl" />
            <ShadowDomElement Html="@selectedAdvice.Advice"></ShadowDomElement>
        }
    </div>
</div>

@code {
    [Parameter]
    public int? adviceId { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int? page { get; set; }

    private List<CompanioNitaAdvice> adviceList;
    private CompanioNitaAdvice selectedAdvice;
    private string selectedDateDisplay;
    private int currentPage = 0;
    private int pageSize = 5; // Number of advice entries per page
    private bool canGoBack = false;
    private bool canGoForward = true;
    private string shareText = "";
    private string shareUrl = "";

    protected override async Task OnInitializedAsync()
    {
        if (!SignalRClient.IsPrerendering) return;

        // Initialize currentPage from URL query parameter (for SSR pagination)
        currentPage = (page ?? 1) - 1; // URL is 1-based, internal is 0-based
        if (currentPage < 0) currentPage = 0;

        // SSR prerendering: fetch advice via REST API so bots/crawlers see full content
        try
        {
            if (adviceId.HasValue)
            {
                selectedAdvice = await Http.GetFromJsonAsync<CompanioNitaAdvice>(
                    $"{NavManager.BaseUri}api/companionita-advice/{adviceId.Value}?lang={CultureService.GetCurrentCulture()}");
                if (selectedAdvice != null)
                {
                    selectedDateDisplay = selectedAdvice.DateCreated.ToString("MMMM dd, yyyy");
                    shareText = $"{Loc["CompanioNitasCorner_ShareText"]}\n{Util.StripHtmlTags(selectedAdvice.Advice)}";
                    shareUrl = $"https://companionation.com/CompanioNitasCorner/{selectedAdvice.AdviceId}";
                }
            }
        }
        catch { /* silently fail — WASM boot will retry via SignalR */ }

        try
        {
            adviceList = await Http.GetFromJsonAsync<List<CompanioNitaAdvice>>(
                $"{NavManager.BaseUri}api/companionita-advice?start={currentPage * pageSize}&count={pageSize}&lang={CultureService.GetCurrentCulture()}");
            if (adviceList != null)
            {
                canGoBack = currentPage > 0;
                canGoForward = adviceList.Count >= pageSize;
            }
        }
        catch { adviceList = null; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SignalRClient.IsPrerendering) return;

        try
        {
            if (firstRender)
            {
                // Initialize currentPage from URL query parameter (for WASM client-side)
                currentPage = (page ?? 1) - 1; // URL is 1-based, internal is 0-based
                if (currentPage < 0) currentPage = 0;

                if (adviceId.HasValue)
                {
                    CompanioNitaAdvice advice = await SignalRClient.GetCompanionitaAdviceById(adviceId.Value);
                    if (advice != null) ShowAdvice(advice);
                }

                await LoadAdvice();
            }
        }
        catch (Exception ex)
        {
            SignalRClient.LogError(ex);
        }
    }

    // Load paginated advice entries
    private async Task LoadAdvice()
    {
        try
        {
            List<CompanioNitaAdvice> newAdvice = await SignalRClient.GetCompanionitaAdvice(currentPage * pageSize, pageSize);
            if (newAdvice == null) {
                adviceList = new List<CompanioNitaAdvice>(); // Show empty list on error
                canGoBack = false;
                canGoForward = false;
                SignalRClient.LogError("Error retrieving advice");
                return;
            }

            if (newAdvice.Count == 0)
            {
                // Go back to the page which had advice, and disable the Next button
                currentPage--;
                canGoForward = false;
            }
            else if (newAdvice.Count < pageSize)
            {
                // Disable forward navigation if fewer items than requested were returned
                canGoForward = false;
                adviceList = newAdvice;
            }
            else
            {
                // Adjust pagination controls
                canGoBack = currentPage > 0;
                canGoForward = true;
                adviceList = newAdvice;
            }
        }
        catch (Exception ex)
        {
            // Handle any errors
            adviceList = new List<CompanioNitaAdvice>(); // Show empty list on error
            canGoBack = false;
            canGoForward = false;
            SignalRClient.LogError(ex);
        }
        StateHasChanged();
    }

    // Display advice for the selected date
    private void ShowAdvice(CompanioNitaAdvice advice)
    {
        shareText = $"Check out this advice from CompanioNita!\n{Util.StripHtmlTags(advice.Advice)}";
        shareUrl = "https://companionation.com/CompanioNitasCorner/" + advice.AdviceId;
        selectedAdvice = advice;
        selectedDateDisplay = advice.DateCreated.ToString("MMMM dd, yyyy");
        NavManager.NavigateTo("/CompanioNitasCorner/" + advice.AdviceId, false);
        StateHasChanged();
    }

    // Go to the next page of advice entries
    private async Task NextPage()
    {
        currentPage++;
        NavManager.NavigateTo($"/CompanioNitasCorner/?page={currentPage + 1}", false);
        await LoadAdvice();
    }

    // Go to the previous page of advice entries
    private async Task PreviousPage()
    {
        currentPage--;
        NavManager.NavigateTo($"/CompanioNitasCorner/?page={currentPage + 1}", false);
        await LoadAdvice();
    }
}
