@page "/Settings"
@inject IJSRuntime JSRuntime
@inject CompanioNationSignalRClient? SignalRClient
@inject NavigationManager NavManager
@inject HttpClient Http
@inject IStringLocalizer<Settings> Loc
@using CompanioNation.Shared
@using CompanioNationPWA.CitySelect

<Information Content="@(new MarkupString(Loc["Settings_Information"].Value))" />

<h3>@Loc["Settings_Title"]</h3>

<div class="settings-container">
    @if (SignalRClient.CurrentUser == null)
    {
        <p>@Loc["Settings_Loading"]</p>
    }
    else
    {
        <div class="header">
            <h4>@SignalRClient.CurrentUser.Name</h4>
            <button class="btn btn-danger shadow-lg rounded-pill" @onclick="HandleLogout">@Loc["Settings_LogOut"]</button>
        </div>

        @if (SignalRClient.CurrentUser.IsAdministrator)
        {
            <div class="admin-section">
                <a href="/Admin" class="admin-panel-link">
                    <span class="admin-panel-link-badge">ADMIN</span>
                    <span class="admin-panel-link-text">
                        <strong>@Loc["Settings_ControlPanel"]</strong>
                        <span>@Loc["Settings_ControlPanelSubtitle"]</span>
                    </span>
                    <span class="admin-panel-link-arrow">&rsaquo;</span>
                </a>
            </div>
        }

        <div class="compact-info">
            <div class="info-item">
                <b>@Loc["Settings_LinkScore"]</b> @SignalRClient.CurrentUser.Ranking
            </div>

            <div class="info-item">
                <b>@Loc["Settings_LastLogin"]</b> @SignalRClient.CurrentUser.LastLogin?.ToLocalTime().ToString("g")
            </div>

            <div class="info-item">
                <b>@Loc["Settings_Email"]</b> @SignalRClient.CurrentUser.Email
            </div>

            <div class="info-item">
                <b>@Loc["Settings_MemberSince"]</b> @ConvertToLocalTime(SignalRClient.CurrentUser.DateCreated).ToShortDateString()
            </div>
        </div>

        <div class="email-change-section">
            <h4>@Loc["Settings_ChangeEmail"]</h4>

            @if (SignalRClient.CurrentUser.OAuthLogin)
            {
                <p class="email-change-note">@Loc["Settings_EmailManagedByProvider"]</p>
            }
            else if (!_emailChangePending)
            {
                <div class="email-change-form">
                    <label>@Loc["Settings_NewEmail"]</label>
                    <input type="email" @bind="_newEmail" class="form-control" />
                    <ActionButton OnClick="RequestEmailChange">@Loc["Settings_RequestEmailChange"]</ActionButton>
                </div>
            }
            else
            {
                <div class="email-change-form">
                    <p>@Loc["Settings_EmailChangeCodeSent"]</p>
                    <label>@Loc["Settings_EmailChangeCode"]</label>
                    <input @bind="_emailChangeCode" class="form-control" />
                    <div style="display:flex; gap:8px; margin-top:8px;">
                        <ActionButton OnClick="ConfirmEmailChange">@Loc["Settings_ConfirmEmailChange"]</ActionButton>
                        <button class="grayButton" @onclick="StartNewEmailChange">@Loc["Settings_UseDifferentEmail"]</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_emailChangeError))
            {
                <div class="alert alert-danger">@_emailChangeError</div>
            }
            @if (!string.IsNullOrEmpty(_emailChangeSuccess))
            {
                <div class="alert alert-success">@_emailChangeSuccess</div>
            }
        </div>

        @if (!_subscriptionMessageDismissed && !string.IsNullOrEmpty(SubscriptionStatus))
        {
            <div class="alert @(SubscriptionStatus == "success" ? "alert-success" : "alert-warning") alert-dismissible" role="alert">
                @if (SubscriptionStatus == "success")
                {
                    // Here we don't need to re-load the user data to get the updated subscription expiry because that will have happened by virtue of the fact that we came from an external link
                    <span><strong>@Loc["Settings_SubscriptionUpdated"]</strong> @Loc["Settings_SubscriptionUpdatedBody"]</span>
                }
                else if (SubscriptionStatus == "cancelled")
                {
                    <span><strong>@Loc["Settings_CheckoutCancelled"]</strong> @Loc["Settings_CheckoutCancelledBody"]</span>
                }
                <button type="button" class="btn-close" @onclick="DismissSubscriptionMessage"></button>
            </div>
        }

        @if (SignalRClient.CurrentUser.SubscriptionExpiry.HasValue && SignalRClient.CurrentUser.SubscriptionExpiry.Value > DateTime.UtcNow)
        {
            <div class="subscription-section">
                <h4>@Loc["Settings_Subscription"]</h4>
                <p><b>@Loc["Settings_Status"]</b> @Loc["Settings_Active"]</p>
                <p><b>@Loc["Settings_Expires"]</b> @SignalRClient.CurrentUser.SubscriptionExpiry.Value.ToString("MMMM dd, yyyy")</p>

                @if (!string.IsNullOrEmpty(_subscriptionErrorMessage))
                {
                    <div class="alert alert-danger">@_subscriptionErrorMessage</div>
                }

                @if (!string.IsNullOrEmpty(_subscriptionSuccessMessage))
                {
                    <div class="alert alert-success">@_subscriptionSuccessMessage</div>
                }

                @if (_canCancelInline)
                {
                    @if (_showCancelConfirmation)
                    {
                        <div class="alert alert-warning">
                            <p><strong>@Loc["Settings_CancelConfirmHeading"]</strong></p>
                            <p>@Loc["Settings_CancelConfirmBody"]</p>
                            <div style="display:flex; gap:8px; margin-top:8px;">
                                <ActionButton OnClick="ConfirmCancelSubscription">
                                    @Loc["Settings_YesCancel"]
                                </ActionButton>
                                <button class="grayButton" @onclick="DismissCancelConfirmation">@Loc["Settings_NoKeep"]</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <ActionButton OnClick="CancelSubscription">
                            @Loc["Settings_CancelSubscription"]
                        </ActionButton>
                    }
                }
                else if (!string.IsNullOrEmpty(_manageSubscriptionUrl))
                {
                    <ActionButton OnClick="ManageSubscriptionExternal">
                        @Loc["Settings_ManageSubscription"]
                    </ActionButton>
                }
            </div>
        }


        <EditForm EditContext="_editContext">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="editable-fields">
                <label>@Loc["Settings_Name"]</label>
                <InputText @bind-Value="SignalRClient.CurrentUser.Name" class="form-control" />

                <label>@Loc["Settings_Description"]</label>
                <InputTextArea @bind-Value="SignalRClient.CurrentUser.Description" class="form-control" />

                <label>@Loc["Settings_Gender"]</label>
                <InputSelect @bind-Value="SignalRClient.CurrentUser.Gender" class="form-control">
                    <option value="2">@Loc["Settings_GenderMale"]</option>
                    <option value="4">@Loc["Settings_GenderFemale"]</option>
                    <option value="8">@Loc["Settings_GenderOther"]</option>
                    <option value="16">@Loc["Settings_GenderTransMale"]</option>
                    <option value="32">@Loc["Settings_GenderTransFemale"]</option>
                </InputSelect>

                <label>@Loc["Settings_DateOfBirth"]</label>
                <InputDate @bind-Value="SignalRClient.CurrentUser.DateOfBirth" class="form-control" />
                <ValidationMessage For="@(() => SignalRClient.CurrentUser.DateOfBirth)" />

                <label>@Loc["Settings_City"]</label>
                <div class="city-select-container">
                    <CitySelect OnCitySelected="HandleCitySelected"></CitySelect>
                </div>
                <ValidationMessage For="@(() => SignalRClient.CurrentUser.Geonameid)" />
            </div>

            <div class="button-container">
                <ActionButton OnClick="UpdateUserInfo">
                    @Loc["Settings_SaveChanges"]
                </ActionButton>
            </div>
        </EditForm>

        <div class="profile-visibility-section">
            <h4>@Loc["Settings_ProfileVisibility"]</h4>
            <p class="visibility-description">@Loc["Settings_VisibilityDescription"]</p>

            <div class="visibility-toggle-row">
                <span class="visibility-label">@(_profileVisible ? Loc["Settings_VisibleToOthers"] : Loc["Settings_HiddenFromOthers"])</span>
                <label class="toggle-switch">
                    <input type="checkbox" checked="@_profileVisible" @onchange="HandleVisibilityToggle" />
                    <span class="toggle-slider"></span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(_visibilityMessage))
            {
                <div class="alert alert-info visibility-feedback">@_visibilityMessage</div>
            }

            <div class="delete-account-row">
                <span class="delete-account-label">@Loc["Settings_DeleteAccount"]</span>
                <button class="btn-delete-account" @onclick="StartDeleteFlow">@Loc["Settings_DeleteAccount"]</button>
            </div>

            @if (!string.IsNullOrEmpty(_deleteErrorMessage))
            {
                <div class="alert alert-danger" style="margin-top:12px;">@_deleteErrorMessage</div>
            }
        </div>

        <div class="user-images">
            <h4>@Loc["Settings_YourImages"]</h4>
            <label for="photoUpload">@Loc["Settings_UploadNewPicture"]</label>
            <InputFile id="photoUpload" OnChange="HandleProfilePictureUpload" disabled="@_isUploading" />

            @if (_isUploading)
            {
                <div class="alert alert-info" role="status">
                    @Loc["Settings_UploadingPhoto"]
                </div>
            }

            @if (!string.IsNullOrEmpty(_fileErrorMessage))
            {
                <div class="alert alert-danger">
                    @_fileErrorMessage
                </div>
            }
            @if (_userImages != null && _userImages.Any())
            {
                <div class="image-gallery">
                    @foreach (var image in _userImages)
                    {
                        <div class="image-item">
                            <ThumbnailComponent ImageUrl="@Util.GetPhotoUrl(image.ImageGuid)" Alt="@Loc["Settings_UserImageAlt"]" ThumbnailSize="6em"></ThumbnailComponent>
                            <p>@Loc["Settings_Uploaded"] @image.DateCreated.ToShortDateString()</p>
                            <label>@Loc["Settings_Visible"]</label>
                            <input type="checkbox" checked="@image.ImageVisible" @onchange="(e) => ToggleImageVisibility(image, ((ChangeEventArgs)e).Value)" />
                            <button class="delete-photo-btn" @onclick="() => DeletePhoto(image)" title="@Loc["Settings_DeletePhotoTitle"]">🗑️</button>
                        </div>
                    }
                </div>

                <br />
                <h4>@Loc["Settings_YourReviews"]</h4>
                <div class="review-gallery">
                    @foreach (var image in _userImages)
                    {
                        @if (!string.IsNullOrWhiteSpace(image.Review))
                        {
                            <div class="review-item">
                                <p><strong>@Loc["Settings_Review"]</strong> @image.Review</p>
                                <label>@Loc["Settings_PubliclyVisible"]</label>
                                <input type="checkbox" checked="@image.ReviewVisible" @onchange="(e) => ToggleReviewVisibility(image, ((ChangeEventArgs)e).Value)" />
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <p>@Loc["Settings_NoImages"]</p>
            }
        </div>

        <div class="actions">
            <NavLink href="/Contact" class="contact-link">@Loc["Settings_ContactUs"]</NavLink>
            <p class="policy-text">@Loc["Settings_PrivacyPolicyPrefix"]<a href="/PrivacyPolicy">@Loc["Settings_PrivacyPolicy"]</a></p>
        </div>
    }

</div>

@if (_showDeleteModal)
{
    <div class="delete-modal-overlay" @onclick="CancelDelete">
        <div class="delete-modal" @onclick:stopPropagation="true">
            @if (_deleteStep == DeleteStep.Warning)
            {
                <h4 class="delete-modal-title">@Loc["Settings_DeleteAccountTitle"]</h4>
                <p class="delete-modal-warning-heading">@Loc["Settings_DeleteWarning"]</p>
                <ul class="delete-modal-loss-list">
                    <li>@Loc["Settings_DeleteLossMessages"]</li>
                    <li>@Loc["Settings_DeleteLossCompanioNita"]</li>
                    <li>@Loc["Settings_DeleteLossSubscription"]</li>
                    <li>@Loc["Settings_DeleteLossImages"]</li>
                </ul>
                <p class="delete-modal-warning-subtext">@Loc["Settings_DeleteUndo"]</p>

                <div class="delete-modal-actions">
                    <button class="btn-hide-instead" @onclick="HideInstead">@Loc["Settings_HideInstead"]</button>
                    <button class="btn-delete-continue" @onclick="ProceedToConfirmDelete">@Loc["Settings_ContinueDelete"]</button>
                    <button class="grayButton" @onclick="CancelDelete">@Loc["Settings_Cancel"]</button>
                </div>
            }
            else if (_deleteStep == DeleteStep.Confirm)
            {
                <h4 class="delete-modal-title">@Loc["Settings_ConfirmDeleteTitle"]</h4>
                <p>@Loc["Settings_ConfirmDeletePrompt"]</p>
                <p class="delete-modal-email-hint">@SignalRClient.CurrentUser?.Email</p>
                <input type="text"
                       class="form-control delete-confirm-input"
                       placeholder="@Loc["Settings_ConfirmEmailPlaceholder"]"
                       @bind="_deleteConfirmEmail"
                       @bind:event="oninput" />

                @if (!string.IsNullOrEmpty(_deleteErrorMessage))
                {
                    <div class="alert alert-danger" style="margin-top:12px;">@_deleteErrorMessage</div>
                }

                <div class="delete-modal-actions">
                    <ActionButton Color="#dc3545"
                                  OnClick="ConfirmDeleteProfile"
                                  disabled="@(!DeleteConfirmEmailMatches)">
                        @Loc["Settings_PermanentlyDelete"]
                    </ActionButton>
                    <button class="grayButton" @onclick="CancelDelete">@Loc["Settings_Cancel"]</button>
                </div>
            }
        </div>
    </div>
}

@code {
[CascadingParameter] public MainLayout MainLayoutInstance { get; set; }

[SupplyParameterFromQuery(Name = "subscription")]
public string? SubscriptionStatus { get; set; }

private List<UserImage> _userImages = new List<UserImage>();
private EditContext? _editContext;
private string _fileErrorMessage = string.Empty;
private bool _isUploading;
private string _subscriptionErrorMessage = string.Empty;
private string _subscriptionSuccessMessage = string.Empty;
private bool _subscriptionMessageDismissed;
private bool _showCancelConfirmation;
private bool _canCancelInline = true;
private string? _manageSubscriptionUrl;

// Profile Visibility & Delete
private bool _profileVisible;
private string _visibilityMessage = string.Empty;
private bool _showDeleteModal;
private DeleteStep _deleteStep = DeleteStep.Warning;
private string _deleteConfirmEmail = string.Empty;
private string _deleteErrorMessage = string.Empty;

// Email change
private string _newEmail = string.Empty;
private string _emailChangeCode = string.Empty;
private bool _emailChangePending;
private string _emailChangeError = string.Empty;
private string _emailChangeSuccess = string.Empty;

private bool DeleteConfirmEmailMatches =>
    !string.IsNullOrEmpty(_deleteConfirmEmail)
    && string.Equals(_deleteConfirmEmail.Trim(), SignalRClient.CurrentUser?.Email, StringComparison.OrdinalIgnoreCase);

private enum DeleteStep { Warning, Confirm }


    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(new UserDetails());
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await SignalRClient.Initialize();
                if (SignalRClient.CurrentUser == null)
                {
                    NavManager.NavigateTo("/", replace: true);
                    return;
                }

                _editContext = new EditContext(SignalRClient.CurrentUser);
                _profileVisible = SignalRClient.CurrentUser.Searchable;
                _emailChangePending = !string.IsNullOrWhiteSpace(SignalRClient.CurrentUser.NewEmail);
                if (_emailChangePending)
                {
                    _newEmail = SignalRClient.CurrentUser.NewEmail ?? string.Empty;
                }
                _userImages = await SignalRClient.GetUserImagesAsync() ?? [];
                _userImages = _userImages
                    .OrderByDescending(i => i.DateCreated)
                    .ToList();

                if (SignalRClient.CurrentUser.SubscriptionExpiry.HasValue
                    && SignalRClient.CurrentUser.SubscriptionExpiry.Value > DateTime.UtcNow)
                    await FetchCancelInfoAsync();

                StateHasChanged();
            }
            catch (Exception ex)
            {
                SignalRClient?.LogError(ex, "Settings.OnAfterRenderAsync");
                NavManager.NavigateTo("/", replace: true);
            }
        }
    }

    private async Task HandleLogout()
    {
        if (MainLayoutInstance != null)
        {
            MainLayoutInstance.Logout();
        }
        else
        {
            // Handle the case where MainLayoutInstance is null
            //_errorMessage = "Unable to logout. Please try again later.";
        }
    }

    private async Task HandleCitySelected(City city)
    {
        SignalRClient.CurrentUser.Geonameid = city.Geonameid;
        await UpdateUserInfo();
    }

    private DateTime ConvertToLocalTime(DateTime dateTime)
    {
        return dateTime.ToLocalTime();
    }

    private async Task UpdateUserInfo()
    {
        bool result = await SignalRClient.UpdateUserDetailsAsync(SignalRClient.CurrentUser);
        if (result == false) throw new Exception();
    }

    private async Task RequestEmailChange()
    {
        _emailChangeError = string.Empty;
        _emailChangeSuccess = string.Empty;
        StateHasChanged();

        var result = await SignalRClient.RequestEmailChangeAsync(_newEmail);
        if (result.IsSuccess)
        {
            _emailChangePending = true;
            _emailChangeCode = string.Empty;
            if (SignalRClient.CurrentUser != null)
            {
                SignalRClient.CurrentUser.NewEmail = _newEmail.Trim();
            }
            _emailChangeSuccess = Loc["Settings_EmailChangeCodeSent"];
        }
        else
        {
            _emailChangeError = string.IsNullOrWhiteSpace(result.Message)
                ? Loc["Settings_EmailChangeError"]
                : result.Message;
        }
    }

    private async Task ConfirmEmailChange()
    {
        _emailChangeError = string.Empty;
        _emailChangeSuccess = string.Empty;
        StateHasChanged();

        var result = await SignalRClient.ConfirmEmailChangeAsync(_emailChangeCode);
        if (result.IsSuccess && SignalRClient.CurrentUser != null)
        {
            var confirmedEmail = (SignalRClient.CurrentUser.NewEmail ?? _newEmail).Trim();
            SignalRClient.CurrentUser.OldEmail = SignalRClient.CurrentUser.Email;
            SignalRClient.CurrentUser.Email = confirmedEmail;
            SignalRClient.CurrentUser.NewEmail = null;
            _emailChangePending = false;
            _emailChangeCode = string.Empty;
            _newEmail = string.Empty;
            _emailChangeSuccess = Loc["Settings_EmailChangeSuccess"];
        }
        else
        {
            _emailChangeError = string.IsNullOrWhiteSpace(result.Message)
                ? Loc["Settings_EmailChangeError"]
                : result.Message;
        }
    }

    private void StartNewEmailChange()
    {
        _emailChangePending = false;
        _emailChangeCode = string.Empty;
        _emailChangeError = string.Empty;
        _emailChangeSuccess = string.Empty;
    }

    private void DismissSubscriptionMessage()
    {
        _subscriptionMessageDismissed = true;
    }

    private Task CancelSubscription()
    {
        _subscriptionErrorMessage = string.Empty;
        _subscriptionSuccessMessage = string.Empty;
        _showCancelConfirmation = true;
        return Task.CompletedTask;
    }

    private void DismissCancelConfirmation()
    {
        _showCancelConfirmation = false;
    }

    private async Task ConfirmCancelSubscription()
    {
        _showCancelConfirmation = false;
        _subscriptionErrorMessage = string.Empty;
        _subscriptionSuccessMessage = string.Empty;

        string? loginToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "loginGuid");
        if (string.IsNullOrWhiteSpace(loginToken))
        {
            _subscriptionErrorMessage = Loc["Settings_LoginRequired"];
            return;
        }

        try
        {
            var response = await Http.PostAsync(
                $"api/billing/cancel-subscription?loginToken={Uri.EscapeDataString(loginToken)}", null);

            var message = await response.Content.ReadAsStringAsync();

            if (response.IsSuccessStatusCode)
            {
                _subscriptionSuccessMessage = message;
            }
            else
            {
                _subscriptionErrorMessage = string.IsNullOrWhiteSpace(message)
                    ? Loc["Settings_CancelUnavailable"]
                    : message;
            }
        }
        catch
        {
            _subscriptionErrorMessage = Loc["Settings_CancelUnavailable"];
        }
    }

    private async Task FetchCancelInfoAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/billing/cancel-info");
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadFromJsonAsync<CancelInfoResponse>();
                if (json != null)
                {
                    _canCancelInline = json.CanCancelInline;
                    _manageSubscriptionUrl = json.ManageUrl;
                }
            }
        }
        catch
        {
            // Default to inline cancel if we cannot reach the endpoint
            _canCancelInline = true;
        }
    }

    private async Task ManageSubscriptionExternal()
    {
        if (!string.IsNullOrEmpty(_manageSubscriptionUrl))
            await JSRuntime.InvokeVoidAsync("open", _manageSubscriptionUrl, "_blank");
    }

    private record CancelInfoResponse(bool CanCancelInline, string? ManageUrl);

    private async Task ToggleImageVisibility(UserImage image, object isChecked)
    {
        if (bool.TryParse(isChecked?.ToString(), out bool isVisible))
        {
            image.ImageVisible = isVisible;
            await SignalRClient.UpdateImageVisibility(image.ImageId, image.ImageVisible);
        }
    }

    private async Task DeletePhoto(UserImage image)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            Loc["Settings_DeletePhotoConfirm"]);
        if (!confirm) return;

        try
        {
            bool result = await SignalRClient.DeleteUserPhotoAsync(image.ImageId);
            if (result)
            {
                _userImages.Remove(image);
                // Reload from server to ensure karma/ranking updates are reflected
                await SignalRClient.Initialize();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Settings.DeletePhoto");
        }
    }

    private async Task ToggleReviewVisibility(UserImage image, object isChecked)
    {
        if (bool.TryParse(isChecked?.ToString(), out bool isPublic))
        {
            image.ReviewVisible = isPublic;
            await SignalRClient.UpdateReviewVisibility(image.ImageId, image.ReviewVisible);
        }
    }

    private async Task HandleProfilePictureUpload(InputFileChangeEventArgs e)
    {
        if (_isUploading)
        {
            return;
        }

        _isUploading = true;

        // Clear any previous error immediately when a new upload starts.
        _fileErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var file = e.File;

            int result;
            Guid imageGuid;
            (result, imageGuid) = await SignalRClient.UploadPhotoAsync(file);

            if (result == 0)
            {
                var newImage = new UserImage
                    {
                        ImageGuid = imageGuid,
                        DateCreated = DateTime.UtcNow,
                        ImageVisible = true
                    };

                // Ensure the newest image is shown first.
                _userImages.Insert(0, newImage);
                _userImages = _userImages
                    .OrderByDescending(i => i.DateCreated)
                    .ToList();

                _fileErrorMessage = "";
            }
            else if (result == -1) _fileErrorMessage = Loc["Settings_FileTooLarge"];
            else if (result == -2) _fileErrorMessage = Loc["Settings_FileInvalid"];
            else if (result == -3) _fileErrorMessage = Loc["Settings_FileFace"];
            else _fileErrorMessage = Loc["Settings_FileError"];
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Settings.UploadPhoto");
            _fileErrorMessage = Loc["Settings_FileUnexpected"];
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    private async Task HandleVisibilityToggle(ChangeEventArgs e)
    {
        if (bool.TryParse(e.Value?.ToString(), out bool isVisible))
        {
            _profileVisible = isVisible;
            SignalRClient.CurrentUser.Searchable = isVisible;
            await UpdateUserInfo();
            _visibilityMessage = isVisible
                ? Loc["Settings_VisibilityVisible"]
                : Loc["Settings_VisibilityHidden"];
        }
    }

    private void StartDeleteFlow()
    {
        _deleteErrorMessage = string.Empty;
        _deleteConfirmEmail = string.Empty;
        _deleteStep = _profileVisible ? DeleteStep.Warning : DeleteStep.Confirm;
        _showDeleteModal = true;
    }

    private async Task HideInstead()
    {
        _profileVisible = false;
        SignalRClient.CurrentUser.Searchable = false;
        await UpdateUserInfo();
        _visibilityMessage = Loc["Settings_VisibilityHidden"];
        _showDeleteModal = false;
        _deleteStep = DeleteStep.Warning;
        _deleteConfirmEmail = string.Empty;
    }

    private void ProceedToConfirmDelete()
    {
        _deleteConfirmEmail = string.Empty;
        _deleteStep = DeleteStep.Confirm;
    }

    private void CancelDelete()
    {
        _showDeleteModal = false;
        _deleteStep = DeleteStep.Warning;
        _deleteConfirmEmail = string.Empty;
        _deleteErrorMessage = string.Empty;
    }

    private async Task ConfirmDeleteProfile()
    {
        if (!DeleteConfirmEmailMatches)
            return;

        _deleteErrorMessage = string.Empty;
        bool success = await SignalRClient.DeleteProfileAsync();
        if (success)
        {
            _showDeleteModal = false;
            if (MainLayoutInstance != null)
            {
                MainLayoutInstance.Logout();
            }
        }
        else
        {
            _deleteErrorMessage = Loc["Settings_DeleteError"];
        }
    }


}

