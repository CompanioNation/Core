@page "/Contact"
@inject NavigationManager NavManager
@inject IStringLocalizer<Contact> Loc

<div class="contact-layout">
    <div class="contact-card">
        <div class="companionita-header">
            <img src="/images/CompanioNita.png" class="companionita-icon" alt="CompanioNita" />
            <div class="companionita-speech">
                <p><strong>@Loc["Contact_IntroTitle"]</strong></p>
                <p>@Loc["Contact_IntroBody"]</p>
            </div>
        </div>

        <div class="contact-details">
            <div class="contact-item">
                <span class="contact-icon">&#9993;</span>
                <div>
                    <strong>@Loc["Contact_Email"]</strong>
                    <br />
                    <a href="mailto:info@companionation.com">info@companionation.com</a>
                </div>
            </div>

            <div class="contact-item">
                <span class="contact-icon">&#9742;</span>
                <div>
                    <strong>@Loc["Contact_Phone"]</strong>
                    <br />
                    <a href="tel:+16046572386">604-657-2386</a>
                </div>
            </div>

            <div class="contact-item">
                <span class="contact-icon">&#127968;</span>
                <div>
                    <strong>@Loc["Contact_MailingAddress"]</strong>
                    <br />
                    CompanioNation HQ
                    <br />
                    405-1188 Pendrell Street
                    <br />
                    Vancouver, BC V6E 4P8
                    <br />
                    @Loc["Contact_Canada"]
                </div>
            </div>
        </div>

        <div class="companionita-signoff">
            <p><em>— CompanioNita &#10084;</em></p>
        </div>
    </div>
</div>
