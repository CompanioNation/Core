    private async Task ToggleMute()
    {
        if (auditProfile == null) return;
        var targetUserId = auditProfile.UserId;
        var desiredMuted = !auditProfile.IsMuted;
        isMutingToggle = true;
        auditMessage = string.Empty;
        StateHasChanged();

        try
        {
            await SignalRClient.SetMuteStatusAsync(targetUserId, desiredMuted);
            // SetMuteStatusAsync's bool return is ambiguous (new state vs. success), so reload
            // the profile to read the authoritative mute state from the server.
            await LoadProfileForAudit(targetUserId);

            // Keep the sidebar list badge in sync with the refreshed state.
            var listItem = flaggedProfiles?.Find(p => p.UserId == targetUserId);
            if (listItem != null && auditProfile != null)
                listItem.IsMuted = auditProfile.IsMuted;

            if (auditProfile != null)
                SetAuditMessage(false, auditProfile.IsMuted ? "User muted." : "User unmuted.");
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.ToggleMute");
            SetAuditMessage(true, "Error updating mute status.");
        }
        finally
        {
            isMutingToggle = false;
            StateHasChanged();
        }
    }

