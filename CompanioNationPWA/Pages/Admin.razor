    private async Task HandleBadgeIconUpload(InputFileChangeEventArgs e)
    {
        if (isUploadingBadgeIcon) return;
        isUploadingBadgeIcon = true;
        SetBadgeManagerMessage(false, string.Empty);
        StateHasChanged();
        try
        {
            // Process client-side only. The bytes are held here and uploaded when Save is
            // pressed, so cancelling an edit never leaves an orphaned blob in storage.
            (int errorCode, byte[]? data) = await SignalRClient.ProcessBadgeIconAsync(e.File);
            if (data == null)
            {
                SetBadgeManagerMessage(true, errorCode == -1
                    ? "The image is too large (max 10 MB)."
                    : "The image could not be processed.");
                return;
            }

            badgeIconPendingUpload = data;
            badgeIconPreviewUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(data)}";
            badgeIconType = BadgeIconTypes.Image;
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.BadgeIconUpload");
            SetBadgeManagerMessage(true, "Error processing icon.");
        }
        finally
        {
            isUploadingBadgeIcon = false;
            StateHasChanged();
        }
    }

    private async Task SaveBadge()
    {
        if (string.IsNullOrWhiteSpace(badgeName))
        {
            SetBadgeManagerMessage(true, "A badge name is required.");
            return;
        }

        isSavingBadge = true;
        SetBadgeManagerMessage(false, string.Empty);
        StateHasChanged();
        try
        {
            // A newly-picked icon is uploaded now (only on save), never at selection time.
            if (badgeIconType == BadgeIconTypes.Image && badgeIconPendingUpload != null)
            {
                var upload = await SignalRClient.AdminUploadBadgeIconAsync(badgeIconPendingUpload);
                if (!upload.IsSuccess || upload.Data == Guid.Empty)
                {
                    SetBadgeManagerMessage(true, string.IsNullOrWhiteSpace(upload.Message) ? "Could not upload the icon." : upload.Message);
                    return;
                }
                badgeIconImageGuid = upload.Data;
                badgeIconPendingUpload = null;
                badgeIconPreviewUrl = string.Empty;
            }

            var badge = new EventBadge
            {
                BadgeId = editingBadgeId,
                Name = badgeName.Trim(),
                Description = badgeDescription,
                Icon = badgeIcon,
                IconType = badgeIconType,
                IconImageGuid = badgeIconType == BadgeIconTypes.Image ? badgeIconImageGuid : null,
                IsVisible = badgeIsVisible,
                IsActive = badgeIsActive,
                SearchWeight = badgeSearchWeight,
                IsSearchFilter = badgeIsSearchFilter,
                TransferMode = badgeTransferMode
            };

            if (editingBadgeId == 0)
            {
                var createResult = await SignalRClient.AdminCreateEventBadgeAsync(badge);
                if (!createResult.IsSuccess)
                {
                    SetBadgeManagerMessage(true, createResult.Message);
                    return;
                }
                SetBadgeManagerMessage(false, "Badge created.");
            }
            else
            {
                var updateResult = await SignalRClient.AdminUpdateEventBadgeAsync(badge);
                if (!updateResult.IsSuccess)
                {
                    SetBadgeManagerMessage(true, updateResult.Message);
                    return;
                }
                SetBadgeManagerMessage(false, "Badge saved.");
            }

            badgeEditorOpen = false;
            await LoadBadgeManager();
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.SaveBadge");
            SetBadgeManagerMessage(true, "Error saving badge.");
        }
        finally
        {
            isSavingBadge = false;
            StateHasChanged();
        }
    }

