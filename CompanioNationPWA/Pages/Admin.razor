        isDeleting = true;
        deleteErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var result = await SignalRClient.AdminDeleteProfileAsync(deleteTargetUserId);
            if (result.IsSuccess)
            {
                showDeleteModal = false;
                // Remove from the triage list and close the audit pane.
                flaggedProfiles?.RemoveAll(p => p.UserId == deleteTargetUserId);
                if (auditProfile != null && auditProfile.UserId == deleteTargetUserId)
                    auditProfile = null;
                SetAuditMessage(false, $"Account for {deleteTargetName} (ID: {deleteTargetUserId}) was deleted.");
            }
            else
            {
                deleteErrorMessage = string.IsNullOrWhiteSpace(result.Message)
                    ? "Unable to delete this account. Please try again."
                    : result.Message;
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.DeleteAccount");
            deleteErrorMessage = "Unable to delete this account. Please try again.";
        }
        finally
        {
            isDeleting = false;
            StateHasChanged();
