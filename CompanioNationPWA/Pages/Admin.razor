    private async Task AwardBadge()
    {
        if (auditProfile == null || selectedBadgeToAward == 0) return;
        isUpdatingBadge = true;
        auditMessage = string.Empty;
        StateHasChanged();

        try
        {
            var result = await SignalRClient.AdminAwardEventBadgeAsync(auditProfile.UserId, selectedBadgeToAward);
            if (result.IsSuccess)
            {
                SetAuditMessage(false, "Badge awarded.");
                await LoadBadgesAsync(auditProfile.UserId);
            }
            else
            {
                SetAuditMessage(true, result.Message);
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.AwardBadge");
            SetAuditMessage(true, "Error awarding badge.");
        }
        finally
        {
            isUpdatingBadge = false;
            StateHasChanged();
        }
    }

    private async Task RevokeBadge(int badgeId)
    {
        if (auditProfile == null) return;
        isUpdatingBadge = true;
        auditMessage = string.Empty;
