    private async Task SaveAccountAttributes()
    {
        if (auditProfile == null) return;
        isSavingAttributes = true;
        auditMessage = string.Empty;
        StateHasChanged();

        try
        {
            var attributes = new AdminUserAttributes
            {
                UserId = auditProfile.UserId,
                SubscriptionExpiry = editSubscriptionExpiry,
                IsAdministrator = editIsAdministrator,
                Verified = editVerified,
                IsMuted = editIsMuted,
                NewPassword = string.IsNullOrWhiteSpace(editNewPassword) ? null : editNewPassword
            };

            var result = await SignalRClient.AdminUpdateUserAttributesAsync(attributes);
            if (result.IsSuccess)
            {
                SetAuditMessage(false, "Account attributes saved.");
                editNewPassword = string.Empty;
                await LoadProfileForAudit(auditProfile.UserId);
            }
            else
            {
                SetAuditMessage(true, result.Message);
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.SaveAccountAttributes");
            SetAuditMessage(true, "Error saving account attributes.");
        }
        finally
        {
            isSavingAttributes = false;
            StateHasChanged();
        }
    }

    private async Task LoadBadgesAsync(int userId)
    {
        isLoadingBadges = true;
        selectedBadgeToAward = 0;
        StateHasChanged();

        try
        {
            var badgesResult = await SignalRClient.GetUserBadgesAsync(userId);
            auditBadges = badgesResult.IsSuccess ? badgesResult.Data ?? new List<EventBadge>() : new List<EventBadge>();

            var allBadgesResult = await SignalRClient.AdminListEventBadgesAsync();
            availableBadges = allBadgesResult.IsSuccess ? allBadgesResult.Data ?? new List<EventBadge>() : new List<EventBadge>();
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.LoadBadges");
            auditBadges = new List<EventBadge>();
            availableBadges = new List<EventBadge>();
        }
        finally
        {
            isLoadingBadges = false;
            StateHasChanged();
        }
