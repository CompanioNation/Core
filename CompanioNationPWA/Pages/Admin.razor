    private async Task StartScamScan()
    {
        if (isScamScanRunning) return;

        isScamScanRunning = true;
        scamScanTotal = 0;
        scamScanChecked = 0;
        scamScanResults.Clear();
        scamScanResultText = string.Empty;
        scamScanCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            string? search = string.IsNullOrWhiteSpace(scamScanSearch) ? null : scamScanSearch.Trim();

            await SignalRClient.AdminClassifyUsersAsync(update =>
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(update);
                    var root = doc.RootElement;

                    // Per-user progress row (carries userId even when that user failed).
                    // Parsed first so a row-level error is shown in the table instead of
                    // being mistaken for a top-level scan error.
                    if (root.TryGetProperty("userId", out var userIdProp))
                    {
                        var row = new ScamScanResultRow { UserId = userIdProp.GetInt32() };
                        if (root.TryGetProperty("name", out var nameProp) && nameProp.ValueKind == System.Text.Json.JsonValueKind.String)
                            row.Name = nameProp.GetString() ?? string.Empty;
                        if (root.TryGetProperty("rating", out var ratingProp) && ratingProp.ValueKind == System.Text.Json.JsonValueKind.Number)
                            row.Rating = ratingProp.GetInt32();
                        if (root.TryGetProperty("rationale", out var rationaleProp) && rationaleProp.ValueKind == System.Text.Json.JsonValueKind.String)
                            row.Rationale = rationaleProp.GetString();
                        if (root.TryGetProperty("skipped", out var skippedProp) && skippedProp.ValueKind == System.Text.Json.JsonValueKind.True)
                            row.Skipped = true;
                        if (root.TryGetProperty("error", out var rowErrorProp) && rowErrorProp.ValueKind == System.Text.Json.JsonValueKind.String)
                            row.Error = rowErrorProp.GetString();
                        scamScanResults.Add(row);

                        if (root.TryGetProperty("checked", out var checkedProp))
                            scamScanChecked = checkedProp.GetInt32();
                        StateHasChanged();
                        return;
                    }

                    // Top-level scan lifecycle / fatal error rows
                    if (root.TryGetProperty("status", out var statusProp))
                    {
                        string status = statusProp.GetString() ?? string.Empty;
                        if (status is "error")
                        {
                            scamScanResultText = root.TryGetProperty("error", out var errProp) && errProp.ValueKind == System.Text.Json.JsonValueKind.String
                                ? $"Error: {errProp.GetString()}"
                                : "Scan failed.";
                            StateHasChanged();
                            return;
                        }
                        if (status == "started")
                        {
                            if (root.TryGetProperty("total", out var totalProp))
                                scamScanTotal = totalProp.GetInt32();
                            StateHasChanged();
                            return;
                        }
                        if (status is "completed" or "cancelled")
                        {
                            scamScanResultText = status == "completed" ? "Scan complete." : "Scan cancelled.";
                            StateHasChanged();
                        }
                    }
                }
                catch
                {
                    // Ignore a single malformed progress payload
                }
            }, null, null, search, scamScanMaxCount, scamScanCts.Token);
        }
        catch (OperationCanceledException)
        {
            scamScanResultText = "Scan cancelled.";
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.ScamScan");
            scamScanResultText = $"Error: {ex.Message}";
        }
        finally
        {
            isScamScanRunning = false;
            scamScanCts?.Dispose();
            scamScanCts = null;
            StateHasChanged();
        }
    }

    private void CancelScamScan()
