    // ========== Photo Compliance Scan ==========

    private async Task StartPhotoComplianceScan()
    {
        isPhotoScanRunning = true;
        photoScanTotal = 0;
        photoScanChecked = 0;
        photoScanPassed = 0;
        photoScanFailed = 0;
        photoScanErrors = 0;
        photoScanPercent = 0;
        photoScanResult = string.Empty;
        photoScanCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            await SignalRClient.AdminCheckAllPhotosAsync(update =>
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(update);
                    var root = doc.RootElement;

                    if (root.TryGetProperty("error", out var errorProp))
                    {
                        photoScanResult = $"Error: {errorProp.GetString()}";
                        return;
                    }

                    if (root.TryGetProperty("total", out var totalProp))
                        photoScanTotal = totalProp.GetInt32();
                    if (root.TryGetProperty("checked", out var checkedProp))
                        photoScanChecked = checkedProp.GetInt32();
                    if (root.TryGetProperty("passed", out var passedProp))
                        photoScanPassed = passedProp.GetInt32();
                    if (root.TryGetProperty("failed", out var failedProp))
                        photoScanFailed = failedProp.GetInt32();
                    if (root.TryGetProperty("errors", out var errorsProp))
                        photoScanErrors = errorsProp.GetInt32();

                    photoScanPercent = photoScanTotal > 0
                        ? (int)(photoScanChecked * 100.0 / photoScanTotal)
                        : 0;

                    if (root.TryGetProperty("status", out var statusProp))
                    {
                        string status = statusProp.GetString() ?? "";
                        if (status == "completed")
                            photoScanResult = $"Scan complete. ✅ {photoScanPassed} passed, ❌ {photoScanFailed} deleted, ⚠️ {photoScanErrors} errors.";
                        else if (status == "cancelled")
                            photoScanResult = $"Scan cancelled. ✅ {photoScanPassed} passed, ❌ {photoScanFailed} deleted, ⚠️ {photoScanErrors} errors.";
                    }

                    InvokeAsync(StateHasChanged);
                }
                catch
                {
                    // Ignore malformed progress updates
                }
            }, photoScanCts.Token);
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Admin.PhotoScan");
            photoScanResult = $"Error: {ex.Message}";
        }
        finally
        {
            isPhotoScanRunning = false;
            photoScanCts?.Dispose();
            photoScanCts = null;
            StateHasChanged();
        }
    }

    private void CancelPhotoComplianceScan()
    {
        photoScanCts?.Cancel();
    }

