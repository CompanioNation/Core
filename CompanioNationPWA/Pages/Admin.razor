@page "/Admin"
@using CompanioNation.Shared
@inject NavigationManager Navigation
@inject ICompanioNationSignalRClient? SignalRClient

@if (IsAdministrator == null)
{
    <div style="display:flex;justify-content:center;align-items:center;min-height:60vh;">
        <div class="spinner"></div>
    </div>
}
else if (IsAdministrator == false)
{
    <p>You do not have permission to view this page.</p>
    <button class="btn btn-primary" @onclick="NavigateToHome">Go to Home</button>
}
else if (activeView == AdminView.Dashboard)
{
    <div class="admin-panel">
        <h3>Administrator Panel</h3>

        @* ========== Safe Section ========== *@
        <div class="tool-section tool-section-safe">
            <div class="tool-section-header">
                <span class="tool-section-icon">👤</span>
                <div>
                    <h4>User Management</h4>
                    <p class="tool-section-desc">Review and edit user profiles. Safe, read/write operations.</p>
                </div>
            </div>
            <button class="tool-card" @onclick="OpenUserEditor">
                <span class="tool-card-icon">✏️</span>
                <div class="tool-card-text">
                    <strong>User Editor</strong>
                    <span>Browse, audit, and edit user profiles and photos</span>
                </div>
                <span class="tool-card-arrow">›</span>
            </button>
            <button class="tool-card" @onclick="OpenStatistics">
                <span class="tool-card-icon">📊</span>
                <div class="tool-card-text">
                    <strong>Site Statistics</strong>
                    <span>Signups, active users, totals — by day, month, and year</span>
                </div>
                <span class="tool-card-arrow">›</span>
            </button>
            <button class="tool-card" @onclick="OpenScamScan">
                <span class="tool-card-icon">🛡️</span>
                <div class="tool-card-text">
                    <strong>Spam/Scam Scan</strong>
                    <span>Have CompanioNita rate users' scam likelihood (0–5)</span>
                </div>
                <span class="tool-card-arrow">›</span>
            </button>
            <button class="tool-card" @onclick="OpenBadgeManager">
                <span class="tool-card-icon">🏅</span>
                <div class="tool-card-text">
                    <strong>Badge Manager</strong>
                    <span>Create badges, assign search weight, share via signed QR, and propagate transferable badges</span>
                </div>
                <span class="tool-card-arrow">›</span>
            </button>
        </div>

        @* ========== Notifications Section ========== *@
        <div class="tool-section tool-section-safe">
            <div class="tool-section-header">
                <span class="tool-section-icon">📣</span>
                <div>
                    <h4>Notifications</h4>
                    <p class="tool-section-desc">Send a broadcast push, or target one user by email.</p>
                </div>
            </div>
            <div class="broadcast-form">
                <div class="ue-edit-field">
                    <label>Title:</label>
                    <input type="text" @bind="broadcastTitle" class="form-control form-control-sm" maxlength="100" placeholder="e.g. CompanioNation update" />
                </div>
                <div class="ue-edit-field">
                    <label>Body:</label>
                    <textarea @bind="broadcastBody" class="form-control form-control-sm" rows="3" maxlength="300" placeholder="Message shown in the notification"></textarea>
                </div>
                <div class="ue-edit-row">
                    <div class="ue-edit-field">
                        <label>URL (optional):</label>
                        <input type="text" @bind="broadcastUrl" class="form-control form-control-sm" placeholder="/" />
                    </div>
                    <div class="ue-edit-field">
                        <label>Target email (optional):</label>
                        <input type="email" @bind="broadcastTargetEmail" class="form-control form-control-sm" placeholder="Broadcast to everyone if empty" autocomplete="off" />
                    </div>
                </div>
                <div class="ue-edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SendBroadcast" disabled="@(isSendingBroadcast || string.IsNullOrWhiteSpace(broadcastTitle) || string.IsNullOrWhiteSpace(broadcastBody))">
                        @(isSendingBroadcast ? "Sending..." : "Send Notification")
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(broadcastResult))
                {
                    <p class="@(broadcastResultIsError ? "maintenance-error" : "maintenance-result")">@broadcastResult</p>
                }
            </div>
        </div>

        @* ========== CompanioNita Section ========== *@
        <div class="tool-section tool-section-moderate">
            <div class="tool-section-header">
                <span class="tool-section-icon">📰</span>
                <div>
                    <h4>CompanioNita Daily Advice</h4>
                    <p class="tool-section-desc">Recover a language whose column failed to generate overnight.</p>
                </div>
            </div>
            <button class="tool-card" @onclick="OpenDailyAdviceRecovery">
                <span class="tool-card-icon">🌐</span>
                <div class="tool-card-text">
                    <strong>Daily Advice Recovery</strong>
                    <span>Safely regenerate one language's column from today's stored outline</span>
                </div>
                <span class="tool-card-arrow">›</span>
            </button>
        </div>

        @* ========== Moderate Section ========== *@
        <div class="tool-section tool-section-moderate">
            <div class="tool-section-header">
                <span class="tool-section-icon">🧪</span>
                <div>
                    <h4>Diagnostics</h4>
                    <p class="tool-section-desc">Test and debug tools. May produce errors in logs.</p>
                </div>
            </div>
            <div class="tool-card-row">
                <button class="tool-card" @onclick="RunTestSuite">
                    <span class="tool-card-icon">🧪</span>
                    <div class="tool-card-text">
                        <strong>Run Test Suite</strong>
                        <span>Execute integration tests</span>
                    </div>
                </button>
                <button class="tool-card" @onclick="TestError">
                    <span class="tool-card-icon">⚠️</span>
                    <div class="tool-card-text">
                        <strong>Test Error</strong>
                        <span>Throw a managed exception</span>
                    </div>
                </button>
                <button class="tool-card" onclick="TestError2()">
                    <span class="tool-card-icon">⚠️</span>
                    <div class="tool-card-text">
                        <strong>Test JS Error</strong>
                        <span>Throw a JavaScript exception</span>
                    </div>
                </button>
                <button class="tool-card" @onclick="TriggerUnobservedTaskException">
                    <span class="tool-card-icon">💥</span>
                    <div class="tool-card-text">
                        <strong>Unobserved Exception</strong>
                        <span>Fire-and-forget fault</span>
                    </div>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(testResult) && testResult != "{}")
            {
                <p class="maintenance-result">Test result: @testResult</p>
            }
        </div>

        @* ========== Data Migration Section ========== *@
        <div class="tool-section tool-section-moderate">
            <div class="tool-section-header">
                <span class="tool-section-icon">🔄</span>
                <div>
                    <h4>Data Migration</h4>
                    <p class="tool-section-desc">One-time migration tools. Safe to run multiple times (idempotent).</p>
                </div>
            </div>
            <button class="tool-card" @onclick="RunGuarantorMigration" disabled="@_isMigrationRunning">
                <span class="tool-card-icon">🔗</span>
                <div class="tool-card-text">
                    <strong>Guarantor → LINK Migration</strong>
                    <span>Maps legacy guarantor_user_id to connection_id on images</span>
                </div>
            </button>

            @if (_isMigrationRunning)
            {
                <div class="spinner-container">
                    <div class="spinner"></div>
                    <p class="maintenance-message">Migration is running...</p>
                </div>
            }

            @if (_migrationResult != null)
            {
                <div class="maintenance-result">
                    <p><strong>Total images with guarantor_user_id:</strong> @_migrationResult.TotalImages</p>
                    <p><strong>Migrated this run:</strong> @_migrationResult.Migrated</p>
                    <p><strong>Already migrated:</strong> @_migrationResult.AlreadyMigrated</p>
                    <p><strong>Orphaned (no matching connection):</strong> @_migrationResult.Orphaned</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_migrationMessage))
            {
                <p class="@(_migrationIsError ? "maintenance-result" : "maintenance-result")">@_migrationMessage</p>
            }
        </div>

        @* ========== Danger Section ========== *@
        <div class="tool-section tool-section-danger">
            <div class="tool-section-header">
                <span class="tool-section-icon">🔴</span>
                <div>
                    <h4>Danger Zone</h4>
                    <p class="tool-section-desc">Impactful operations. The photo scan permanently deletes images; use only as a last resort.</p>
                </div>
            </div>
            <button class="tool-card" @onclick="ExecuteMaintenance" disabled="@isMaintenanceRunning">
                <span class="tool-card-icon">🧹</span>
                <div class="tool-card-text">
                    <strong>Run Database Housekeeping</strong>
                    <span>Recomputes average user ratings and clears invalid negative rankings. Safe to re-run; does not touch CompanioNita advice.</span>
                </div>
            </button>

            @if (isMaintenanceRunning)
            {
                <div class="spinner-container">
                    <div class="spinner"></div>
                    <p class="maintenance-message">Database housekeeping is in progress...</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(maintenanceResult))
            {
                <p class="@GetResultClass()">@maintenanceResult</p>
            }

            <button class="tool-card tool-card-danger" @onclick="StartPhotoComplianceScan"
                    disabled="@isPhotoScanRunning" style="margin-top:8px;">
                <span class="tool-card-icon">📷</span>
                <div class="tool-card-text">
                    <strong>Photo Compliance Scan</strong>
                    <span>Checks all photos with CompanioNita and deletes non-compliant ones</span>
                </div>
            </button>

            @if (isPhotoScanRunning)
            {
                <div class="photo-scan-progress">
                    <div class="progress" style="height: 24px; margin: 8px 0;">
                        <div class="progress-bar" role="progressbar"
                             style="width: @photoScanPercent%;"
                             aria-valuenow="@photoScanPercent" aria-valuemin="0" aria-valuemax="100">
                            @photoScanPercent%
                        </div>
                    </div>
                    <p class="maintenance-message">
                        Checked @photoScanChecked of @photoScanTotal — ✅ @photoScanPassed passed, ❌ @photoScanFailed deleted, ⚠️ @photoScanErrors errors
                    </p>
                    <button class="btn btn-warning btn-sm" @onclick="CancelPhotoComplianceScan">Cancel Scan</button>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(photoScanResult))
            {
                <p class="maintenance-result">@photoScanResult</p>
            }

            <button class="tool-card tool-card-danger" @onclick="FindOrphanedImages"
                    disabled="@(isOrphanScanRunning || isDeletingOrphans)" style="margin-top:8px;">
                <span class="tool-card-icon">🗑️</span>
                <div class="tool-card-text">
                    <strong>Clean Up Orphaned Images</strong>
                    <span>Find Azure blobs with no database record, review thumbnails, then delete them</span>
                </div>
            </button>

            @if (isOrphanScanRunning)
            {
                <div class="spinner-container">
                    <div class="spinner"></div>
                    <p class="maintenance-message">Scanning Azure storage…</p>
                </div>
            }

            @if (orphanedImages != null)
            {
                <div class="orphan-result">
                    @if (orphanedImages.Count == 0)
                    {
                        <p class="maintenance-result">✅ No orphaned images found.</p>
                    }
                    else
                    {
                        <p class="maintenance-result">
                            Found <strong>@orphanedImages.Count</strong> orphaned image(s) in Azure storage.
                        </p>

                        <button type="button" class="orphan-dropdown-toggle" @onclick="ToggleOrphanDropdown">
                            @(orphanDropdownOpen ? "Hide thumbnails ▴" : "View thumbnails ▾")
                        </button>

                        @if (orphanDropdownOpen)
                        {
                            <div class="orphan-thumb-grid">
                                @foreach (var img in orphanedImages)
                                {
                                    <div class="orphan-thumb-item">
                                        <ThumbnailComponent ImageUrl="@Util.GetPhotoUrl(img.ImageGuid)" Alt="@img.BlobName" ThumbnailSize="88px" />
                                        <span>@img.BlobName</span>
                                    </div>
                                }
                            </div>
                        }

                        @if (orphanConfirmPending)
                        {
                            <div class="orphan-confirm">
                                <p class="maintenance-message">
                                    Permanently delete <strong>@orphanedImages.Count</strong> image(s) from Azure storage? This cannot be undone.
                                </p>
                                <div class="orphan-confirm-actions">
                                    <button class="btn btn-danger btn-sm" @onclick="ConfirmDeleteOrphanedImages" disabled="@isDeletingOrphans">
                                        @(isDeletingOrphans ? "Deleting…" : "Yes, delete them")
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" @onclick="CancelOrphanDeletion" disabled="@isDeletingOrphans">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-danger btn-sm" @onclick="RequestOrphanDeletion">Delete @orphanedImages.Count orphaned image(s)</button>
                        }

                        @if (!string.IsNullOrWhiteSpace(orphanScanResult))
                        {
                            <p class="@(orphanScanIsError ? "maintenance-error" : "maintenance-result")">@orphanScanResult</p>
                        }
                    }
                </div>
            }
        </div>
    </div>
}
else if (activeView == AdminView.Statistics)
{
    <div class="admin-panel">
        <div class="stats-header">
            <h3>Site Statistics</h3>
            <div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadSiteStats" disabled="@isLoadingStats">
                    @(isLoadingStats ? "Refreshing…" : "🔄 Refresh")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToDashboard">← Back</button>
            </div>
        </div>

        @if (isLoadingStats && siteStats == null)
        {
            <div class="spinner-container"><div class="spinner"></div><p>Loading statistics…</p></div>
        }
        else if (!string.IsNullOrEmpty(statsError))
        {
            <p class="maintenance-error">@statsError</p>
        }
        else if (siteStats != null)
        {
            <p class="stats-generated">Generated @siteStats.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>

            @* ===== Headline counters ===== *@
            <div class="stats-counter-grid">
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.TotalUsers</span><span class="stats-counter-label">Total Users</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.VerifiedUsers</span><span class="stats-counter-label">Verified</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.UsersWithActiveSubscription</span><span class="stats-counter-label">Subscribers</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.UsersWithPhotos</span><span class="stats-counter-label">With Photos</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.TotalPhotos</span><span class="stats-counter-label">Total Photos</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.TotalMessages</span><span class="stats-counter-label">Messages</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.TotalConnections</span><span class="stats-counter-label">Connections (LINKs)</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.Administrators</span><span class="stats-counter-label">Administrators</span></div>
                <div class="stats-counter"><span class="stats-counter-value">@siteStats.MutedUsers</span><span class="stats-counter-label">Muted</span></div>
            </div>

            @* ===== Snapshot tiles ===== *@
            <div class="stats-snapshot-row">
                <div class="stats-snapshot">
                    <h5>Signups</h5>
                    <div><b>Yesterday:</b> @siteStats.SignupsYesterday</div>
                    <div><b>Previous 7 days:</b> @siteStats.SignupsLast7Days</div>
                    <div><b>Previous 30 days:</b> @siteStats.SignupsLast30Days</div>
                </div>
                <div class="stats-snapshot">
                    <h5>Recent Activity <span class="stats-hint" title="Based on cn_users.last_login (most recent login per user). Windows cover complete days and end yesterday.">ⓘ</span></h5>
                    <div><b>Active yesterday:</b> @siteStats.ActiveYesterday</div>
                    <div><b>Active previous 7 days:</b> @siteStats.ActiveLast7Days</div>
                    <div><b>Active previous 30 days:</b> @siteStats.ActiveLast30Days</div>
                </div>
            </div>

            @* ===== Charts ===== *@
            <div class="stats-chart">
                <h5>Signups — Last 30 Days <span class="stats-hint" title="Complete days only; ends yesterday so the final point is not a partial day.">ⓘ</span></h5>
                <Charts Buckets="siteStats.SignupsByDay" Type="line" />
            </div>
            <div class="stats-chart">
                <h5>Signups — Last 12 Months</h5>
                <Charts Buckets="siteStats.SignupsByMonth" Type="line" />
            </div>
            <div class="stats-chart">
                <h5>Signups — By Year</h5>
                <Charts Buckets="siteStats.SignupsByYear" Type="bar" />
            </div>
            <div class="stats-chart">
                <h5>Active Users — Last 30 Days (by last login) <span class="stats-hint" title="Complete days only; ends yesterday so the final point is not a partial day.">ⓘ</span></h5>
                <Charts Buckets="siteStats.ActiveUsersByDay" Type="line" />
            </div>
        }
    </div>
}
else if (activeView == AdminView.Badges)
{
    <div class="admin-panel">
        <div class="stats-header">
            <h3>Badge Manager</h3>
            <div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToDashboard">← Back</button>
            </div>
        </div>

        <div class="tool-section tool-section-safe" style="margin-top:12px;">
            <div class="tool-section-header">
                <span class="tool-section-icon">🏅</span>
                <div>
                    <h4>Badges</h4>
                    <p class="tool-section-desc">
                        Create and edit badges. Search weight floats (boost) or sinks a holder in search results.
                        A <strong>secret</strong> badge still affects search but is hidden from everyone except admins.
                        <strong>Transferable</strong> badges can be passed on by their holder via a signed QR code.
                    </p>
                </div>
            </div>

            <div class="ue-edit-actions" style="margin-bottom:12px;">
                <button class="btn btn-primary btn-sm" @onclick="StartCreateBadge">+ New Badge</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadBadgeManager" disabled="@isLoadingBadgeManager">Refresh</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(badgeManagerMessage))
            {
                <p class="@(badgeManagerMessageIsError ? "maintenance-error" : "maintenance-result")">@badgeManagerMessage</p>
            }

            @if (isLoadingBadgeManager)
            {
                <div class="spinner-container"><div class="spinner"></div><p class="maintenance-message">Loading badges…</p></div>
            }
            else if (badgeManagerBadges == null || badgeManagerBadges.Count == 0)
            {
                <p class="text-muted">No badges defined yet.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Icon</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Transfer</th>
                            <th>Search&nbsp;weight</th>
                            <th>Flags</th>
                            <th>Awards</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in badgeManagerBadges)
                        {
                            <tr>
                                <td>
                                    <BadgeIconComponent Badge="b" Size="1.4em" />
                                </td>
                                <td>@b.Name</td>
                                <td style="max-width:260px;">@b.Description</td>
                                <td>@TransferModeLabel(b.TransferMode)</td>
                                <td>@b.SearchWeight</td>
                                <td>
                                    @if (!b.IsActive) { <span class="badge bg-secondary">inactive</span> }
                                    @if (!b.IsVisible) { <span class="badge bg-warning text-dark">secret</span> }
                                    @if (b.IsSearchFilter) { <span class="badge bg-info text-dark">filter</span> }
                                </td>
                                <td>@b.AwardCount</td>
                                <td style="white-space:nowrap;">
                                    <button class="btn btn-outline-info btn-sm" @onclick="() => StartBadgeQr(b)">QR</button>
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => StartEditBadge(b)">Edit</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => StartDeleteBadge(b)">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (badgeDeleteConfirm != null)
        {
            <div class="tool-section tool-section-danger" style="margin-top:12px;">
                <h4>Delete “@badgeDeleteConfirm.Name”?</h4>
                <p>This permanently deletes the badge, its icon, and all <strong>@badgeDeleteConfirm.AwardCount</strong> award(s). This cannot be undone.</p>
                <div class="ue-edit-actions">
                    <button class="btn btn-danger btn-sm" @onclick="ConfirmDeleteBadge" disabled="@isDeletingBadge">
                        @(isDeletingBadge ? "Deleting…" : "Permanently Delete")
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelDeleteBadge" disabled="@isDeletingBadge">Cancel</button>
                </div>
            </div>
        }

        @if (badgeQrOpen)
        {
            <div class="tool-section tool-section-safe" style="margin-top:12px;">
                <div class="tool-section-header">
                    <span class="tool-section-icon">🔗</span>
                    <div>
                        <h4>QR for <BadgeIconComponent Badge="badgeQrBadge" Size="1.3em" /> “@badgeQrBadgeName”</h4>
                        <p class="tool-section-desc">
                            Anyone who scans this and is signed in acquires the badge. The code is signed and
                            expires in 3 minutes; tap QR again to refresh.
                        </p>
                    </div>
                </div>
                @if (string.IsNullOrWhiteSpace(badgeQrUrl))
                {
                    <div class="spinner-container"><div class="spinner"></div><p class="maintenance-message">Generating…</p></div>
                }
                else
                {
                    <QRCodeComponent Url="@badgeQrUrl" />
                }
                <div class="ue-edit-actions">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseBadgeQr">Close</button>
                </div>
            </div>
        }

        @if (badgeEditorOpen)
        {
            <div class="tool-section tool-section-safe" style="margin-top:12px;">
                <h4>@(editingBadgeId == 0 ? "New Badge" : "Edit Badge")</h4>

                <div class="ue-edit-row">
                    <div class="ue-edit-field">
                        <label>Name:</label>
                        <input type="text" class="form-control form-control-sm" maxlength="100" @bind="badgeName" />
                    </div>
                </div>
                <div class="ue-edit-field">
                    <label>Description:</label>
                    <textarea class="form-control form-control-sm" rows="2" maxlength="500" @bind="badgeDescription"></textarea>
                </div>

                <div class="ue-edit-row">
                    <div class="ue-edit-field">
                        <label>Transfer mode:</label>
                        <select class="form-control form-control-sm" @bind="badgeTransferMode">
                            <option value="@BadgeTransferMode.None">None — admin awards only</option>
                            <option value="@BadgeTransferMode.Multiplicative">Transferable — holder shares copies (grows a tree)</option>
                            <option value="@BadgeTransferMode.Singleton">Singleton — one instance, passed hand to hand</option>
                        </select>
                    </div>
                    <div class="ue-edit-field">
                        <label>Search weight:</label>
                        <select class="form-control form-control-sm" @bind="badgeSearchWeight">
                            <option value="@BadgeSearchWeights.Sink">Sink (@BadgeSearchWeights.Sink)</option>
                            <option value="@BadgeSearchWeights.Neutral">Neutral (@BadgeSearchWeights.Neutral)</option>
                            <option value="@BadgeSearchWeights.LightBoost">Light boost (+@BadgeSearchWeights.LightBoost)</option>
                            <option value="@BadgeSearchWeights.MediumBoost">Medium boost (+@BadgeSearchWeights.MediumBoost)</option>
                            <option value="@BadgeSearchWeights.StrongBoost">Strong boost (+@BadgeSearchWeights.StrongBoost)</option>
                        </select>
                    </div>
                </div>

                <div class="ue-edit-row">
                    <div class="ue-edit-field">
                        <label>Secret (affects search, hidden on profiles):</label>
                        <select class="form-control form-control-sm" value="@(badgeIsVisible ? "true" : "false")" @onchange="OnBadgeVisibleChanged">
                            <option value="true">No — show this badge on profiles</option>
                            <option value="false">Yes — secret (search only)</option>
                        </select>
                    </div>
                    <div class="ue-edit-field">
                        <label>Offer as search filter:</label>
                        <select class="form-control form-control-sm" value="@(badgeIsSearchFilter ? "true" : "false")" @onchange="OnBadgeSearchFilterChanged">
                            <option value="false">No</option>
                            <option value="true">Yes — show in “must have badge” filter</option>
                        </select>
                    </div>
                </div>

                @if (editingBadgeId != 0)
                {
                    <div class="ue-edit-field">
                        <label>Active:</label>
                        <select class="form-control form-control-sm" value="@(badgeIsActive ? "true" : "false")" @onchange="OnBadgeActiveChanged">
                            <option value="true">Yes — available</option>
                            <option value="false">No — retired (kept for history)</option>
                        </select>
                    </div>
                }

                <div class="ue-edit-field">
                    <label>Icon — pick a standard icon:</label>
                    <div class="badge-icon-grid">
                        @foreach (var emoji in StandardBadgeIcons)
                        {
                            <button type="button" class="badge-icon-choice @(badgeIconType == BadgeIconTypes.Emoji && badgeIcon == emoji ? "selected" : "")"
                                    @onclick="() => SelectBadgeEmoji(emoji)">@emoji</button>
                        }
                    </div>
                </div>

                <div class="ue-edit-field">
                    <label>…or upload an image:</label>
                    <div style="display:flex;align-items:center;gap:12px;">
                        @if (!string.IsNullOrEmpty(badgeIconPreviewUrl))
                        {
                            <img src="@badgeIconPreviewUrl" alt="Badge icon preview" style="width:2.5rem;height:2.5rem;border-radius:4px;object-fit:cover;" />
                        }
                        else
                        {
                            <BadgeIconComponent Badge="@(new EventBadge { Icon = badgeIcon, IconType = badgeIconType, IconImageGuid = badgeIconImageGuid })" Size="2.5rem" />
                        }
                        <InputFile OnChange="HandleBadgeIconUpload" disabled="@isUploadingBadgeIcon" accept="image/*" />
                        @if (isUploadingBadgeIcon)
                        {
                            <span class="maintenance-message">Uploading…</span>
                        }
                    </div>
                </div>

                <div class="ue-edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SaveBadge" disabled="@isSavingBadge">
                        @(isSavingBadge ? "Saving…" : "Save Badge")
                    </button>
                    <button class="btn btn-secondary btn-sm" @onclick="CancelBadgeEditor" disabled="@isSavingBadge">Cancel</button>
                </div>
            </div>
        }
    </div>
}
else if (activeView == AdminView.UserEditor)
{
    <div class="user-editor-layout">
        @* Hamburger toggle *@
        <button class="ue-expand-button" @onclick="ToggleUserSidebar" title="Toggle user list">☰</button>

        @* Sidebar with user list *@
        <div class="ue-sidebar @(userSidebarCollapsed ? "collapsed" : "")">
            <div class="ue-sidebar-header">
                <h4>Users</h4>
                <button class="btn btn-sm btn-outline-light ue-back-btn" @onclick="BackToDashboard">← Back</button>
            </div>

            <div class="ue-search-bar">
                <input type="text" class="form-control form-control-sm" placeholder="Search name, email, or ID…"
                       @bind="searchTerm" @bind:event="oninput" @onkeydown="SearchKeyDown" />
                <button class="btn btn-sm btn-outline-light" @onclick="ExecuteSearch">🔍</button>
            </div>

            @if (isLoadingProfiles)
            {
                <div class="ue-loading">
                    <div class="spinner"></div>
                    <p>Loading…</p>
                </div>
            }
            else if (flaggedProfiles == null || flaggedProfiles.Count == 0)
            {
                <p class="ue-empty">No profiles found.</p>
                <button class="btn btn-sm btn-outline-light" style="margin: 0 8px;" @onclick="LoadFlaggedProfiles">Refresh</button>
            }
            else
            {
                <div class="ue-user-list">
                    @foreach (var profile in flaggedProfiles)
                    {
                        <div class="ue-user-item @(auditProfile?.UserId == profile.UserId ? "active" : "")"
                             @onclick="() => SelectUser(profile.UserId)">
                            <ThumbnailComponent ImageUrl="@Util.GetPhotoUrl(profile.Thumbnail)" Alt="@profile.Name" ThumbnailSize="40px" Circle="true" />
                            <div class="ue-user-info">
                                <span class="ue-user-name">
                                    @profile.Name
                                    @if (profile.IsDeleted)
                                    {
                                        <span class="ue-muted-badge" title="Deleted account" style="color:#dc3545;">🚫</span>
                                    }
                                    @if (profile.IsMuted)
                                    {
                                        <span class="ue-muted-badge" title="Muted">🔇</span>
                                    }
                                </span>
                                <span class="ue-user-meta">@Util.GetGenderString(profile.Gender) · Rank @profile.Ranking</span>
                            </div>
                            @if (profile.PendingReportsCount > 0)
                            {
                                <span class="ue-report-badge" title="@profile.PendingReportsCount unresolved report(s)">@profile.PendingReportsCount</span>
                            }
                        </div>
                    }
                </div>

                <div class="ue-pagination">
                    <button class="btn btn-sm btn-outline-light" disabled="@(currentOffset == 0)" @onclick="PreviousPage">←</button>
                    <span>Page @(currentOffset / pageSize + 1)</span>
                    <button class="btn btn-sm btn-outline-light" disabled="@(flaggedProfiles.Count < pageSize)" @onclick="NextPage">→</button>
                </div>
            }
        </div>

        @* Detail pane *@
        <div class="ue-detail @(userSidebarCollapsed ? "expanded" : "")" @onclick="HandleDetailClick">
            @if (isLoadingAudit)
            {
                <div class="ue-loading">
                    <div class="spinner"></div>
                    <p>Loading profile details…</p>
                </div>
            }
            else if (auditProfile != null)
            {
                @* User header with photo strip *@
                <div class="ue-detail-header">
                    <div class="ue-detail-title">
                        <h4>@auditProfile.Name <span class="ue-detail-id">(ID: @auditProfile.UserId)</span></h4>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CloseAudit">✕</button>
                    </div>
                </div>

                @* Info grid *@
                <div class="ue-info-grid">
                    <div><b>Email:</b> @auditProfile.Email</div>
                    <div><b>Gender:</b> @Util.GetGenderString(auditProfile.Gender)</div>
                    <div><b>DOB:</b> @(auditProfile.DateOfBirth?.ToString("d") ?? "Not set")</div>
                    <div><b>Ranking:</b> @auditProfile.Ranking</div>
                    <div><b>Reports:</b> <span class="@(auditProfile.PendingReportsCount > 0 ? "text-danger fw-bold" : "")">@auditProfile.PendingReportsCount pending</span></div>
                    <div><b>Muted:</b> @(auditProfile.IsMuted ? "Yes 🔇" : "No")</div>
                    <div><b>Deleted:</b> @(auditProfile.IsDeleted ? "Yes 🚫" : "No")</div>
                    <div><b>Searchable:</b> @(auditProfile.Searchable ? "Yes" : "No")</div>
                    <div><b>Member since:</b> @auditProfile.DateCreated.ToString("d")</div>
                    <div><b>Last login:</b> @(auditProfile.LastLogin?.ToString("g") ?? "Never")</div>
                    <div><b>Location:</b> @auditProfile.CityDisplayName</div>
                    <div><b>Payment system:</b> @(auditProfile.PaymentSystem ?? "None")</div>
                </div>

                @* Scam classification *@
                <div class="ue-edit-section" @onclick:stopPropagation="true">
                    <h5>Scam Classification</h5>
                    @if (auditProfile.ScamRating is int scamRating)
                    {
                        <p class="@(scamRating >= 5 ? "text-danger fw-bold" : "")">
                            Rating: @scamRating/5
                            @if (scamRating >= 5)
                            {
                                <span>⚠️</span>
                            }
                            @if (auditProfile.ScamRatingTimestamp is DateTime scamTs)
                            {
                                <small class="text-muted">— @scamTs.ToLocalTime().ToString("g")</small>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(auditProfile.ScamRatingRationale))
                        {
                            <p class="text-muted">@auditProfile.ScamRatingRationale</p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Not classified yet. 0 = genuine, 5 = definitely a scammer. Classified at most once per day.</p>
                    }
                    <div class="ue-edit-actions">
                        <button class="btn btn-primary btn-sm" @onclick="ClassifyAuditUser" disabled="@isClassifyingUser">
                            @(isClassifyingUser ? "Classifying…" : (auditProfile.ScamRating is null ? "Classify Now" : "Reclassify (once/day)"))
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(scamAuditMessage))
                    {
                        <p class="@(scamAuditMessageIsError ? "maintenance-error" : "maintenance-result")">@scamAuditMessage</p>
                    }
                </div>

                @* Edit form *@
                <div class="ue-edit-section" @onclick:stopPropagation="true">
                    <h5>Edit Profile</h5>
                    <div class="ue-edit-field">
                        <label>Name:</label>
                        <input type="text" maxlength="15" @bind="editName" class="form-control form-control-sm" />
                    </div>
                    <div class="ue-edit-field">
                        <label>Description:</label>
                        <textarea @bind="editDescription" class="form-control form-control-sm" rows="4" maxlength="4096"></textarea>
                    </div>
                    <div class="ue-edit-row">
                        <div class="ue-edit-field">
                            <label>Gender:</label>
                            <select @bind="editGender" class="form-control form-control-sm">
                                <option value="0">Unknown</option>
                                <option value="2">Male</option>
                                <option value="4">Female</option>
                                <option value="8">Other</option>
                                <option value="16">Trans Male</option>
                                <option value="32">Trans Female</option>
                            </select>
                        </div>
                        <div class="ue-edit-field">
                            <label>Searchable:</label>
                            <select value="@(editSearchable ? "true" : "false")" @onchange="OnSearchableChanged" class="form-control form-control-sm">
                                <option value="true">Yes — visible in search</option>
                                <option value="false">No — hidden from search</option>
                            </select>
                        </div>
                    </div>
                    <div class="ue-edit-actions">
                        <button class="btn btn-primary btn-sm" @onclick="SaveProfileEdits" disabled="@isSaving">
                            @(isSaving ? "Saving..." : "Save Changes")
                        </button>
                    </div>
                </div>

                @* Account attributes *@
                <div class="ue-edit-section" @onclick:stopPropagation="true">
                    <h5>Account Attributes</h5>
                    <div class="ue-edit-row">
                        <div class="ue-edit-field">
                            <label>Subscription expiry:</label>
                            <input type="date" @bind="editSubscriptionExpiry" @bind:format="yyyy-MM-dd" class="form-control form-control-sm" />
                            <small class="text-muted">Leave empty to clear (no subscription).</small>
                        </div>
                        <div class="ue-edit-field">
                            <label>New password (optional):</label>
                            <input type="password" @bind="editNewPassword" class="form-control form-control-sm" placeholder="Leave blank to keep current password" autocomplete="new-password" />
                        </div>
                    </div>
                    <div class="ue-edit-row">
                        <div class="ue-edit-field">
                            <label>Administrator:</label>
                            <select value="@(editIsAdministrator ? "true" : "false")" @onchange="OnAdminFlagChanged" class="form-control form-control-sm">
                                <option value="true">Yes — admin</option>
                                <option value="false">No — regular user</option>
                            </select>
                        </div>
                        <div class="ue-edit-field">
                            <label>Verified:</label>
                            <select value="@(editVerified ? "true" : "false")" @onchange="OnVerifiedChanged" class="form-control form-control-sm">
                                <option value="true">Yes — verified</option>
                                <option value="false">No — not verified</option>
                            </select>
                        </div>
                    </div>
                    <div class="ue-edit-field">
                        <label>Muted:</label>
                        <select value="@(editIsMuted ? "true" : "false")" @onchange="OnMuteFlagChanged" class="form-control form-control-sm">
                            <option value="true">Yes — muted</option>
                            <option value="false">No — not muted</option>
                        </select>
                    </div>
                    <div class="ue-edit-actions">
                        <button class="btn btn-primary btn-sm" @onclick="SaveAccountAttributes" disabled="@isSavingAttributes">
                            @(isSavingAttributes ? "Saving..." : "Save Account Attributes")
                        </button>
                    </div>
                </div>

                @* Event badges *@
                <div class="ue-edit-section" @onclick:stopPropagation="true">
                    <h5>Event Badges (@auditBadges.Count)</h5>

                    @if (isLoadingBadges)
                    {
                        <div class="spinner-container"><div class="spinner"></div><p>Loading badges…</p></div>
                    }
                    else if (auditBadges.Count == 0)
                    {
                        <p class="text-muted">No badges awarded.</p>
                    }
                    else
                    {
                        <div class="ue-badge-list">
                            @foreach (var badge in auditBadges)
                            {
                                <div class="ue-badge-item">
                                    <BadgeIconComponent Badge="badge" Size="1.2em" />
                                    <span class="ue-badge-name">@badge.Name</span>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => RevokeBadge(badge.BadgeId)" disabled="@isUpdatingBadge">Remove</button>
                                </div>
                            }
                        </div>
                    }

                    @if (availableBadges.Count > 0)
                    {
                        <div class="ue-badge-award-row">
                            <select @bind="selectedBadgeToAward" class="form-control form-control-sm">
                                <option value="0">Select a badge to award…</option>
                                @foreach (var badge in availableBadges.Where(b => auditBadges.All(a => a.BadgeId != b.BadgeId)))
                                {
                                    <option value="@badge.BadgeId">@(badge.IconType == BadgeIconTypes.Emoji ? badge.Icon + " " : "")@badge.Name</option>
                                }
                            </select>
                            <button class="btn btn-outline-primary btn-sm" @onclick="AwardBadge" disabled="@(isUpdatingBadge || selectedBadgeToAward == 0)">Award</button>
                        </div>
                    }
                </div>

                @* Send notification to this user *@
                <div class="ue-edit-section" @onclick:stopPropagation="true">
                    <h5>Send Notification to @auditProfile.Email</h5>
                    <div class="ue-edit-field">
                        <label>Title:</label>
                        <input type="text" @bind="userNotifyTitle" class="form-control form-control-sm" maxlength="100" placeholder="Notification title" />
                    </div>
                    <div class="ue-edit-field">
                        <label>Body:</label>
                        <textarea @bind="userNotifyBody" class="form-control form-control-sm" rows="3" maxlength="300" placeholder="Notification message"></textarea>
                    </div>
                    <div class="ue-edit-field">
                        <label>URL (optional):</label>
                        <input type="text" @bind="userNotifyUrl" class="form-control form-control-sm" placeholder="/" />
                    </div>
                    <div class="ue-edit-actions">
                        <button class="btn btn-primary btn-sm" @onclick="SendUserNotification" disabled="@(isSendingUserNotify || string.IsNullOrWhiteSpace(userNotifyTitle) || string.IsNullOrWhiteSpace(userNotifyBody))">
                            @(isSendingUserNotify ? "Sending..." : "Send Notification")
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(userNotifyResult))
                    {
                        <p class="@(userNotifyResultIsError ? "maintenance-error" : "maintenance-result")">@userNotifyResult</p>
                    }
                </div>

                @* Photos *@
                <div class="ue-photos-section">
                    <h5>Photos (@auditProfile.Photos.Count)</h5>
                    @if (auditProfile.Photos.Count == 0)
                    {
                        <p class="text-muted">No photos.</p>
                    }
                    else
                    {
                        <div class="ue-photo-grid">
                            @foreach (var photo in auditProfile.Photos)
                            {
                                <div class="ue-photo-card">
                                    <ThumbnailComponent ImageUrl="@Util.GetPhotoUrl(photo.ImageGuid)" Alt="@($"Photo {photo.ImageId}")" ThumbnailSize="150px" />
                                    <div class="ue-photo-meta">
                                        <span class="@(photo.ImageVisible ? "photo-visible" : "photo-hidden")">
                                            @(photo.ImageVisible ? "Visible" : "Hidden")
                                        </span>
                                        <span>@photo.DateCreated.ToString("d")</span>
                                    </div>
                                    @if (photoBeingDeleted == photo.ImageId)
                                    {
                                        <div class="ue-delete-confirm">
                                            <span>Delete this photo?</span>
                                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeletePhoto(photo.ImageId)">Yes</button>
                                            <button class="btn btn-secondary btn-sm" @onclick="CancelDeletePhoto">No</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ue-photo-actions">
                                            <button class="btn btn-outline-info btn-sm" @onclick="() => CheckPhotoCompliance(photo.ImageGuid)"
                                                    disabled="@(photoBeingChecked == photo.ImageGuid)">
                                                @(photoBeingChecked == photo.ImageGuid ? "Checking…" : "🔍 Check")
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" @onclick="() => StartDeletePhoto(photo.ImageId)">Delete</button>
                                        </div>
                                        @if (photoCheckResults.TryGetValue(photo.ImageGuid, out var checkResult))
                                        {
                                            <p class="ue-photo-check-result">@checkResult</p>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Description preview *@
                <div class="ue-description">
                    <h5>Current Description</h5>
                    <div class="ue-description-text">@auditProfile.Description</div>
                </div>

                @* Actions *@
                <div class="ue-actions">
                    <button class="btn @(auditProfile.IsMuted ? "btn-warning" : "btn-outline-warning")" @onclick="ToggleMute" disabled="@isMutingToggle">
                        @(isMutingToggle ? "Working…" : (auditProfile.IsMuted ? "🔊 Unmute User" : "🔇 Mute User"))
                    </button>
                    <button class="btn btn-success" @onclick="DismissProfile" disabled="@isDismissing">
                        @(isDismissing ? "Dismissing..." : "✓ Approve & Dismiss")
                    </button>
                    <button class="btn btn-danger" @onclick="StartDeleteFlow" disabled="@isDeleting">
                        @(isDeleting ? "Deleting..." : "🗑 Delete Account")
                    </button>
                </div>

                @if (!string.IsNullOrWhiteSpace(auditMessage))
                {
                    <p class="@(auditMessageIsError ? "maintenance-error" : "maintenance-result")">@auditMessage</p>
                }
            }
            else
            {
                <div class="ue-empty-detail">
                    <p>← Select a user from the list to view their profile</p>
                </div>
            }
        </div>
    </div>
}
else if (activeView == AdminView.DailyAdviceRecovery)
{
    <div class="admin-panel">
        <div class="stats-header">
            <h3>Daily Advice Recovery</h3>
            <div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToDashboard">← Back</button>
            </div>
        </div>

        <div class="tool-section tool-section-moderate" style="margin-top:12px;">
            <div class="tool-section-header">
                <span class="tool-section-icon">🌐</span>
                <div>
                    <h4>Regenerate Daily Advice</h4>
                    <p class="tool-section-desc">
                        Use this when the nightly report flags something that failed.
                        Choosing a single language re-runs just that column from the outline already stored by the nightly
                        batch — every other language is left untouched. Choosing <strong>Outline + all languages</strong>
                        regenerates the outline and all six columns, which is the recovery when the outline failed and no
                        columns exist for today.
                    </p>
                    <p class="tool-section-desc">
                        ⚠️ <strong>Outline + all languages</strong> writes a new day's row, so running it when today's
                        columns already exist creates duplicates — same caveat as Run Daily Maintenance below.
                    </p>
                </div>
            </div>

            <div class="ue-edit-row" style="align-items:center;">
                <div class="ue-edit-field">
                    <label>Regenerate:</label>
                    <select class="form-control form-control-sm" @bind="recoveryLanguageCode" disabled="@isRegeneratingAdvice">
                        <option value="@DailyAdviceRecoveryTarget.Outline">Outline + all languages (full recovery)</option>
                        @foreach (string langCode in SupportedLanguages.Codes)
                        {
                            <option value="@langCode">@($"{SupportedLanguages.NativeName(langCode)} ({langCode})")</option>
                        }
                    </select>
                </div>
                <div class="ue-edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="RegenerateDailyAdvice" disabled="@isRegeneratingAdvice">
                        @(isRegeneratingAdvice ? "Generating…" : "Regenerate")
                    </button>
                </div>
            </div>

            @if (isRegeneratingAdvice)
            {
                <div class="spinner-container">
                    <div class="spinner"></div>
                    <p class="maintenance-message">Generating @GetRecoveryTargetLabel()… this can take a few minutes.</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(recoveryResult))
            {
                <p class="@(recoveryResultIsError ? "maintenance-error" : "maintenance-result")">@recoveryResult</p>
            }
        </div>
    </div>
}
else if (activeView == AdminView.ScamScan)
{
    <div class="admin-panel">
        <div class="stats-header">
            <h3>Spam / Scam Scan</h3>
            <div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToDashboard">← Back</button>
            </div>
        </div>

        <div class="tool-section tool-section-moderate" style="margin-top:12px;">
            <div class="tool-section-header">
                <span class="tool-section-icon">🛡️</span>
                <div>
                    <h4>AI Scam Classification</h4>
                    <p class="tool-section-desc">CompanioNita reviews each user's profile and messages and rates how likely they are a scammer, spammer, or fake profile — 0 = genuine, 5 = definitely a scammer. Each user is classified at most once per day, and profiles AI-checked within the last 24 hours are skipped automatically. With no search entered, the scan starts with reported profiles, then the most recently active members.</p>
                </div>
            </div>

            <div class="ue-search-bar">
                <input type="text" class="form-control form-control-sm" placeholder="Search name, email, or ID… (blank = reported profiles, then most recently active)"
                       @bind="scamScanSearch" @bind:event="oninput" @onkeydown="ScamScanSearchKeyDown" />
            </div>
            <div class="ue-edit-row" style="align-items:center;">
                <div class="ue-edit-field">
                    <label>Max users:</label>
                    <input type="number" class="form-control form-control-sm" @bind="scamScanMaxCount" min="1" max="200" />
                </div>
                <div class="ue-edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="StartScamScan" disabled="@isScamScanRunning">
                        @(isScamScanRunning ? "Scanning…" : "Start Scan")
                    </button>
                    @if (isScamScanRunning)
                    {
                        <button class="btn btn-warning btn-sm" @onclick="CancelScamScan">Cancel</button>
                    }
                </div>
            </div>

            @if (isScamScanRunning || scamScanTotal > 0)
            {
                <div class="photo-scan-progress">
                    <div class="progress" style="height: 24px; margin: 8px 0;">
                        <div class="progress-bar" role="progressbar"
                             style="width: @(scamScanTotal > 0 ? (scamScanChecked * 100 / scamScanTotal) : 0)%;"
                             aria-valuenow="@scamScanChecked" aria-valuemin="0" aria-valuemax="@scamScanTotal">
                            @(scamScanTotal > 0 ? (scamScanChecked * 100 / scamScanTotal) : 0)%
                        </div>
                    </div>
                    <p class="maintenance-message">Checked @scamScanChecked of @scamScanTotal</p>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(scamScanResultText))
            {
                <p class="maintenance-result">@scamScanResultText</p>
            }

            @if (scamScanResults.Count > 0)
            {
                <table class="table table-sm table-striped" style="margin-top:12px;">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Rating</th>
                            <th>Rationale</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in scamScanResults)
                        {
                            <tr>
                                <td>@row.Name <small class="text-muted">(ID: @row.UserId)</small></td>
                                <td>
                                    @if (row.Rating is int rowRating)
                                    {
                                        <span class="@(rowRating >= 5 ? "text-danger fw-bold" : "")">@rowRating/5</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@row.Rationale</td>
                                <td>
                                    @if (row.Error != null)
                                    {
                                        <span class="text-danger">@row.Error</span>
                                    }
                                    else if (row.Skipped)
                                    {
                                        <span class="text-muted">already classified today</span>
                                    }
                                    else
                                    {
                                        <span>done</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="admin-delete-modal-overlay" @onclick="CancelDelete">
        <div class="admin-delete-modal" @onclick:stopPropagation="true">
            @if (deleteStep == AdminDeleteStep.Warning)
            {
                <h4 class="admin-delete-modal-title">Delete User Account</h4>
                <p class="admin-delete-modal-warning-heading">
                    This will permanently delete <b>@deleteTargetName</b> (ID: @deleteTargetUserId). The user will lose:
                </p>
                <ul class="admin-delete-modal-loss-list">
                    <li>Their searchable profile, name, and description</li>
                    <li>All uploaded images and reviews</li>
                    <li>Their active session and push notifications</li>
                </ul>
                <p class="admin-delete-modal-warning-subtext">This action cannot be undone.</p>

                <div class="admin-delete-modal-actions">
                    <button class="btn btn-danger" @onclick="ProceedToConfirmDelete">Continue to Delete</button>
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                </div>
            }
            else if (deleteStep == AdminDeleteStep.Confirm)
            {
                <h4 class="admin-delete-modal-title">Confirm Account Deletion</h4>
                <p>To confirm, type the user's email address exactly:</p>
                <p class="admin-delete-modal-email-hint">@deleteTargetEmail</p>
                <input type="text"
                       class="form-control admin-delete-confirm-input"
                       placeholder="Enter the user's email address"
                       @bind="deleteConfirmEmail"
                       @bind:event="oninput" />

                @if (!string.IsNullOrEmpty(deleteErrorMessage))
                {
                    <div class="alert alert-danger" style="margin-top:12px;">@deleteErrorMessage</div>
                }

                <div class="admin-delete-modal-actions">
                    <button class="btn btn-danger"
                            @onclick="ConfirmDeleteProfile"
                            disabled="@(!DeleteConfirmEmailMatches || isDeleting)">
                        @(isDeleting ? "Deleting..." : "Permanently Delete Account")
                    </button>
                    <button class="btn btn-secondary" @onclick="CancelDelete" disabled="@isDeleting">Cancel</button>
                </div>
            }
        </div>
    </div>
}
