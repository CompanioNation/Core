@page "/ResetPassword"
@using System.ComponentModel.DataAnnotations
@inject IJSRuntime JS
@inject ICompanioNationSignalRClient? SignalRClient
@inject NavigationManager NavManager
@inject IStringLocalizer<ResetPassword> Loc

<style>
    .reset-page {
        margin: 1em;
    }
    .centered {
        margin: 1em;
    }
</style>
<div class="reset-page">

<div>

    @if (!_isLoading && !_isSuccess)
    {
        @if (_showEmailInput)
        {
            <h3>@Loc["ResetPassword_VerifyTitle"]</h3>
            <div class="form-group">
                <label for="email">@Loc["ResetPassword_EmailLabel"]</label>
                <input id="email" type="email" @bind="_email" class="form-control" />
            </div>

            <div class="centered">
                <ActionButton OnClick="RequestPasswordReset">@Loc["ResetPassword_SendEmail"]</ActionButton>
            </div>
        }
        else
        {
            <h3>@Loc["ResetPassword_PickPassword"]</h3>
            <div class="form-group">
                <label for="newPassword">@Loc["ResetPassword_NewPassword"]</label>
                <input id="newPassword" type="password" @bind="_passwordResetModel.NewPassword" class="form-control" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">@Loc["ResetPassword_ConfirmPassword"]</label>
                <input id="confirmPassword" type="password" @bind="_passwordResetModel.ConfirmPassword" class="form-control" />
            </div>

            <div class="centered">
                <ActionButton OnClick="DoResetPassword">@Loc["ResetPassword_SetPassword"]</ActionButton>
            </div>
        }
    }

    @if (_isLoading)
    {
        <div class="loading-indicator">@Loc["ResetPassword_Processing"]</div>
    }
    else if (_isSuccess)
    {
        <div class="success-message">@_successMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="error-message">@_errorMessage</div>
    }
</div>

<div><br /><br /><br /><NavLink href="/">@Loc["ResetPassword_ReturnHome"]</NavLink></div>

</div>

@code {
        public class PasswordResetModel
    {
        [Required(ErrorMessageResourceType = typeof(SharedStrings), ErrorMessageResourceName = "Validation_NewPasswordRequired")]
        [StringLength(1024, ErrorMessageResourceType = typeof(SharedStrings), ErrorMessageResourceName = "Validation_PasswordLength", MinimumLength = 8)]
        public string NewPassword { get; set; }

        [Required(ErrorMessageResourceType = typeof(SharedStrings), ErrorMessageResourceName = "Validation_ConfirmPasswordRequired")]
        [Compare("NewPassword", ErrorMessageResourceType = typeof(SharedStrings), ErrorMessageResourceName = "Validation_PasswordsDoNotMatch")]
        public string ConfirmPassword { get; set; }
    }

    private PasswordResetModel _passwordResetModel = new PasswordResetModel();
    private bool _isLoading = true;
    private bool _isSuccess = false;
    private string _errorMessage = string.Empty;
    private string _successMessage = string.Empty;
    private string _email = string.Empty;
    private bool _showEmailInput;

    [Parameter]
    [SupplyParameterFromQuery(Name = "verification_code")]
    public string? VerificationCode { get; set; }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // A code in the URL means the user came from a forgot-password email;
            // show the "pick a password" form. Without a code, show the
            // "enter your email to request a code" form.
            _isLoading = false;
            _showEmailInput = string.IsNullOrWhiteSpace(VerificationCode);
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task DoResetPassword()
    {
        _isLoading = true;
        _isSuccess = false;
        _errorMessage = string.Empty;
        StateHasChanged();

        var validationResults = new List<ValidationResult>();
        var isValid = Validator.TryValidateObject(
            _passwordResetModel,
            new ValidationContext(_passwordResetModel),
            validationResults,
            validateAllProperties: true);

        if (isValid)
        {
            try
            {
                if (!string.IsNullOrWhiteSpace(VerificationCode))
                {
                    var result = await WithTimeoutAsync(
                        SignalRClient.ResetPassword(VerificationCode, _passwordResetModel.NewPassword),
                        TimeSpan.FromSeconds(20));
                    if (result)
                    {
                        _isSuccess = true;
                        _successMessage = Loc["ResetPassword_Success"];
                        _passwordResetModel = new PasswordResetModel();
                    }
                    else
                    {
                        _showEmailInput = true;
                        _passwordResetModel = new PasswordResetModel();
                        _errorMessage = Loc["ResetPassword_UnknownError"];
                    }
                }
                else
                {
                    _showEmailInput = true;
                    _passwordResetModel = new PasswordResetModel();
                    _errorMessage = Loc["ResetPassword_MissingCode"];
                }
            }
            catch (TimeoutException)
            {
                _showEmailInput = true;
                _passwordResetModel = new PasswordResetModel();
                _errorMessage = Loc["ResetPassword_UnknownError"];
            }
            catch (Exception ex)
            {
                SignalRClient?.LogError(ex, "DoResetPassword()");
                _showEmailInput = true;
                _passwordResetModel = new PasswordResetModel();
                _errorMessage = $"{Loc["ResetPassword_ErrorOccurred"]} {ex.Message}, {Loc["ResetPassword_ReenterEmail"]}";
            }
        }
        else
        {
            _errorMessage = string.Join(" ", validationResults.Select(r => r.ErrorMessage));
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task RequestPasswordReset()
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var sent = await WithTimeoutAsync(
                SignalRClient.RequestPasswordReset(_email),
                TimeSpan.FromSeconds(20));

            if (sent)
            {
                // Indicate success
                _isSuccess = true;
                _successMessage = Loc["ResetPassword_SentEmail"];
            }
            else
            {
                _errorMessage = Loc["ResetPassword_UnknownError"];
            }

            _isLoading = false;
            //await Task.Delay(10000);
            //NavManager.NavigateTo("/");
        }
        catch (TimeoutException)
        {
            _errorMessage = Loc["ResetPassword_UnknownError"];
            _isLoading = false;
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "RequestPasswordReset()");
            _errorMessage = $"{Loc["ResetPassword_ErrorOccurred"]} {ex.Message}";
            _isLoading = false;
        }
        StateHasChanged();
    }

    private static async Task<T> WithTimeoutAsync<T>(Task<T> task, TimeSpan timeout)
    {
        if (await Task.WhenAny(task, Task.Delay(timeout)) != task)
        {
            throw new TimeoutException();
        }

        return await task;
    }
}
