@page "/Messages/{userId:int?}"
@inject ICompanioNationSignalRClient? SignalRClient
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<Messages> Loc



<div class="messages-layout">

    <!-- Hamburger button to open sidebar when it's collapsed -->
    <button class="expand-button" @onclick="ToggleSidebar" title="@Loc["Messages_OpenSidebar"]" aria-label="@Loc["Messages_ToggleSidebar"]">☰</button>

    <!-- Collapsible Sidebar for Users -->
    <div class="sidebar @sidebarClass">
        <h4>@Loc["Messages_Conversations"]</h4>

        @if (_isLoadingUsers)
        {
            <!-- Loading indicator for user list -->
            <div class="loading-indicator">
                <p>@Loc["Messages_LoadingConversations"]</p>
                <div class="spinner"></div> <!-- CSS-based spinner -->
            </div>
        }
        else if (_conversationsLoadFailed && !_conversations.Any())
        {
            <div class="load-error">
                <p>@Loc["Messages_ConversationsLoadError"]</p>
                <button class="retry-btn" @onclick="RetryLoadConversations">@Loc["Messages_Retry"]</button>
            </div>
        }
        else if (_conversations != null && _conversations.Any())
        {
            <div class="user-list">
                @foreach (var user in _conversations.OrderByDescending(u => u.NewestMessage))
                {
                    if (user.IgnoredByMe == false && user.IsIgnored == false) 
                    {
                        <div @onclick="() => LoadConversation(user.UserId)" class="user-item">
                            <img src="@Util.GetPhotoUrl(user.Photos != null && user.Photos.Any() ? user.Photos[0] : Guid.Empty)" alt="@Loc["Messages_AltThumbnail"]" class="thumbnail" />
                            <strong>@user.Name</strong>
                            <span class="message-count">@(user.UnreadMessageCount > 0 ? $"({user.UnreadMessageCount})" : "")</span>
                        </div>
                    }
                }
            </div>


            <!-- Ignored Conversations Section -->
            <button class="toggle-ignored-button" @onclick="ToggleIgnoredConversations">
                @if (_showIgnoredConversations)
                {
                    <span>@Loc["Messages_IgnoredConversations"] (@_conversations.Where(u => u.IgnoredByMe).Sum(u => u.UnreadMessageCount)) ▲</span>
                }
                else
                {
                    <span>@Loc["Messages_IgnoredConversations"] (@_conversations.Where(u => u.IgnoredByMe).Sum(u => u.UnreadMessageCount)) ▼</span>
                }
            </button>

            @if (_showIgnoredConversations)
            {
                <div class="ignored-user-list">
                    @foreach (var user in _conversations.OrderByDescending(u => u.NewestMessage))
                    {
                        if (user.IgnoredByMe)
                        {
                            <div @onclick="() => LoadConversation(user.UserId)" class="user-item ignored">
                                <img src="@Util.GetPhotoUrl(user.Photos != null && user.Photos.Any() ? user.Photos[0] : Guid.Empty)" alt="@Loc["Messages_AltThumbnail"]" class="thumbnail" />
                                <strong>@user.Name</strong>
                                <span class="message-count">@(user.UnreadMessageCount > 0 ? $"({user.UnreadMessageCount})" : "")</span>
                            </div>
                        }
                    }
                </div>
            }

            <!-- Other User Ignored Me Section -->
            <button class="toggle-other-user-ignored-button" @onclick="ToggleOtherUserIgnoredConversations">
                @if (_showOtherUserIgnoredConversations)
                {
                    <span>@Loc["Messages_YouWereIgnored"] (@_conversations.Where(u => u.IsIgnored && !u.IgnoredByMe).Sum(u => u.UnreadMessageCount)) ▲</span>
                }
                else
                {
                    <span>@Loc["Messages_YouWereIgnored"] (@_conversations.Where(u => u.IsIgnored && !u.IgnoredByMe).Sum(u => u.UnreadMessageCount)) ▼</span>
                }
            </button>

            @if (_showOtherUserIgnoredConversations)
            {
                <div class="other-user-ignored-list">
                    @foreach (var user in _conversations.OrderByDescending(u => u.NewestMessage))
                    {
                        if (user.IsIgnored && !user.IgnoredByMe)
                        {
                            <div @onclick="() => LoadConversation(user.UserId)" class="user-item other-ignored">
                                <img src="@Util.GetPhotoUrl(user.Photos != null && user.Photos.Any() ? user.Photos[0] : Guid.Empty)" alt="@Loc["Messages_AltThumbnail"]" class="thumbnail" />
                                <strong>@user.Name</strong>
                                <span class="message-count">@(user.UnreadMessageCount > 0 ? $"({user.UnreadMessageCount})" : "")</span>
                            </div>
                        }
                    }
                </div>
            }
        }
        else
        {
            <p>@Loc["Messages_NoConversations"]</p>
        }
    </div>


    <!-- Message thread for the selected user -->
    <div class="message-thread @messageThreadClass">
        @if (_isLoadingMessages)
        {
            <!-- Show loading spinner for messages -->
            <div class="loading-indicator">
                <p>@Loc["Messages_LoadingMessages"]</p>
                <div class="spinner"></div>
            </div>
        }
        else if (_selectedUser != null)
        {
            <div class="heading" @onclick="HandleClickOutsideSidebar">
                <h4>@(_selectedUser.Name ?? Loc["Messages_Loading"])</h4>

                <div class="ignore">
                    @if (_selectedUser.IgnoredByMe)
                    {
                        <ActionButton OnClick="UnIgnoreUser" Color="#81c784">@Loc["Messages_UnIgnore"]</ActionButton>
                    }
                    else
                    {
                        <ActionButton OnClick="IgnoreUser" Color="#e57373">@Loc["Messages_Ignore"]</ActionButton>
                    }
                    <ReportButton ReportedUserId="_selectedUser.UserId" ReportType="ReportTypes.Message" SignalRClient="SignalRClient" />
                </div>
            </div>

            <!-- Scrollable user photos at the top -->
            <div class="user-photos-container" @onclick="HandleClickOutsideSidebar">
                <div class="photos-scroller">
                    <div class="profile-preview-slot" @onclick="ToggleProfilePopup" @onclick:stopPropagation="true" title="@Loc["Messages_ViewProfile"]">
                        <span class="profile-preview-age-gender">@GetAgeGenderLabel()</span>
                        @if (!string.IsNullOrEmpty(_selectedUser.Location?.CityName))
                        {
                            <span class="profile-preview-city">@_selectedUser.Location.CityName</span>
                        }
                    </div>
                    @if (_selectedUser.Photos != null)
                    {
                        @foreach (var photo in _selectedUser.Photos)
                        {
                            <ThumbnailComponent ImageUrl="@Util.GetPhotoUrl(photo)" />
                        }
                    }
                </div>
            </div>

            @if (_showProfilePopup)
            {
                <div class="profile-popup-overlay" @onclick="ToggleProfilePopup">
                    <div class="profile-popup-card" @onclick:stopPropagation="true">
                        <button class="profile-popup-close" @onclick="ToggleProfilePopup" aria-label="@Loc["Messages_CloseProfile"]">&times;</button>
                        <div class="profile-popup-header">
                            <img src="@Util.GetPhotoUrl(_selectedUser.Photos != null && _selectedUser.Photos.Any() ? _selectedUser.Photos[0] : Guid.Empty)" alt="@_selectedUser.Name" class="profile-popup-photo" />
                            <div class="profile-popup-name-line">
                                <h3>@_selectedUser.Name</h3>
                                <span class="profile-popup-age-gender">@GetAgeGenderLabel()</span>
                            </div>
                            @if (_selectedUser.Location != null)
                            {
                                <span class="profile-popup-location">@FormatLocation()</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_selectedUser.Description))
                        {
                            <div class="profile-popup-section">
                                <h4>@Loc["Messages_About"]</h4>
                                <p>@_selectedUser.Description</p>
                            </div>
                        }
                        @if (_selectedUserBadges.Count > 0)
                        {
                            <div class="profile-popup-section">
                                <h4>@Loc["Messages_Badges"]</h4>
                                <div class="profile-popup-badges">
                                    @foreach (var badge in _selectedUserBadges)
                                    {
                                        <span class="profile-popup-badge" title="@badge.Description">
                                            <span>@badge.Icon</span> @badge.Name
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                        @if (_selectedUser.Reviews != null && _selectedUser.Reviews.Any())
                        {
                            <div class="profile-popup-section">
                                <h4>@Loc["Messages_Reviews"]</h4>
                                @foreach (var review in _selectedUser.Reviews)
                                {
                                    <div class="profile-popup-review">
                                        <p>@review.Text</p>
                                        <span class="profile-popup-review-date">@review.Date.ToLocalTime().ToString("d")</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="messages-container" @ref="messagesContainer" @onclick="HandleClickOutsideSidebar">
                @if (_selectedMessages != null && _selectedMessages.Any())
                {
                    @foreach (var message in _selectedMessages)
                    {
                        bool isSentByCurrentUser = message.FromUserId == SignalRClient.CurrentUser?.UserId;
                        bool isCompanionitaMessage = message.IsCompanioNitaAdvice;

                        <div class="message-row @(isSentByCurrentUser ? "sent" : "received") @(isCompanionitaMessage ? "companionita-message" : "")">
                            @if (!isSentByCurrentUser && !isCompanionitaMessage)
                            {
                                <!-- Receiver's thumbnail on the left -->
                                <img src="@Util.GetPhotoUrl(_selectedUser.Photos != null && _selectedUser.Photos.Any() ? _selectedUser.Photos[0] : Guid.Empty)" alt="@Loc["Messages_AltUserThumbnail"]" class="message-thumbnail" />
                            }

                            <div class="message-wrapper">
                                <div class="message-bubble">
                                    @if (isCompanionitaMessage)
                                    {
                                        <img src="/images/CompanioNita.png" alt="@Loc["Messages_AltCompanionitaLogo"]" class="companionita-logo" />
                                        <ShadowDomElement Html="@message.MessageText"></ShadowDomElement>
                                    }
                                    else
                                    {
                                        <p>@(message.MessageText)</p>
                                    }
                                    <span class="message-date">@message.DateCreated.ToLocalTime().ToString("g")</span>
                                </div>
                            </div>

                            @if (isSentByCurrentUser && !isCompanionitaMessage)
                            {
                                <!-- Sender's thumbnail on the right -->
                                <img src="@Util.GetPhotoUrl(SignalRClient.CurrentUser.Thumbnail)" alt="@Loc["Messages_AltUserThumbnail"]" class="message-thumbnail" />
                            }
                        </div>

                    }
                }
                else if (_messagesLoadFailed)
                {
                    <div class="load-error">
                        <p>@Loc["Messages_MessagesLoadError"]</p>
                        <button class="retry-btn" @onclick="() => LoadConversation(_selectedUser.UserId)">@Loc["Messages_Retry"]</button>
                    </div>
                }
                else
                {
                    <p>@Loc["Messages_NoMessages"]</p>
                }

                @if (HasInsightBubbleForCurrentConversation)
                {
                    <div class="message-row received companionita-message">
                        <div class="message-wrapper">
                            <div class="message-bubble">
                                <img src="/images/CompanioNita.png" alt="@Loc["Messages_AltCompanionitaLogo"]" class="companionita-logo" />
                                @if (string.IsNullOrEmpty(_companionitaStreamText))
                                {
                                    @if (!string.IsNullOrWhiteSpace(_companionitaReasoning))
                                    {
                                        <span class="companionita-thinking">@_companionitaReasoning</span>
                                    }
                                    else
                                    {
                                        <span class="companionita-thinking">@Loc["Messages_CompanionitaThinking"]</span>
                                    }
                                }
                                else
                                {
                                    <ShadowDomElement Html="@_companionitaStreamText"></ShadowDomElement>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- CompanioNita insight prompt (hidden until the other participant has
                 sent enough messages for a fresh insight) -->
            @if (IsCurrentConversationStreamingInsight || CanAskCompanioNitaInsight)
            {
                <div class="companionita-insight-bar" @onclick="HandleClickOutsideSidebar">
                    @if (IsCurrentConversationStreamingInsight)
                    {
                        <span class="insight-spinner"></span>
                        <span class="companionita-thinking">@(string.IsNullOrWhiteSpace(_companionitaReasoning) ? Loc["Messages_CompanionitaThinking"] : _companionitaReasoning)</span>
                    }
                    else
                    {
                        <button class="companionita-insight-btn" @onclick="AskCompanioNitaInsight">
                            <img src="/images/CompanioNita.png" alt="@Loc["Messages_AltCompanioNita"]" class="companionita-insight-icon" />
                            <span>@Loc["Messages_CompanionitaInsight"]</span>
                        </button>
                    }
                </div>
            }

            <!-- Send a new message -->
            <div class="new-message" @onclick="HandleClickOutsideSidebar">
                @if (_sendFailed)
                {
                    <div class="send-error">@Loc["Messages_SendFailed"]</div>
                }
                <div class="compose-bar @(_isSending ? "sending" : "")">
                    <textarea @ref="_messageTextarea" @bind="_newMessageText" @bind:event="oninput" placeholder="@Loc["Messages_TypeMessage"]" @onkeydown="HandleKeyPress" @onkeydown:preventDefault="@_enterPressed" rows="1" disabled="@_isSending"></textarea>
                    <button class="send-btn" @onclick="SendMessage" title="@Loc["Messages_SendTitle"]" aria-label="@Loc["Messages_SendAriaLabel"]" disabled="@_isSending">
                        @if (_isSending)
                        {
                            <span class="send-spinner"></span>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="white"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
                        }
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="no-conversation-selected">
                <h4>@Loc["Messages_SelectConversation"]</h4>
                <Information Content="@(new MarkupString(Loc["Messages_Information"].Value))" />
            </div>
        }
    </div>
</div>


@code {
    [Parameter]
    public int? userId { get; set; }
    [CascadingParameter] public MainLayout MainLayoutInstance { get; set; }

    private List<UserConversation> _conversations = new List<UserConversation>();
    private List<UserMessage> _selectedMessages = new List<UserMessage>();
    private UserConversation _selectedUser = null;
    private string _newMessageText = string.Empty;
    private bool _isSidebarCollapsed = false;
    private bool _isLoadingUsers = true; // New state for loading user list
    private bool _isLoadingMessages = false; // New state for loading messages
    private bool _conversationsLoadFailed = false; // True when conversation list fetch failed (timeout/error)
    private bool _messagesLoadFailed = false; // True when message fetch failed (timeout/error)
    private bool _sendFailed = false; // True when the last send attempt failed
    private bool _isSending = false; // True while a message send is in flight
    private bool _showIgnoredConversations = false; // Toggle for showing ignored conversations
    private bool _showOtherUserIgnoredConversations = false; // Toggle for showing conversations where the other user ignored you
    private bool _showProfilePopup = false;
    private List<EventBadge> _selectedUserBadges = new();
    private bool _enterPressed = false; // Tracks whether Enter should be suppressed
    private bool _isAskingCompanionita = false; // True while CompanioNita is reading the conversation
    private int? _insightStreamUserId = null; // The conversation the active insight stream belongs to
    private string _companionitaStreamText = ""; // Live streamed insight text
    private string _companionitaReasoning = ""; // Live streamed reasoning (thinking) text

    private bool IsCurrentConversationStreamingInsight =>
        _isAskingCompanionita && _selectedUser != null && _insightStreamUserId == _selectedUser.UserId;

    private bool HasInsightBubbleForCurrentConversation =>
        _selectedUser != null && _insightStreamUserId == _selectedUser.UserId &&
        (_isAskingCompanionita || !string.IsNullOrEmpty(_companionitaStreamText));

    // CompanioNita is only offered once the OTHER participant has sent enough
    // messages since her last advice (or since the start of the conversation).
    // The prompt is hidden otherwise, so the user never sees an action that is
    // advertised but then refused.
    private int MessagesFromOtherSinceLastInsight
    {
        get
        {
            int currentUserId = SignalRClient.CurrentUser?.UserId ?? 0;
            int startIndex = _selectedMessages.FindLastIndex(m => m.IsCompanioNitaAdvice) + 1;
            int count = 0;
            for (int i = startIndex; i < _selectedMessages.Count; i++)
            {
                UserMessage message = _selectedMessages[i];
                if (!message.IsCompanioNitaAdvice && message.FromUserId != currentUserId)
                    count++;
            }
            return count;
        }
    }

    private bool CanAskCompanioNitaInsight =>
        _selectedUser != null &&
        !_isAskingCompanionita &&
        MessagesFromOtherSinceLastInsight >= Util.CompanioNitaRequiredNewMessagesAfterAdvice;

    private string sidebarClass => _isSidebarCollapsed ? "collapsed" : "";
    private string messageThreadClass => _isSidebarCollapsed ? "expanded" : "";

    // Reference to the messages container for scrolling
    private ElementReference messagesContainer;
    private ElementReference _messageTextarea;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            MainLayoutInstance.OnMessageReceived += MessageReceived;

            _isLoadingUsers = true; // Start loading users
            await GetConversationList();
            _isLoadingUsers = false; // Stop loading after fetching users

            StateHasChanged();

            if (userId.HasValue)
            {
                await LoadConversation(userId.Value);
            }
        }
    }

    private async Task GetConversationList() 
    {
        _conversationsLoadFailed = false;
        List<UserConversation> result = await SignalRClient.GetUserConversationsAsync();
        if (result != null) {
            _conversations = result;
        } else {
            _conversationsLoadFailed = true;
        }
        await SetMessageCount();
    }

    private async Task RetryLoadConversations()
    {
        _isLoadingUsers = true;
        StateHasChanged();
        await GetConversationList();
        _isLoadingUsers = false;
        StateHasChanged();
    }

    private async Task SetMessageCount()
    {
        if (_conversations == null) return;

        // Set the message count badge to the current correct number
        int count = _conversations.Where(u => !(u.IsIgnored || u.IgnoredByMe)).Sum(u => u.UnreadMessageCount);
        await SignalRClient.SetMessageCount(count);
    }

    //  A new message was received as indicated by a push notification, message is from userId
    private async void MessageReceived(int userId)
    {
        // Update the message counts in the conversation list
        await GetConversationList();

        if (_selectedUser != null && _selectedUser.UserId == userId)
        {
            // Update the messages pane to show the new message(s)
            await LoadConversation(_selectedUser.UserId);
        }
    }
    private async Task LoadConversation(int userId)
    {
        _isSidebarCollapsed = true;
        _isLoadingMessages = true; // Start loading messages
        _showProfilePopup = false;

        _selectedUser = _conversations.FirstOrDefault(c => c.UserId == userId);

        if (_selectedUser == null)
        {
            var userDetails = await SignalRClient.StartUserConversationAsync(userId);
            if (userDetails != null)
            {
                if (_conversations.Count == 0)
                {
                    userDetails.NewestMessage = 1;
                }
                else
                {
                    userDetails.NewestMessage = _conversations.Max(id => id.NewestMessage) + 1; // Set this so it appears at the top
                }
                _conversations.Add(userDetails);
                _selectedUser = userDetails;
                _selectedMessages = new List<UserMessage>();
            }

        } 
        else if (_selectedUser != null)
        {
            _messagesLoadFailed = false;
            var messages = await SignalRClient.GetMessagesWithUserAsync(userId);
            if (messages != null)
            {
                _selectedMessages = messages;
            }
            else
            {
                _messagesLoadFailed = true;
            }
        }

        // Mark all the messages as read
        if (_selectedUser != null) 
        {
            _selectedUser.UnreadMessageCount = 0;
            await SetMessageCount();
            await LoadSelectedUserBadges();
        }
        _isLoadingMessages = false; // Stop loading after fetching messages
        StateHasChanged();

        // Scroll to bottom after loading messages
        await ScrollToBottom();
    }

    private async Task LoadSelectedUserBadges()
    {
        if (_selectedUser == null)
        {
            _selectedUserBadges = new List<EventBadge>();
            return;
        }

        try
        {
            var result = await SignalRClient.GetUserBadgesAsync(_selectedUser.UserId);
            _selectedUserBadges = result.IsSuccess && result.Data != null
                ? result.Data
                : new List<EventBadge>();
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Messages.LoadBadges");
            _selectedUserBadges = new List<EventBadge>();
        }
    }


    private async Task IgnoreUser()
    {
        _selectedUser.IgnoredByMe = true;
        await SignalRClient.AddIgnore(_selectedUser.UserId);
    }
    private async Task UnIgnoreUser()
    {
        _selectedUser.IgnoredByMe = false;
        await SignalRClient.RemoveIgnore(_selectedUser.UserId);
    }

    private void ToggleIgnoredConversations()
    {
        _showIgnoredConversations = !_showIgnoredConversations;
    }

    private void ToggleOtherUserIgnoredConversations()
    {
        _showOtherUserIgnoredConversations = !_showOtherUserIgnoredConversations;
    }

    private async Task SendMessage()
    {
        if (_isSending || string.IsNullOrWhiteSpace(_newMessageText) || _selectedUser == null)
            return;

        _isSending = true;
        _sendFailed = false;

        // Capture and clear text immediately so the user sees responsiveness
        string messageText = _newMessageText.Trim();
        _newMessageText = string.Empty;

        // Optimistic UI: show the message in the thread right away
        var optimisticMessage = new UserMessage
        {
            FromUserId = SignalRClient.CurrentUser.UserId,
            ToUserId = _selectedUser.UserId,
            MessageText = messageText,
            DateCreated = DateTime.UtcNow,
        };
        _selectedMessages.Add(optimisticMessage);
        StateHasChanged();
        await ScrollToBottom();

        int id = await SignalRClient.SendMessageAsync(_selectedUser.UserId, messageText);
        if (id != 0)
        {
            bool wasFirstMessage = _selectedMessages.Count <= 1;
            _selectedUser.NewestMessage = id;
            try
            {
                await JSRuntime.InvokeVoidAsync("gaEvent", "message_sent",
                    new { conversation_id = _selectedUser.UserId, is_first_message = wasFirstMessage });
            }
            catch (Exception gaEx)
            {
                Console.WriteLine($"[Analytics] Failed to emit 'message_sent': {gaEx.Message}");
            }
        }
        else
        {
            // Roll back the optimistic message and restore the text
            _selectedMessages.Remove(optimisticMessage);
            _newMessageText = messageText;
            _sendFailed = true;
        }

        _isSending = false;
        StateHasChanged();

        // Re-focus the textarea so the user can immediately type the next message.
        // Only attempt this when the compose box is actually rendered: a concurrent
        // incoming message (MessageReceived -> LoadConversation) can set
        // _isLoadingMessages and briefly remove the textarea from the DOM, which would
        // otherwise make FocusAsync throw "Unable to focus an invalid element".
        if (_selectedUser != null && !_isLoadingMessages)
        {
            try
            {
                await _messageTextarea.FocusAsync();
            }
            catch (Microsoft.JSInterop.JSException)
            {
                // Focusing is a best-effort convenience; never let it break the send flow.
            }
        }
    }

    private async Task AskCompanioNitaInsight()
    {
        if (_selectedUser == null || !CanAskCompanioNitaInsight)
            return;

        int targetUserId = _selectedUser.UserId;
        _isAskingCompanionita = true;
        _insightStreamUserId = targetUserId;
        _companionitaStreamText = "";
        _companionitaReasoning = "";
        StateHasChanged();
        await ScrollToBottom();

        string response = await SignalRClient.StreamAskCompanioNitaAboutConversationAsync(targetUserId, (accumulated) =>
        {
            _companionitaStreamText = accumulated;
            if (_selectedUser?.UserId == targetUserId)
            {
                StateHasChanged();
            }
        }, (reasoning) =>
        {
            _companionitaReasoning = reasoning;
            if (_selectedUser?.UserId == targetUserId)
            {
                StateHasChanged();
            }
        });

        bool stillViewingTarget = _selectedUser?.UserId == targetUserId;
        _isAskingCompanionita = false;
        _companionitaReasoning = "";

        if (response.StartsWith("\u26A0", StringComparison.Ordinal) || response.StartsWith("ERROR", StringComparison.Ordinal))
        {
            if (stillViewingTarget)
            {
                // Surface subscription/limit/error reasons in the insight bubble without
                // re-syncing, because the server may not have persisted anything for this turn.
                _companionitaStreamText = CleanInsightErrorText(response);
            }
            else
            {
                _companionitaStreamText = "";
                _insightStreamUserId = null;
            }
        }
        else if (!string.IsNullOrWhiteSpace(response))
        {
            if (stillViewingTarget)
            {
                // The server persisted the completed insight; reload so the thread matches
                // what was saved (and the live stream bubble is replaced by the real message).
                await LoadConversation(targetUserId);
            }
            _companionitaStreamText = "";
            _insightStreamUserId = null;
        }
        else
        {
            _companionitaStreamText = "";
            _insightStreamUserId = null;
        }

        StateHasChanged();
        if (stillViewingTarget)
        {
            await ScrollToBottom();
        }
    }

    private static string CleanInsightErrorText(string text)
    {
        string t = text.Trim();
        if (t.StartsWith("\u26A0", StringComparison.Ordinal))
            t = t[2..].Trim();
        if (t.StartsWith("ERROR:", StringComparison.OrdinalIgnoreCase))
            t = t["ERROR:".Length..].Trim();
        return t;
    }

    private void HandleClickOutsideSidebar()
    {
        if (!_isSidebarCollapsed)
        {
            ToggleSidebar();
        }
    }

    private void ToggleProfilePopup()
    {
        _showProfilePopup = !_showProfilePopup;

        if (_showProfilePopup && _selectedUser != null)
        {
            _ = EmitCompanionViewed(_selectedUser.UserId);
        }
    }

    private async Task EmitCompanionViewed(int companionId)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("gaEvent", "companion_viewed", new { companion_id = companionId });
        }
        catch (Exception gaEx)
        {
            Console.WriteLine($"[Analytics] Failed to emit 'companion_viewed': {gaEx.Message}");
        }
    }

    private string GetAgeGenderLabel()
    {
        var parts = new List<string>();
        if (_selectedUser.Birthday.HasValue)
            parts.Add(Util.CalculateAge(_selectedUser.Birthday.Value).ToString());
        parts.Add(Util.GetGenderShortString(_selectedUser.Gender));
        return string.Join("/", parts);
    }

    private string FormatLocation()
    {
        var loc = _selectedUser.Location;
        if (loc == null) return "";
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(loc.CityName)) parts.Add(loc.CityName);
        if (!string.IsNullOrEmpty(loc.CountryName)) parts.Add(loc.CountryName);
        return string.Join(", ", parts);
    }
    private void ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    // Method to scroll to the bottom of the messages container
    private async Task ScrollToBottom()
    {
        await JSRuntime.InvokeVoidAsync("scrollToBottom", messagesContainer);
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _enterPressed = true;
            await SendMessage();
        }
        else
        {
            _enterPressed = false;
        }
    }
}

<script>
    window.scrollToBottom = function (element) {
        // do a double requestAnimationFrame call to make sure the shadow DOM has settled after rendering the CompanioNita messages
        setTimeout(() => {
            if (element) {
                element.scrollTop = element.scrollHeight;
            }
        }, 7);
    };
</script>

