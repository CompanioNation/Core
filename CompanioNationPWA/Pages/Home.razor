@page "/"
@inject IJSRuntime JSRuntime
@inject ICompanioNationSignalRClient? SignalRClient
@inject IStringLocalizer<Home> Loc
@implements IDisposable
@using CompanioNation.Shared


<Information Content="@(new MarkupString(Loc["Home_Information"].Value))" />

<div class="home-layout">
    <CompanioNationLogo />

    <br /><br />

    <SupportCard />

    <br /><br />

    <AdviceOfTheDay />

    <br /><br />

    <div class="chat-layout">
        <div class="chat-sidebar">
            <button class="new-conversation-btn" @onclick="StartNewThread" disabled="@_isStreaming">@Loc["Home_NewConversation"]</button>

            @if (_threads is null)
            {
                <p class="chat-sidebar-empty">@Loc["Home_LoadingConversations"]</p>
            }
            else if (_threads.Count == 0)
            {
                <p class="chat-sidebar-empty">@Loc["Home_NoConversations"]</p>
            }
            else
            {
                @foreach (var thread in _threads)
                {
                    <button class="conversation-item @(thread.ThreadId == _activeThreadId ? "selected" : "")"
                            @onclick="() => SelectThread(thread.ThreadId)">
                        <span class="conversation-title">@(string.IsNullOrWhiteSpace(thread.Title) ? Loc["Home_UntitledConversation"] : thread.Title)</span>
                        <span class="conversation-meta">@thread.ExchangeCount @Loc["Home_MessagesSuffix"] · @thread.LastUpdated.ToLocalTime().ToString("g")</span>
                    </button>
                }
            }
        </div>

        <div class="chat-main">
            @if (_isLoadingExchanges)
            {
                <div class="chat-empty">@Loc["Home_LoadingMessages"]</div>
            }
            else if (_activeThreadId == 0 || _exchanges.Count == 0)
            {
                <div class="chat-empty">
                    <h3>@Loc["Home_CompanioNitaPrompt"]</h3>
                    <p>@Loc["Home_EmptyConversation"]</p>
                </div>
            }
            else
            {
                <div class="chat-thread" id="chatThread">
                    @foreach (var exchange in _exchanges)
                    {
                        <div class="chat-row user">
                            <div class="chat-bubble user-bubble">@exchange.Prompt</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(exchange.Response))
                        {
                            <div class="chat-row assistant">
                                <div class="chat-bubble assistant-bubble">
                                    <img src="/images/CompanioNita.png" alt="" width="512" height="512" class="chat-companionita-logo" />
                                    <ShadowDomElement Html="@exchange.Response" Compact="true"></ShadowDomElement>
                                </div>
                            </div>
                        }
                    }

                    @if (_isStreaming || !string.IsNullOrEmpty(_streamingText))
                    {
                        <div class="chat-row assistant">
                            <div class="chat-bubble assistant-bubble">
                                @if (!string.IsNullOrEmpty(_streamingText))
                                {
                                    <img src="/images/CompanioNita.png" alt="" width="512" height="512" class="chat-companionita-logo" />
                                    <ShadowDomElement Html="@_streamingText" Compact="true"></ShadowDomElement>
                                }
                                else
                                {
                                    <span class="chat-thinking">@Loc["Home_Asking"]</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="chat-composer">
                <textarea id="gptMessage" value="@_pendingMessage" @oninput="HandleComposerInput" rows="2" maxlength="2000"
                          placeholder="@Loc["Home_AskPlaceholder"]" @onkeydown="HandleComposerKeydown"></textarea>
                <button class="send-btn" @onclick="SendMessage"
                        disabled="@(_isStreaming || string.IsNullOrWhiteSpace(_pendingMessage))">
                    @Loc["Home_AskButton"]
                </button>
            </div>
        </div>
    </div>
</div>


@code {
    [CascadingParameter] public MainLayout MainLayoutInstance { get; set; }

    private List<AdviceThread>? _threads;
    private List<AdviceExchange> _exchanges = new List<AdviceExchange>();
    private int _activeThreadId;
    private string _pendingMessage = "";
    private string _streamingText = "";
    private bool _isStreaming;
    private bool _isLoadingExchanges;

    protected override async Task OnInitializedAsync()
    {
        // Refresh the sidebar once the subscribe popup closes so a now-subscribed
        // user's thread list is current.
        if (MainLayoutInstance is not null)
        {
            MainLayoutInstance.OnSubscribeClosed += HandleSubscribeClosed;
        }
    }

    private async void HandleSubscribeClosed()
    {
        try
        {
            if (SignalRClient is not null)
            {
                _threads = await SignalRClient.GetAdviceThreadsAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Home.HandleSubscribeClosed");
        }
    }

    public void Dispose()
    {
        if (MainLayoutInstance is not null)
        {
            MainLayoutInstance.OnSubscribeClosed -= HandleSubscribeClosed;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // During SSR prerendering (crawlers / JS-disabled) the chat cannot connect,
        // so it stays on the empty state — the visible AdviceOfTheDay still renders.
        if (firstRender && SignalRClient is not null && !SignalRClient.IsPrerendering)
        {
            await LoadInitialThreadAsync();
        }

        // Normalize the composer to a single line on first render (rows="2" is only
        // a prerender fallback; JS grows it from the actual content height).
        if (firstRender)
        {
            await AutoResizeComposerAsync();
        }
    }

    private async Task LoadInitialThreadAsync()
    {
        _threads = await SignalRClient.GetAdviceThreadsAsync();

        // Resume the last active thread across refreshes; otherwise start a new one.
        int saved = await SignalRClient.GetActiveThreadIdAsync();
        if (saved != 0 && _threads.Any(t => t.ThreadId == saved))
        {
            await SelectThread(saved);
        }
        else
        {
            await StartNewThread();
        }
    }

    private async Task StartNewThread()
    {
        if (SignalRClient is null || _isStreaming)
            return;

        int id = await SignalRClient.StartAdviceThreadAsync();
        if (id == 0)
            return;

        _activeThreadId = id;
        _exchanges = new List<AdviceExchange>();
        _streamingText = "";
        _isLoadingExchanges = false;

        await SignalRClient.SaveActiveThreadIdAsync(id);
        _threads = await SignalRClient.GetAdviceThreadsAsync();
        StateHasChanged();
    }

    private async Task SelectThread(int threadId)
    {
        if (_isStreaming || SignalRClient is null)
            return;

        _activeThreadId = threadId;
        _isLoadingExchanges = true;
        StateHasChanged();

        await SignalRClient.SaveActiveThreadIdAsync(threadId);
        _exchanges = await SignalRClient.GetAdviceExchangesAsync(threadId);
        _isLoadingExchanges = false;
        StateHasChanged();
        await ScrollThreadToBottomAsync();
    }

    private async Task SendMessage()
    {
        string question = _pendingMessage?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(question) || _isStreaming || _activeThreadId == 0 || SignalRClient is null)
            return;

        _pendingMessage = "";

        // Optimistically show the user's question (its response is null until the stream finishes).
        _exchanges.Add(new AdviceExchange { ExchangeId = 0, Prompt = question, Response = null, DateCreated = DateTime.UtcNow });
        _isStreaming = true;
        _streamingText = "";
        StateHasChanged();
        await ScrollThreadToBottomAsync();

        string response = await SignalRClient.StreamAskCompanioNitaAsync(_activeThreadId, question, (accumulated) =>
        {
            _streamingText = accumulated;
            StateHasChanged();
        });

        _isStreaming = false;

        if (response.StartsWith("⚠️", StringComparison.Ordinal) || response.StartsWith("ERROR", StringComparison.Ordinal))
        {
            // Surface subscription/limit/error reasons in the assistant bubble without
            // re-syncing, because the server may not have persisted anything for this turn.
            _streamingText = CleanErrorText(response);
        }
        else
        {
            // Re-sync from the database so the local view matches what is persisted
            // (server-side saving happens for the streaming path), then clear the
            // streaming bubble and refresh the sidebar's title/count/recency.
            _exchanges = await SignalRClient.GetAdviceExchangesAsync(_activeThreadId);
            _streamingText = "";
        }

        _threads = await SignalRClient.GetAdviceThreadsAsync();
        // Clear any newline the browser's default Enter action may have inserted into
        // the composer while the stream was in flight.
        _pendingMessage = "";
        StateHasChanged();
        await AutoResizeComposerAsync();
        await ScrollThreadToBottomAsync();
    }

    private static string CleanErrorText(string text)
    {
        string t = text.Trim();
        if (t.StartsWith("⚠️", StringComparison.Ordinal))
            t = t[2..].Trim();
        if (t.StartsWith("ERROR:", StringComparison.OrdinalIgnoreCase))
            t = t["ERROR:".Length..].Trim();
        return t;
    }

    private async Task HandleComposerKeydown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // Enter sends (Shift+Enter inserts a newline). _pendingMessage is cleared in
        // SendMessage, and any default newline the browser inserts is cleared again after
        // the stream completes.
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task HandleComposerInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _pendingMessage = e.Value?.ToString() ?? string.Empty;
        await AutoResizeComposerAsync();
    }

    // Grows the composer textarea to fit its content (capped by the CSS max-height),
    // matching the Google Messages behavior of expanding vertically as you type.
    private async Task AutoResizeComposerAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("cnAutoResizeTextArea", "gptMessage");
        }
        catch
        {
            // Best-effort resize; never let it break the chat flow.
        }
    }

    private async Task ScrollThreadToBottomAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "document.getElementById('chatThread')?.scrollTo(0, document.getElementById('chatThread').scrollHeight);");
        }
        catch
        {
            // Best-effort scroll; never let it break the chat flow.
        }
    }
}
