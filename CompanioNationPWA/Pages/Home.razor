@page "/"
@inject IJSRuntime JSRuntime
@inject CompanioNationSignalRClient? SignalRClient
@inject IStringLocalizer<Home> Loc
@implements IDisposable
@using System.Text.RegularExpressions


@code {
    [CascadingParameter] public MainLayout MainLayoutInstance { get; set; }

    private string companioNitaResponse = "";

    private string gptMessage;
    private bool _askingGPT = false;
    private string gptResponseShareText = "";


    private List<Advice> pastAdvice = new List<Advice>();
    private bool showPastAdvice = false; // To control expand/collapse state

    protected override async Task OnInitializedAsync()
    {
        // Refresh any stale subscription notice once the subscribe popup closes so a
        // now-subscribed user stops seeing "Your CompanioNita subscription has expired."
        if (MainLayoutInstance is not null)
        {
            MainLayoutInstance.OnSubscribeClosed += HandleSubscribeClosed;
        }
    }

    private void HandleSubscribeClosed()
    {
        // The subscribe popup just closed. If the last CompanioNita response was a
        // subscription notice (⚠️ prefix set by StreamAskCompanioNitaAsync), clear it so the
        // stale "expired/required" message disappears. A now-subscribed user can simply ask
        // again to get fresh advice.
        if (companioNitaResponse.StartsWith("\u26A0", StringComparison.Ordinal))
        {
            companioNitaResponse = "";
            gptResponseShareText = "";
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        if (MainLayoutInstance is not null)
        {
            MainLayoutInstance.OnSubscribeClosed -= HandleSubscribeClosed;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
        }
    }



    public async Task AskCompanioNita()
    {
        _askingGPT = true;
        companioNitaResponse = "";
        gptResponseShareText = "";
        StateHasChanged();

        companioNitaResponse = await SignalRClient.StreamAskCompanioNitaAsync(gptMessage, (accumulated) =>
        {
            companioNitaResponse = accumulated;
            StateHasChanged();
        });

        gptResponseShareText = $"{Loc["Home_ShareAdvice"]}\n{Util.StripHtmlTags(companioNitaResponse)}";

        _askingGPT = false;
        StateHasChanged();
    }



    private async Task TogglePastAdvice()
    {
        if (showPastAdvice == false && pastAdvice.Count == 0)
        {
            // Fetch past advice only the first time the section is expanded
            pastAdvice = await SignalRClient.GetAdvice();
        }
        showPastAdvice = !showPastAdvice;
    }
}


<Information Content="@(new MarkupString(Loc["Home_Information"].Value))" />

<div class="home-layout">
    <CompanioNationLogo />

    <br /><br />

    <AdviceOfTheDay />


    <br /><br />

    <h3><img src="/images/CompanioNita.png" alt="" width="512" height="512" class="companionita-icon" /> @Loc["Home_CompanioNitaPrompt"]</h3>

    <textarea id="gptMessage" type="text" @bind="@gptMessage" style="width:100%;" autocomplete="on" placeholder="@Loc["Home_AskPlaceholder"]" />
    <br />
    <ActionButton OnClick="AskCompanioNita">@Loc["Home_AskButton"]</ActionButton>

    @if (_askingGPT)
    {
        <b>@Loc["Home_Asking"]</b>
        <br />
        @if (!string.IsNullOrEmpty(companioNitaResponse))
        {
            <ShadowDomElement Html="@companioNitaResponse"></ShadowDomElement>
        }
    }
    else if (!string.IsNullOrEmpty(gptResponseShareText))
    {
        <br />
        <br />
        <br />
        <ShareButton ShareTitle="@Loc["Home_ShareTitle"]"
                     ShareText="@gptResponseShareText"
                     ShareUrl="https://companionation.com/" />
        <ShadowDomElement Html="@companioNitaResponse"></ShadowDomElement>
    }

    <br /><br />


    <!-- Expandable section for past advice -->
    <div class="past-advice-section">
        <ActionButton OnClick="TogglePastAdvice">
            @if (showPastAdvice)
            {
                <span>@Loc["Home_HidePrevious"]</span>
            }
            else
            {
                <span>@Loc["Home_ShowPrevious"]</span>
            }
        </ActionButton>

        @if (showPastAdvice)
        {
            <ul>
                @foreach (var advice in pastAdvice)
                {
                    <li>
                        <strong>@Loc["Home_Question"]</strong> @advice.Prompt<br />
                        <strong>@Loc["Home_Answer"]</strong>
                        <ShadowDomElement Html="@advice.Response"></ShadowDomElement>
                    </li>
                }
            </ul>
        }
    </div>




</div>
