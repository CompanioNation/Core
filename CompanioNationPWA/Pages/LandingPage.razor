@* Not routable by URL: the landing page is rendered directly by MainLayout for
   anonymous visitors, so the entry/homepage is reachable only at "/". The old
   "/landing" route was removed to avoid duplicate content in search indexes. *@
@inject IJSRuntime JSRuntime
@using CompanioNation.Shared
@inject IStringLocalizer<LandingPage> Loc


<CompanioNationLogo />

<section class="landing-companionita">
    <img src="images/CompanioNita.png" alt="CompanioNita" class="landing-companionita-img" width="88" height="88" loading="lazy" />
    <div class="landing-companionita-speech">@Loc["LandingPage_CompanioNita_Speech"]</div>
    <div class="landing-companionita-notes">
        <p class="landing-companionita-note">@Loc["LandingPage_WhatIs_FreeAdvice"]</p>
        <p class="landing-companionita-note">@Loc["LandingPage_CompanioNita_Membership"]</p>
    </div>
</section>

<section class="landing-hero">
    <h1>@Loc["LandingPage_Headline"]</h1>
    <p class="landing-hero-sub">@Loc["LandingPage_HeroSub"]</p>
    <ActionButton Class="landing-cta"
                  Color="#00C400"
                  ShowCompletionStates="false"
                  CapturePreBoot="true"
                  AriaLabel="@Loc["LandingPage_LoginButton"]"
                  OnClick="() => MainLayoutInstance.ShowLogin()"
                  data-cn-preclick="login">
        <ChildContent>
            @Loc["LandingPage_LoginButton"]
        </ChildContent>
        <BusyContent>
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            @Loc["LandingPage_Loading"]
        </BusyContent>
    </ActionButton>

    @if (_showStoreBadges)
    {
        <div class="storeBadges">
            <a href="@GooglePlayUrl" target="_blank" rel="noopener noreferrer" aria-label="@Loc["LandingPage_GetItOnGooglePlay"]">
                <img src="images/stores/google-play-badge.svg" alt="@Loc["LandingPage_GetItOnGooglePlay"]" width="152" height="44" />
            </a>
            <a href="@AppStoreUrl" target="_blank" rel="noopener noreferrer" aria-label="@Loc["LandingPage_DownloadOnTheAppStore"]">
                <img src="images/stores/app-store-badge.svg" alt="@Loc["LandingPage_DownloadOnTheAppStore"]" width="152" height="44" />
            </a>
            <a href="@MicrosoftStoreUrl" target="_blank" rel="noopener noreferrer" aria-label="@Loc["LandingPage_GetItFromMicrosoft"]">
                <img src="images/stores/microsoft-store-badge.svg" alt="@Loc["LandingPage_GetItFromMicrosoft"]" width="152" height="44" />
            </a>
        </div>
    }

    <p class="landing-credit">@Loc["LandingPage_Feature_BuiltBy"]</p>
</section>

<section class="landing-features">
    <article class="feature-card">
        <h3>@Loc["LandingPage_Feature_FreeTitle"]</h3>
        <p>@Loc["LandingPage_Feature_Free"]</p>
    </article>
    <article class="feature-card">
        <h3>@Loc["LandingPage_Feature_ValidationTitle"]</h3>
        <p>@Loc["LandingPage_Feature_Validation"]</p>
    </article>
    <article class="feature-card">
        <h3>@Loc["LandingPage_Feature_OpenSourceTitle"]</h3>
        <p>@Loc["LandingPage_Feature_OpenSource"]</p>
    </article>
    <article class="feature-card">
        <h3>@Loc["LandingPage_Feature_WorldwideTitle"]</h3>
        <p>@Loc["LandingPage_Feature_Worldwide"]</p>
    </article>
</section>

<section class="landing-advice">
    <AdviceOfTheDay />
</section>

<section class="landing-why">
    <h2>@Loc["LandingPage_WhatIs_Title"]</h2>
    <ul>
        <li>@Loc["LandingPage_WhatIs_NoLikeGame"]</li>
        <li>@Loc["LandingPage_WhatIs_NoLimits"]</li>
        <li>@Loc["LandingPage_WhatIs_Scammers"]</li>
        <li>@Loc["LandingPage_WhatIs_Ratings"]</li>
        <li>@Loc["LandingPage_WhatIs_ComingSoon"]</li>
    </ul>
</section>

<section class="landing-social">
    <h2>@Loc["LandingPage_SocialTitle"]</h2>
    <div id="fb-widget-container" class="fb-widget-container">
        <div class="fb-page"
             data-href="https://www.facebook.com/profile.php?id=61558167633095"
             data-tabs="timeline"
             data-width="500"
             data-height=""
             data-small-header="false"
             data-adapt-container-width="true"
             data-hide-cover="false"
             data-show-facepile="true">
            <blockquote cite="https://www.facebook.com/profile.php?id=61558167633095" class="fb-xfbml-parse-ignore">
                <a href="https://www.facebook.com/profile.php?id=61558167633095">CompanioNation</a>
            </blockquote>
        </div>
    </div>
</section>

<Footer />

@code {
        [Parameter, EditorRequired]
    public MainLayout MainLayoutInstance { get; set; }

    // Public store listings. Linked from the landing page when running in a web browser.
    // URLs are intentionally locale/region-agnostic: omitting country and language
    // parameters lets each store redirect every visitor to their own localized listing.
    private const string GooglePlayUrl = "https://play.google.com/store/apps/details?id=com.companionation.app";
    private const string AppStoreUrl = "https://apps.apple.com/app/id6761560261";
    private const string MicrosoftStoreUrl = "https://apps.microsoft.com/detail/9mtkf4nhdlnw";

    // Only show the app-store badges in a real web browser, not inside the wrapper
    // apps. Default TRUE so the SSR/prerendered HTML always includes the store links
    // (vital for SEO and for visitors during the WASM boot); after the runtime is
    // interactive we hide them only if this is actually a native wrapper app.
    private bool _showStoreBadges = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("loadFacebookWidget", "fb-widget-container");
            }
            catch
            {
                // Prerendering (JS unavailable) or the FB SDK not being ready yet —
                // the widget simply stays a plain container until interactivity.
            }

            try
            {
                // window.isWebBrowser is defined in pwa-install.js and returns false
                // only inside the native wrappers; the check fails open in a browser.
                _showStoreBadges = await JSRuntime.InvokeAsync<bool>("window.isWebBrowser");
                StateHasChanged();
            }
            catch
            {
                // Prerender or interop unavailable — keep the SSR default (visible).
            }
        }
    }
}
