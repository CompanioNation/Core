@page "/auth/apple/complete"
@inject IJSRuntime JS
@inject CompanioNationSignalRClient? SignalRClient
@inject NavigationManager Nav
@inject IStringLocalizer<SharedStrings> Loc

<div class="oauth-overlay">
    <div class="oauth-card">
        <div class="oauth-logo">CompanioNation™</div>

        @if (string.IsNullOrEmpty(_error))
        {
            <div class="oauth-spinner-container">
                <div class="oauth-spinner"></div>
            </div>
            <p class="oauth-status">@string.Format(Loc["Auth_SigningIn"], "Apple")</p>
            <p class="oauth-hint">@Loc["Auth_Hint"]</p>
        }
        else
        {
            <div class="oauth-error-icon">&#x26A0;</div>
            <p class="oauth-error-heading">@Loc["Auth_SomethingWrong"]</p>
            <div class="oauth-error-message">@_error</div>
            @if (_showAlternateLogin)
            {
                <p class="oauth-alt-hint">@Loc["Auth_AltHint"]</p>
                <button type="button" class="oauth-alt-button" @onclick="UseAlternateLogin">
                    @Loc["Auth_UseEmailInstead"]
                </button>
            }
        }
    </div>
</div>

@code {
        private string _error;
    private bool _showAlternateLogin;

    private static string GetQueryParam(Uri uri, string key)
    {
        if (uri == null) return null;
        var query = uri.Query;
        if (string.IsNullOrEmpty(query)) return null;

        foreach (var part in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && string.Equals(Uri.UnescapeDataString(kv[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(kv[1]);
            }
        }
        return null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        var code = GetQueryParam(uri, "code");
        var state = GetQueryParam(uri, "state");
        var firstName = GetQueryParam(uri, "firstName");
        var lastName = GetQueryParam(uri, "lastName");

        // Bare callback (no code and no state): this route stays in browser history with
        // its query scrubbed after every sign-in, so Back/session restore/bookmarks re-open
        // it with nothing to validate. Not an OAuth response and not an attack — just go
        // home, WITHOUT touching any pending sign-in's stored state.
        if (string.IsNullOrWhiteSpace(code) && string.IsNullOrWhiteSpace(state))
        {
            Nav.NavigateTo("/", false);
            return;
        }

        // Validate state
        bool stateValid = true;
        string expectedState = null;
        bool stateExpired = false;
        bool storageFailed = false;
        try
        {
            // localStorage (not sessionStorage): iOS PWA WebViews clear sessionStorage
            // during cross-origin OAuth redirects, which would wipe the Apple state.
            expectedState = await JS.InvokeAsync<string>("localStorage.getItem", "apple_oauth_state");
            var stateTsStr = await JS.InvokeAsync<string>("localStorage.getItem", "apple_oauth_state_ts");
            await JS.InvokeVoidAsync("localStorage.removeItem", "apple_oauth_state");
            await JS.InvokeVoidAsync("localStorage.removeItem", "apple_oauth_state_ts");

            // Validate state expiry (15-minute window — industry standard for OAuth state
            // parameters, per OWASP recommendations. Allows for slow connections and MFA.)
            if (long.TryParse(stateTsStr, out var stateTs))
            {
                var stateAge = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - stateTs;
                stateExpired = stateAge > 900_000; // 15 minutes
            }

            stateValid = !string.IsNullOrEmpty(expectedState)
                && string.Equals(state, expectedState, StringComparison.Ordinal)
                && !stateExpired;
        }
        catch
        {
            storageFailed = true;
            stateValid = false;
        }

        if (!stateValid)
        {
            ShowOAuthError(Loc["Auth_InvalidState"]);

            // Only a genuine value mismatch is CSRF-shaped. Expired/missing state is the
            // routine stale-tab / slow-consent-screen case — reject it, but don't cry wolf.
            if (!storageFailed && !string.IsNullOrEmpty(expectedState) &&
                !string.Equals(state, expectedState, StringComparison.Ordinal))
            {
                try { SignalRClient?.LogError("Apple OAuth state VALUE MISMATCH; possible CSRF."); } catch { }
            }
            else
            {
                try { SignalRClient?.LogError(storageFailed
                    ? "Apple OAuth state could not be validated (storage/JS interop failed)."
                    : "Apple OAuth state missing or expired (benign; stale tab or slow consent screen)."); } catch { }
            }
            StateHasChanged();
            return;
        }

        // Clean sensitive params from the address bar
        try
        {
            await JS.InvokeVoidAsync("eval", "history.replaceState(null,'', location.origin + location.pathname);");
        }
        catch { }

        if (!string.IsNullOrWhiteSpace(code))
        {
            try
            {
                var redirectUri = Nav.BaseUri.TrimEnd('/') + "/auth/apple/callback";
                var result = await SignalRClient.LoginWithApple(code, redirectUri, firstName ?? "", lastName ?? "");
                if (result.IsSuccess)
                {
                    Nav.NavigateTo("/", true);
                    return;
                }

                ShowOAuthError(result.Message ?? "Apple sign-in failed. Please retry or pick another login option.");
                StateHasChanged();
                try { SignalRClient?.LogError($"Apple login failed: {result.ErrorCode}: {result.Message}"); } catch { }
                return;
            }
            catch (Exception ex)
            {
                SignalRClient?.LogError(ex, "Apple OAuth exchange unexpectedly failed.");
                ShowOAuthError(string.Format(Loc["Auth_CouldntFinish"], "Apple"));
                StateHasChanged();
                return;
            }
        }

        // Fallback: go home
        Nav.NavigateTo("/");
    }

    private void ShowOAuthError(string message)
    {
        _error = message;
        _showAlternateLogin = true;
    }

    private async Task UseAlternateLogin()
    {
        try
        {
            await SignalRClient.RequestLogin();
        }
        catch { }

        Nav.NavigateTo("/", false);
    }
}
