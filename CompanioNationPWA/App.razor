@inject IConfiguration Configuration
@inject IStringLocalizer<App> Loc
@inject IStringLocalizer<CompanioNationLogo> LogoLoc
@inject NavigationManager NavManager
@using System.Text.Json
@using CompanioNationPWA.Components
@using CompanioNationPWA.Layout

@{
    var gtmId = Configuration["GTM_ID"] ?? "";
    var currentLang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var canonicalUrl = Util.GetCanonicalUrl(NavManager.Uri);
}

<!DOCTYPE html>
<html lang="@currentLang">

<head>
    @((MarkupString)Util.GtmHeadScript(gtmId))

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@Loc["App_Title"]</title>

    <base href="/" />
    <link rel="preload" href="images/companionation_rounded_background.png" as="image" type="image/png" fetchpriority="high" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" /></noscript>
    <link rel="stylesheet" href="css/app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    <link rel="stylesheet" href="CompanioNationPWA.styles.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="CompanioNationPWA.styles.css" /></noscript>
    <link href="manifest.webmanifest" rel="manifest" />
    <meta name="mobile-web-app-capable" content="yes">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="CompanioNation™">
    <link rel="apple-touch-icon" sizes="120x120" href="icons/120.png">
    <link rel="apple-touch-icon" sizes="152x152" href="icons/152.png">
    <link rel="apple-touch-icon" sizes="167x167" href="icons/167.png">
    <link rel="apple-touch-icon" sizes="180x180" href="icons/180.png">

    <meta name="description" content="@Loc["App_MetaDescription"]">

    <link rel="canonical" href="@canonicalUrl" />
    @foreach (var lang in SupportedLanguages.Codes)
    {
        <link rel="alternate" hreflang="@lang" href="@(Util.GetHreflangUrl(NavManager.Uri, lang))" />
    }
    <link rel="alternate" hreflang="x-default" href="@(Util.GetHreflangUrl(NavManager.Uri, "en"))" />

    <HeadOutlet @rendermode="InteractiveWebAssembly" />

    <!-- CACHE BUSTING -->
    <meta http-equiv="Cache-Control" content="no-store" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />

    <script>
        // Full-screen "Opening link…" overlay shown while a deep link (e.g. a push
        // notification tap) is pending during cold start, so users don't stare at the
        // main screen while the WASM runtime boots and the target page loads. Shown
        // from plain JS (before Blazor is reachable), hidden once navigation lands.
        window.cnDeepLinkOverlayMessage = @((MarkupString)JsonSerializer.Serialize(Loc["App_OpeningLink"].Value));
        window.cnShowDeepLinkOverlay = function (url) {
            if (document.getElementById('cn-deeplink-overlay')) return;
            var style = document.createElement('style');
            style.textContent = '@@keyframes cnDeeplinkSpin { to { transform: rotate(360deg); } }';
            document.head.appendChild(style);
            var overlay = document.createElement('div');
            overlay.id = 'cn-deeplink-overlay';
            overlay.style.cssText = 'position:fixed;inset:0;z-index:99998;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#1d1f23;color:#f5f5f5;font-family:Segoe UI,system-ui,sans-serif;text-align:center;padding:24px;';
            var spinner = document.createElement('div');
            spinner.style.cssText = 'width:48px;height:48px;border:4px solid rgba(245,245,245,.25);border-top-color:#f5f5f5;border-radius:50%;animation:cnDeeplinkSpin .8s linear infinite;margin-bottom:16px;';
            var msg = document.createElement('div');
            msg.style.cssText = 'font-size:1.05rem;opacity:.9;';
            msg.textContent = window.cnDeepLinkOverlayMessage;
            overlay.appendChild(spinner);
            overlay.appendChild(msg);
            // document.body may not exist yet if a native event fires during head
            // parsing; appending to <html> still renders the fixed overlay.
            (document.body || document.documentElement).appendChild(overlay);

            // Safety net: if Blazor never boots to flush the pending navigation,
            // fall back to a full navigation so the deep link is still honored.
            if (url) {
                window._cnDeepLinkOverlayTimer = setTimeout(function () {
                    window.cnHideDeepLinkOverlay();
                    window.location.href = url;
                }, 20000);
            }
        };
        window.cnHideDeepLinkOverlay = function () {
            if (window._cnDeepLinkOverlayTimer) {
                clearTimeout(window._cnDeepLinkOverlayTimer);
                window._cnDeepLinkOverlayTimer = null;
            }
            var overlay = document.getElementById('cn-deeplink-overlay');
            if (overlay) overlay.remove();
        };

        // Full-screen "Logging back in…" overlay shown while Blazor validates a
        // persisted login token during startup. It reuses the branded startup
        // splash (cn-splash-*) so returning users see the standard logo, tagline
        // and navy gradient instead of a bare black screen. Its z-index sits
        // BELOW the login popup (10001), so an invalid token can present the
        // login form directly on top of this placeholder.
        window.cnStartupAuthOverlayMessage = @((MarkupString)JsonSerializer.Serialize(Loc["App_LoggingBackIn"].Value));
        window.cnStartupAuthLogoAlt = @((MarkupString)JsonSerializer.Serialize(LogoLoc["CompanioNationLogo_Alt"].Value));
        window.cnStartupAuthTagline = @((MarkupString)JsonSerializer.Serialize(LogoLoc["CompanioNationLogo_Tagline"].Value));
        window.cnShowStartupAuthOverlay = function () {
            if (document.getElementById('cn-startup-auth-overlay')) return;
            var overlay = document.createElement('div');
            overlay.id = 'cn-startup-auth-overlay';
            overlay.className = 'cn-splash';
            overlay.style.zIndex = '9990';

            var glow = document.createElement('div');
            glow.className = 'cn-splash-glow';
            overlay.appendChild(glow);

            var logoWrap = document.createElement('div');
            logoWrap.className = 'cn-splash-logo';
            var logo = document.createElement('img');
            logo.src = 'images/companionation_rounded_background.png';
            logo.alt = window.cnStartupAuthLogoAlt;
            logoWrap.appendChild(logo);
            overlay.appendChild(logoWrap);

            var brand = document.createElement('div');
            brand.className = 'cn-splash-brand';
            brand.innerHTML = 'CompanioNation<span class="cn-splash-tm">&trade;</span>';
            overlay.appendChild(brand);

            var tagline = document.createElement('div');
            tagline.className = 'cn-splash-tagline';
            tagline.textContent = window.cnStartupAuthTagline;
            overlay.appendChild(tagline);

            var spinner = document.createElement('div');
            spinner.style.cssText = 'width:48px;height:48px;border:4px solid rgba(245,245,245,.25);border-top-color:#f5f5f5;border-radius:50%;animation:oauth-spin .8s linear infinite;margin-top:2.25rem;';
            var msg = document.createElement('div');
            msg.style.cssText = 'font-size:1.05rem;opacity:.9;';
            msg.textContent = window.cnStartupAuthOverlayMessage;
            overlay.appendChild(spinner);
            overlay.appendChild(msg);
            (document.body || document.documentElement).appendChild(overlay);

            // If Blazor never boots, don't leave the user stuck behind the overlay.
            window._cnStartupAuthOverlayTimer = setTimeout(function () {
                window.cnHideStartupAuthOverlay();
            }, 30000);
        };
        window.cnHideStartupAuthOverlay = function () {
            if (window._cnStartupAuthOverlayTimer) {
                clearTimeout(window._cnStartupAuthOverlayTimer);
                window._cnStartupAuthOverlayTimer = null;
            }
            var overlay = document.getElementById('cn-startup-auth-overlay');
            if (overlay) overlay.remove();
        };
    </script>
    <script src="js/bot-renderer.js"></script>
    <script src="pwa-install.js"></script>
    <script src="js/analytics.js" defer></script>
    <script src="js/imageProcessing.js" defer></script>
    <script src="js/facebook-widget.js" defer></script>
    <script src="js/culture.js"></script>
    <script src="js/geolocation.js" defer></script>
    <script src="js/iap.js" defer></script>
    <script src="js/vendor/chart.umd.min.js" defer></script>
    <script>
        window.canUseShare = function () {
            return typeof navigator !== 'undefined' && typeof navigator.share === 'function';
        };
    </script>
    <script>
        // Bot renderers tear the WASM runtime down after capturing the page, and the
        // Blazor framework paints its error bar into the stored screenshot. Hide it
        // for renderers only — see js/bot-renderer.js.
        if (window.cnHideBlazorErrorUiForBotRenderers) window.cnHideBlazorErrorUiForBotRenderers();
    </script>
    <script>
        window.cnShowStartupGuard = function () {
            var host = document.getElementById('app') || document.body;
            host.innerHTML =
                '<div style="position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;background:#1d1f23;color:#f5f5f5;font-family:Segoe UI,system-ui,sans-serif;padding:24px;">' +
                    '<div style="max-width:640px;text-align:left;line-height:1.5;">' +
                        '<h1 style="font-size:1.6rem;margin:0 0 .5rem;">&#9888;&#65039; Wrong startup project</h1>' +
                        '<p style="margin:.25rem 0 1rem;opacity:.85;">You launched <strong>CompanioNationPWA</strong> (the Blazor WebAssembly client) directly. This dev server has no API and no SignalR hub, so the app cannot connect &mdash; you would otherwise see a <code>405</code> on <code>/CompanioNationHub/negotiate</code>.</p>' +
                        '<p style="margin:0 0 .5rem;"><strong>Fix it:</strong></p>' +
                        '<ol style="margin:0 0 1rem 1.25rem;padding:0;">' +
                            '<li>In Solution Explorer, right-click <strong>CompanioNationAPI</strong>.</li>' +
                            '<li>Choose <strong>Set as Startup Project</strong>.</li>' +
                            '<li>Select the <strong>https</strong> launch profile and run again.</li>' +
                        '</ol>' +
                        '<p style="margin:0;opacity:.6;font-size:.85rem;">The API host serves this client and the SignalR hub together on the same URL.</p>' +
                    '</div>' +
                '</div>';
        };
        window.onerror = function (message, source, lineno, colno, error) {
            try {
                if (window._isRefreshing) return true;

                // The .NET WASM runtime throws ExitStatus when it shuts down cleanly
                // (e.g. Googlebot ending its render after capturing the prerendered
                // HTML). Exit code 0 is a normal shutdown, not an error, so never
                // surface it as the "unhandled error" bar.
                if (error && error.name === 'ExitStatus' && error.status === 0) {
                    return true;
                }

                if (source && source !== '' && !source.startsWith(window.location.origin)) {
                    console.warn('Suppressed third-party error:', message, source);
                    return true;
                }

                if (!source && !lineno && !colno && !error) {
                    return true;
                }

                console.error(`Error: ${message} at ${source}:${lineno}:${colno}`, error);
                document.getElementById('blazor-error-ui').style.display = 'block';
            } catch (err) {
                console.error('window.onerror handler failed:', err);
            }
            return true;
        };
    </script>

</head>

<body>
    @((MarkupString)Util.GtmBodyNoscript(gtmId))

    <script>
        // Immediate token check: if a login token is persisted, cover the
        // prerendered "not logged in" entry page with a "Logging back in…"
        // placeholder until Blazor validates it. Crawlers don't run this, so the
        // SSR entry-page content remains indexed. Runs as early as possible so the
        // entry page never flashes for returning users.
        (function () {
            try {
                var token = window.localStorage && window.localStorage.getItem('loginGuid');
                if (token && window.cnShowStartupAuthOverlay) window.cnShowStartupAuthOverlay();
            } catch (e) {
                // localStorage may be unavailable (privacy mode) — let Blazor handle it.
            }
        })();
    </script>

    <noscript>
        <style>
            body { padding-top: 40px; }
            #cn-noscript-bar { position: fixed; top: 0; left: 0; right: 0; height: 40px; background: #1a1a2e; color: #e0e0e0; display: flex; align-items: center; justify-content: center; gap: 20px; font-size: 0.85rem; z-index: 99999; font-family: Arial, Helvetica, sans-serif; }
            #cn-noscript-bar a { color: #64b5f6; font-weight: 500; }
            .fullPage { top: 40px !important; }
        </style>
        <div id="cn-noscript-bar">
            <span>@Loc["App_NoscriptMessage"]</span>
            <a href="/CompanioNitasCorner/">@Loc["App_NoscriptCorner"]</a>
            <a href="/s/browse/">@Loc["App_NoscriptBrowse"]</a>
        </div>
    </noscript>

    <CustomErrorBoundary>
        <Routes @rendermode="InteractiveWebAssembly" />
    </CustomErrorBoundary>

    <div id="blazor-error-ui">
        @Loc["App_ErrorHeading"]
        <a href="" class="reload">@Loc["App_ErrorReload"]</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        // Crawlers already have the fully prerendered HTML and don't need
        // interactivity. Skipping the WASM boot also keeps Google Search
        // Console clean (no ExitStatus teardown or runtime console noise).
        if (!(window.cnIsBotRenderer && window.cnIsBotRenderer())) {
            Blazor.start();
        }
    </script>

</body>

</html>
