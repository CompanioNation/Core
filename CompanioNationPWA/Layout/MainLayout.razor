@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject ICompanioNationSignalRClient? SignalRClient
@inject NavigationManager NavManager
@inject HttpClient Http
@inject IConfiguration Configuration
@inject IStringLocalizer<MainLayout> Loc
@implements IDisposable
@using CompanioNation.Shared
@using CompanioNationPWA.Components
@using CompanioNation.Components
@using System.Text.Json


@code {
    // Fires whenever a new message is received, passes the userId the message is from
    public event Action<int> OnMessageReceived;

    // Fires whenever the subscribe popup closes (subscribed or dismissed). Pages can use this
    // to refresh any stale "subscription expired/required" notice they may be showing.
    public event Action OnSubscribeClosed;


    private bool _navigateToNewPage = false;
    private Login loginComponent;
    private SubscribeToCompanioNita subscribeComponent;

    bool isLoggedIn = false;
    bool _authResolved = false;
    bool _showTerms = false;
    bool _needsBasicInfo = false;
    bool _needsEmailVerification = false;
    string loginGuid = "not logged in";
    bool disableMainContent = false;
    string wrapperDivClass = "";

    string showInstallBanner = "hideHtmlElement";
    string showIosInstallBanner = "hideHtmlElement";
    string showEnableNotificationsBanner = "hideHtmlElement";

    string _errorMessage = "";
    string _successMessage = "";

    string _verificationMessage = "";
    bool _verificationMessageIsError = false;
    string _resendVerificationMessage = "";
    bool _resendingVerification = false;

    private DotNetObjectReference<MainLayout> objRef;

    // Maintenance-mode polling. The flag is a public Azure Blob (maintenance.json) that is
    // reachable even while the App Service is stopped, so installed apps can show a friendly
    // page instead of the Azure "403 web app stopped" page during the promotion cutover.
    private bool _maintenanceActive = false;
    private string _maintenanceMessage = string.Empty;
    private CancellationTokenSource? _maintenancePollCts = null;
    private readonly SemaphoreSlim _maintenancePollLock = new(1, 1);
    private static readonly TimeSpan MaintenancePollInterval = TimeSpan.FromSeconds(90);

    private sealed class MaintenanceFlag
    {
        public bool Active { get; set; }
        public string Message { get; set; } = string.Empty;
    }

    private string MaintenanceFlagUrl =>
        string.IsNullOrWhiteSpace(Configuration["Maintenance:FlagUrl"])
            ? string.Empty
            : Configuration["Maintenance:FlagUrl"]!;

    // Handler the subscribe component registers through Initialize(...). Captured so it can
    // be detached from the singleton SignalRClient on dispose. The layout is deliberately
    // agnostic about what the component does with the hub-connected signal.
    private Action _componentHubConnectedHandler;

    private Uri currentUri => NavManager.ToAbsoluteUri(NavManager.Uri);


    private async Task CallLoginMethod()
    {
        await loginComponent.ShowLogin();
    }

    private async Task CallSubscribeMethod()
    {
        await subscribeComponent.ShowSubscribe();
    }

    private bool IsPage(string pageUrl)
    {
        try
        {
            // Convert the input URL to a Uri object
            var pageUri = new Uri(pageUrl, UriKind.RelativeOrAbsolute);

            // Normalize the pageUri to be relative and extract only the path
            var normalizedPagePath = pageUri.IsAbsoluteUri ? pageUri.AbsolutePath : pageUri.ToString().Split('?')[0];
            normalizedPagePath = normalizedPagePath.TrimStart('/');

            // Normalize currentUri to be relative and extract only the path
            var normalizedCurrentPath = currentUri.IsAbsoluteUri ? currentUri.AbsolutePath : currentUri.ToString().Split('?')[0];
            normalizedCurrentPath = normalizedCurrentPath.TrimStart('/').Split('/')[0];

            //if (normalizedCurrentPath.Length > normalizedPagePath.Length) normalizedCurrentPath = normalizedCurrentPath.Substring(0, normalizedPagePath.Length);

            // Compare the normalized paths
            return string.Equals(normalizedCurrentPath, normalizedPagePath, StringComparison.OrdinalIgnoreCase);
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex);
            return false;
        }
    }

    /// <summary>
    /// True when the current URL is a deep link to a page that requires
    /// authentication (e.g. /Settings?emailChangeCode=..., /Messages/123)
    /// rather than the entry route "/". Used during SSR prerendering,
    /// where the auth state is unknown, to show an "Opening link…" placeholder
    /// instead of flashing the landing page while the WASM runtime boots.
    /// </summary>
    private bool IsDeepLinkRoute()
    {
        var path = currentUri.AbsolutePath.TrimStart('/');
        return !string.IsNullOrEmpty(path);
    }

    bool showUpdateToast = false;

    private async void OnUpdateAvailable()
    {
        showUpdateToast = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override Task OnInitializedAsync()
    {
        NavManager.LocationChanged += OnLocationChanged;

        objRef = DotNetObjectReference.Create(this);

        if (SignalRClient is not null)
        {
            // When a login just completed and the app navigates client-side,
            // the singleton already holds the current user. Seed the flag so
            // the entry/landing page never flashes in that flow.
            isLoggedIn = SignalRClient.CurrentUser is not null;

            SignalRClient.OnLoginRequested += DoShowLogin;
            SignalRClient.OnSubscriptionRequested += DoShowSubscribe;
            SignalRClient.OnStateHasChanged += UpdateState;
            SignalRClient.OnUpdateAvailable += OnUpdateAvailable;
            SignalRClient.OnHubDisconnected += OnHubDisconnectedForMaintenance;
            SignalRClient.OnHubConnected += OnHubConnectedForMaintenance;
        }

        return Task.CompletedTask;
    }

    // A dropped SignalR connection is the first observable symptom of the App Service
    // being stopped mid-promotion, so poll the maintenance flag immediately rather than
    // waiting for the next regular interval.
    private void OnHubDisconnectedForMaintenance()
    {
        _ = PollMaintenanceOnceAsync();
    }

    private void OnHubConnectedForMaintenance()
    {
        // Connection is back — poll once so the maintenance page dismisses promptly
        // when the flag has been cleared.
        _ = PollMaintenanceOnceAsync();
    }
    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        _navigateToNewPage = true;
        StateHasChanged(); // Trigger a re-render so OnAfterRenderAsync runs.
    }

    private async void UpdateState()
    {
        if (SignalRClient is not null)
        {
            bool nowLoggedIn = SignalRClient.CurrentUser is not null;

            // On the transition to logged-in, run the same post-login gates the
            // startup path runs (terms, basic info). This keeps client-side
            // post-login navigation from flashing the entry page or skipping them.
            if (nowLoggedIn && !isLoggedIn)
            {
                isLoggedIn = true;
                _showTerms = NeedsTermsAcceptance();
                if (!_showTerms)
                {
                    _needsBasicInfo = !CheckForBasicInfo();
                    _needsEmailVerification = !_needsBasicInfo && !IsVerified();
                }
            }
            else
            {
                isLoggedIn = nowLoggedIn;
            }
        }

        await InvokeAsync(StateHasChanged); // Ensures the UI is updated.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_navigateToNewPage)
        {
            _navigateToNewPage = false;
            try
            {
                // Directly use JS to scroll the main content area.

                // This is for pages that don't have the button bar
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('fullPageDiv')?.scrollTo(0, 0);");
                // This is for pages with the button bar
                await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('mainlayout_content')?.scrollTo(0, 0);");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Scroll reset failed: {ex.Message}");
            }
        }

        if (firstRender)
        {
            // Pass the .NET object reference to JavaScript
            await JSRuntime.InvokeVoidAsync("setDotNetObjectReference", objRef);

            // Seed the VAPID public key on window so the synchronous click-driven
            // enableNotificationsFromClick() path can subscribe without needing
            // another Blazor round-trip (which would defeat the user-gesture fix).
            await JSRuntime.InvokeVoidAsync("eval", $"window._cnVapidPublicKey = '{Util.VapidPublicKey}';");

            // Fire-and-forget: Register in the background without blocking initialization
            _ = RegisterServiceWorker();

            _ = SetInstallBannerState();

            // Register FCM token callback so native iOS tokens are captured immediately
            _ = RegisterFcmTokenCallback();

            // Hand the subscribe component a generic initialization hook. It may register a
            // callback to run whenever the hub (re)connects, and it reports failures through
            // the host's resilient logger. The layout stays blind to what the component does
            // with either; a stub build simply ignores them.
            //
            // The open-source CompanioNation.Components stub is a no-op by design and may be an
            // older version that predates Initialize. Detect the method and skip the call when
            // it isn't present — never require a specific stub version.
            var init = subscribeComponent?.GetType().GetMethod(
                "Initialize",
                new[] { typeof(Action<Action>), typeof(Func<Exception, string?, Task>) });
            if (init is not null)
            {
                init.Invoke(subscribeComponent, new object?[]
                {
                    (Action<Action>)(handler =>
                    {
                        _componentHubConnectedHandler = handler;
                        if (SignalRClient is not null)
                            SignalRClient.OnHubConnected += handler;
                    }),
                    (Func<Exception, string?, Task>)((ex, info) => SignalRClient?.LogError(ex, info))
                });
            }

            // ── Auth initialization ──
            // Run in the background so the first interactive render does not block
            // behind the SignalR handshake. The plain-JS startup overlay (shown when
            // a token is persisted) stays up until this completes.
            _ = ResolveAuthAsync();

            // ── Email verification deep link ──
            _ = HandleEmailVerificationDeepLinkAsync();

            // ── Maintenance polling ──
            _ = RunMaintenancePollingAsync();
        }
    }

    private async Task RunMaintenancePollingAsync()
    {
        if (string.IsNullOrWhiteSpace(MaintenanceFlagUrl)) return;

        _maintenancePollCts = new CancellationTokenSource();
        var token = _maintenancePollCts.Token;

        // Poll immediately on startup so a mid-maintenance app launch shows the page
        // right away, then keep rechecking every MaintenancePollInterval. The loop only
        // ends when the component is disposed (token cancelled), so a set flag is polled
        // indefinitely — the page is dismissed when a poll either sees the flag cleared
        // or hits any error (PollMaintenanceOnceAsync fails open in that case).
        while (!token.IsCancellationRequested)
        {
            try
            {
                await PollMaintenanceOnceAsync(token);
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (Exception ex)
            {
                // Defensive: PollMaintenanceOnceAsync fails open on every error path,
                // but an unexpected failure must never silently kill the polling loop.
                Console.WriteLine($"Maintenance poll failed: {ex.Message}");
            }

            try { await Task.Delay(MaintenancePollInterval, token); }
            catch (OperationCanceledException) { break; }
        }
    }

    private async Task PollMaintenanceOnceAsync(CancellationToken? cancellationToken = null)
    {
        if (string.IsNullOrWhiteSpace(MaintenanceFlagUrl)) return;

        // A single poll may be triggered by both the background loop and a disconnect/
        // reconnect event; coalesce them so we never issue overlapping fetches.
        if (!await _maintenancePollLock.WaitAsync(0)) return;

        try
        {
            using var cts = CancellationTokenSource.CreateLinkedTokenSource(
                cancellationToken ?? CancellationToken.None);
            cts.CancelAfter(TimeSpan.FromSeconds(10));

            var json = await Http.GetStringAsync(MaintenanceFlagUrl, cts.Token);
            var flag = JsonSerializer.Deserialize<MaintenanceFlag>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            if (flag is null)
            {
                SetMaintenanceState(active: false, message: string.Empty);
                return;
            }

            SetMaintenanceState(flag.Active, flag.Message ?? string.Empty);
        }
        catch
        {
            // FAIL-OPEN: any fetch failure — blob deleted, storage offline, network
            // timeout, malformed JSON — means there is no usable maintenance flag, so
            // we assume the site is NOT in maintenance. This prevents a third-party
            // Azure outage (or an accidental blob deletion) from bricking every
            // installed app on the "maintenance in progress" page forever.
            SetMaintenanceState(active: false, message: string.Empty);
        }
        finally
        {
            _maintenancePollLock.Release();
        }
    }

    private void SetMaintenanceState(bool active, string message)
    {
        if (_maintenanceActive == active && _maintenanceMessage == message)
            return;

        _maintenanceActive = active;
        _maintenanceMessage = message;

        try
        {
            _ = InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Component may have been disposed mid-poll; there is nothing to update.
        }
    }

    private async Task ResolveAuthAsync()
    {
        if (_authResolved) return;
        _authResolved = true;

        try
        {
            if (SignalRClient is null) return;

            await SignalRClient.Initialize();
            isLoggedIn = SignalRClient.CurrentUser is not null;

            if (isLoggedIn)
            {
                // Check terms acceptance BEFORE basic info so the terms page
                // renders before any redirect to EnterBasicInfo.
                _showTerms = NeedsTermsAcceptance();
                if (!_showTerms)
                {
                    _needsBasicInfo = !CheckForBasicInfo();
                    _needsEmailVerification = !_needsBasicInfo && !IsVerified();
                }
            }

            loginGuid = SignalRClient.CurrentUser?.LoginToken?.ToString() ?? "not logged in";

            // If the user just logged in and has a pending LINK QR code,
            // redirect to the Link page so the redemption can complete.
            if (isLoggedIn && !_needsBasicInfo)
            {
                string? pendingLinkCode = null;
                try { pendingLinkCode = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "pendingLinkCode"); }
                catch { /* best-effort */ }
                if (!string.IsNullOrWhiteSpace(pendingLinkCode))
                {
                    NavManager.NavigateTo($"/Link?code={pendingLinkCode}", true);
                    return;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Auth resolution failed: {ex.Message}");
            SignalRClient?.LogError(ex, "MainLayout.ResolveAuth");
        }
        finally
        {
            // Dismiss the plain-JS startup overlay. If the token was invalid, the
            // login popup (which sits above that overlay) is already visible.
            try { await JSRuntime.InvokeVoidAsync("cnHideStartupAuthOverlay"); }
            catch { /* best-effort — the overlay also self-hides after its timeout */ }

            try { await InvokeAsync(StateHasChanged); }
            catch { /* component may have been disposed during a navigation */ }
        }
    }

    /// <summary>
    /// Resends the signup email-verification link to the current account and shows
    /// a confirmation. Lets a user who never received (or lost) the original email
    /// self-serve a fresh single-use link.
    /// </summary>
    private async Task ResendVerificationEmail()
    {
        if (SignalRClient is null || _resendingVerification) return;

        _resendingVerification = true;
        _resendVerificationMessage = string.Empty;
        StateHasChanged();

        try
        {
            bool sent = await SignalRClient.ResendVerificationEmail();
            _resendVerificationMessage = Loc[sent ? "MainLayout_ResendVerificationSent" : "MainLayout_EmailVerificationFailed"];
        }
        catch (Exception ex)
        {
            SignalRClient.LogError(ex, "MainLayout.ResendVerificationEmail");
            _resendVerificationMessage = Loc["MainLayout_EmailVerificationFailed"];
        }
        finally
        {
            _resendingVerification = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Detects the ?verification_code= URL parameter (emailed signup link) and
    /// verifies the account. On success, refreshes the current user and shows a
    /// confirmation; on failure, shows an error. The parameter is then removed
    /// from the address bar without a full reload.
    /// </summary>
    private async Task HandleEmailVerificationDeepLinkAsync()
    {
        string? code = ParseQueryParameter(NavManager.Uri, "email_verification_code");
        if (string.IsNullOrWhiteSpace(code))
            return;

        try
        {
            if (SignalRClient is null)
            {
                _verificationMessage = Loc["MainLayout_EmailVerificationFailed"];
                _verificationMessageIsError = true;
                return;
            }

            // Ensure the connection and current user are populated before the
            // already-verified check (ResolveAuthAsync runs concurrently).
            await SignalRClient.Initialize();

            // Already verified: don't burn a fresh code or re-run verification.
            if (SignalRClient.CurrentUser?.Verified == true)
            {
                _verificationMessage = Loc["MainLayout_EmailVerified"];
                _verificationMessageIsError = false;
                _needsEmailVerification = false;
                return;
            }

            bool verified = await SignalRClient.CheckVerificationCode(code);
            if (verified)
            {
                _verificationMessage = Loc["MainLayout_EmailVerified"];
                _verificationMessageIsError = false;
                _needsEmailVerification = false;
                await SignalRClient.RefreshCurrentUserAsync();
            }
            else
            {
                _verificationMessage = Loc["MainLayout_EmailVerificationFailed"];
                _verificationMessageIsError = true;
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "MainLayout.HandleEmailVerificationDeepLink");
            _verificationMessage = Loc["MainLayout_EmailVerificationFailed"];
            _verificationMessageIsError = true;
        }
        finally
        {
            // Strip the one-time code from the address bar without reloading.
            try { await JSRuntime.InvokeVoidAsync("history.replaceState", null, "", "/"); }
            catch { /* best-effort */ }

            await InvokeAsync(StateHasChanged);
        }
    }

    private static string? ParseQueryParameter(string url, string key)
    {
        if (string.IsNullOrWhiteSpace(url)) return null;

        var query = new Uri(url, UriKind.RelativeOrAbsolute).IsAbsoluteUri
            ? new Uri(url).Query
            : url;

        int q = query.IndexOf('?');
        if (q < 0) return null;

        foreach (var pair in query[(q + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            int eq = pair.IndexOf('=');
            var k = eq < 0 ? pair : pair[..eq];
            var v = eq < 0 ? string.Empty : pair[(eq + 1)..];
            if (string.Equals(Uri.UnescapeDataString(k), key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(v);
        }
        return null;
    }


    // Dispose the .NET object reference when the component is disposed
    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;

        _maintenancePollCts?.Cancel();
        _maintenancePollCts?.Dispose();
        _maintenancePollCts = null;

        objRef?.Dispose();

        if (SignalRClient is not null)
        {
            SignalRClient.OnLoginRequested -= DoShowLogin;
            SignalRClient.OnSubscriptionRequested -= DoShowSubscribe;
            SignalRClient.OnHubDisconnected -= OnHubDisconnectedForMaintenance;
            SignalRClient.OnHubConnected -= OnHubConnectedForMaintenance;
            SignalRClient.OnStateHasChanged -= UpdateState;
            SignalRClient.OnUpdateAvailable -= OnUpdateAvailable;

            if (_componentHubConnectedHandler is not null)
            {
                SignalRClient.OnHubConnected -= _componentHubConnectedHandler;
                _componentHubConnectedHandler = null;
            }
        }
    }

    [JSInvokable]
    public void NavigateToCurrentPage()
    {
        // Navigate to the current URI to force Blazor to re-render the page
        NavManager.NavigateTo(NavManager.Uri, forceLoad: false);
    }

    /// <summary>
    /// Called from the service worker notificationclick handler via postMessage.
    /// Navigates the Blazor SPA internally without a full page reload.
    /// </summary>
    [JSInvokable]
    public async Task NavigateToUrl(string url)
    {
        Console.WriteLine($"[Push] NavigateToUrl called with: {url}");
        NavManager.NavigateTo(url, forceLoad: false);

        // A pending deep-link navigation has been handled — dismiss the
        // "Opening link…" overlay shown during cold start before the target
        // page renders, so the main screen never flashes in between.
        try { await JSRuntime.InvokeVoidAsync("cnHideDeepLinkOverlay"); }
        catch { /* best-effort — the overlay's safety net still navigates */ }
    }

    public async Task RegisterServiceWorker()
    {
        try
        {
            // The service worker is already registered by pwa-install.js on page load.
            // This call simply awaits that promise to confirm registration completed.
            await JSRuntime.InvokeVoidAsync("window.registerServiceWorker");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to register service worker: {ex.Message}");
            SignalRClient?.LogError(ex, "RegisterServiceWorker()");
        }
    }

    [JSInvokable("SendPushTokenToServer")]
    public async Task SendPushTokenToServer(string pushToken)
    {
        if (!string.IsNullOrWhiteSpace(pushToken))
        {
            Console.WriteLine($"[Push] Sending push token to server ({pushToken.Length} chars).");
            if (SignalRClient is not null)
                await SignalRClient.UpdatePushToken(pushToken);
        }
        else
        {
            Console.WriteLine("[Push] SendPushTokenToServer called but pushToken is null/empty — skipping.");
        }
    }

    /// <summary>
    /// Called from enableNotificationsFromClick() when permission was granted but
    /// PushManager.subscribe() returned no token. Mirrors the alert produced by the
    /// existing EnableNotifications path so this real registration bug is surfaced.
    /// </summary>
    [JSInvokable("LogPushSubscriptionFailure")]
    public async Task LogPushSubscriptionFailure()
    {
        SignalRClient?.LogError("[Push] enableNotificationsFromClick: permission GRANTED but VAPID subscription returned no token — this user opted in yet cannot receive notifications. Investigate immediately.");
    }

    /// <summary>
    /// Called by the native iOS app (via JS bridge) when the FCM token arrives or refreshes.
    /// This closes the timing gap where the token isn't available yet at login/connect time.
    /// </summary>
    [JSInvokable("OnFcmTokenChanged")]
    public async Task OnFcmTokenChanged(string token)
    {
        if (!string.IsNullOrWhiteSpace(token))
        {
            Console.WriteLine("FCM token received via native callback, updating server.");
            await SendPushTokenToServer(token);
        }
    }

    /// <summary>
    /// Registers a .NET callback with the JS bridge so that when the native iOS app
    /// dispatches an FCM token (which may arrive after Blazor boots), we send it to the server immediately.
    /// </summary>
    private async Task RegisterFcmTokenCallback()
    {
        try
        {
            bool isNative = await JSRuntime.InvokeAsync<bool>("window.isNativeIosApp");
            if (isNative)
            {
                await JSRuntime.InvokeVoidAsync("window.companioNation_onFcmTokenChanged", objRef);
                Console.WriteLine("Registered FCM token callback for native iOS.");

                // A full page reload (e.g. Nav.NavigateTo("/", true) after Google login) wipes
                // window.companioNation_fcmToken, and the native side only auto-dispatches the
                // FCM token once per app launch. Proactively ask native to re-fetch and dispatch
                // it now so OnFcmTokenChanged fires and UpdatePushToken lands in the DB.
                await JSRuntime.InvokeVoidAsync("window.companioNation_requestFcmToken");
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "MainLayout.FcmToken");
            Console.WriteLine($"Failed to register FCM token callback: {ex.Message}");
        }
    }

    [JSInvokable("SetInstallBannerState")]
    public async Task SetInstallBannerState()
    {
        bool showInstall = await JSRuntime.InvokeAsync<bool>("window.shouldShowInstallButton");
        if (showInstall) showInstallBanner = "";
        else showInstallBanner = "hideHtmlElement";

        bool showIosInstall = await JSRuntime.InvokeAsync<bool>("shouldShowIosInstallButton");
        if (showIosInstall) showIosInstallBanner = "";
        else showIosInstallBanner = "hideHtmlElement";

        bool showEnableNotifications = await JSRuntime.InvokeAsync<bool>("shouldShowEnableNotifications");
        if (showEnableNotifications) showEnableNotificationsBanner = "";
        else showEnableNotificationsBanner = "hideHtmlElement";

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable("EnableNotifications")]
    public async Task EnableNotifications()
    {
        try
        {
            Console.WriteLine("[Push] EnableNotifications called (user tapped enable button).");

            // Branch: Native iOS app vs. Web/Android PWA
            bool isNativeIos = await JSRuntime.InvokeAsync<bool>("window.isNativeIosApp");

            if (isNativeIos)
            {
                // Native iOS: request permission via bridge and handle FCM token
                Console.WriteLine("[Push] Native iOS flow: requesting permission via bridge...");

                string permissionResult = await JSRuntime.InvokeAsync<string>("window.requestNativeIosPushPermission");
                Console.WriteLine($"[Push] Native permission result: {permissionResult}");

                await SetInstallBannerState();

                if (permissionResult == "granted")
                {
                    Console.WriteLine("[Push] Native permission granted, fetching FCM token...");

                    // Try to get the FCM token (may be null if not ready yet)
                    string? fcmToken = await JSRuntime.InvokeAsync<string?>("window.getFcmToken");

                    if (!string.IsNullOrWhiteSpace(fcmToken))
                    {
                        Console.WriteLine("[Push] FCM token available immediately, sending to server.");
                        await SendPushTokenToServer(fcmToken);
                    }
                    else
                    {
                        Console.WriteLine("[Push] FCM token not ready yet — callback will send it when available.");
                        // The RegisterFcmTokenCallback (already wired on connect) will send it
                        // when the native app calls companioNation_setFcmToken.
                    }
                }
                else
                {
                    Console.WriteLine($"[Push] Native permission denied or unavailable: {permissionResult}");
                }
            }
            else
            {
                // Web/Android PWA: standard VAPID flow
                Console.WriteLine("[Push] Web/Android flow: requesting permission via Notification API...");

                // Single JS interop call handles permission request + subscription.
                // This preserves the browser's transient user activation from the
                // button click — splitting into multiple interop calls breaks it.
                var result = await JSRuntime.InvokeAsync<JsonElement>(
                    "window.requestNotificationPermission", Util.VapidPublicKey);

                string permission = result.GetProperty("permission").GetString() ?? "denied";
                string? pushToken = result.GetProperty("pushToken").ValueKind == JsonValueKind.Null
                    ? null
                    : result.GetProperty("pushToken").GetString();

                Console.WriteLine($"[Push] Permission result: {permission}, pushToken: {(pushToken is not null ? $"{pushToken.Length} chars" : "null")}");

                await SetInstallBannerState();

                if (permission == "granted" && !string.IsNullOrWhiteSpace(pushToken))
                {
                    Console.WriteLine("[Push] Permission granted with valid token — sending to server.");
                    await SendPushTokenToServer(pushToken);
                }
                else if (permission == "granted")
                {
                    Console.WriteLine("[Push] Permission granted but push token is null/empty — subscription may have failed.");
                    // Genuine error: the user explicitly opted in, but we couldn't create a
                    // push subscription. This is a real registration bug worth an immediate alert.
                    SignalRClient?.LogError("[Push] EnableNotifications: permission GRANTED but VAPID subscription returned no token — this user opted in yet cannot receive notifications. Investigate immediately.");
                }
                else
                {
                    Console.WriteLine($"[Push] Notification permission not granted: {permission}");
                }
            }
        }
        catch (Exception error)
        {
            Console.WriteLine($"[Push] EnableNotifications failed: {error.Message}");
            SignalRClient?.LogError("[Push] EnableNotifications threw while the user was trying to opt in to notifications.", error, null);
        }
    }

    [JSInvokable("MessageReceived")]
    public async Task MessageReceived(int userId)
    {
        Console.WriteLine($"[Push] MessageReceived called. userId: {userId}");

        if (SignalRClient is not null && SignalRClient.CurrentUser != null) 
        {
            await SignalRClient.SetMessageCount(SignalRClient.CurrentUser.UnreadMessagesCount + 1);
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("[Push] MessageReceived: CurrentUser is null — cannot update unread count.");
        }

        // Update the messages pane if it is currently displayed
        OnMessageReceived?.Invoke(userId);
    }


    private async void DoShowLogin()
    {
        // The Login component is always rendered, but guard anyway so an
        // async-void NRE can never crash the app during startup auth checks.
        if (loginComponent is null)
        {
            StateHasChanged();
            return;
        }

        await ShowLogin();
    }

    private async void DoShowSubscribe()
    {
        await ShowSubscribe();
    }

    public async Task ShowLogin()
    {
        // Disable all the controls so we can't tab to them by accident
        wrapperDivClass = "disableHtml";
        disableMainContent = true;
        StateHasChanged();

        await CallLoginMethod();
    }

    public async Task ShowSubscribe()
    {
        // Disable all the controls so we can't tab to them by accident
        wrapperDivClass = "disableHtml";
        disableMainContent = true;
        StateHasChanged();

        await CallSubscribeMethod();
    }

    public void HandleLoginFinished()
    {
        wrapperDivClass = "";
        disableMainContent = false;
        StateHasChanged();
    }

    public async Task HandleSubscribeFinished()
    {
        wrapperDivClass = "";
        disableMainContent = false;
        OnSubscribeClosed?.Invoke();

        // Refresh the cached user so a just-completed purchase (e.g. Apple/Google IAP)
        // immediately reflects in subscription-dependent UI like the SupportCard. The
        // SignalR connection is usually already established, so Initialize() alone would
        // not re-fetch the profile; RefreshCurrentUserAsync re-runs the Connect handshake.
        try
        {
            if (SignalRClient is not null)
            {
                await SignalRClient.RefreshCurrentUserAsync();
            }
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "MainLayout.HandleSubscribeFinished");
        }

        StateHasChanged();
    }

    public async Task Logout()
    {
        // SignalRClient.Logout() handles clearing the server-side push token
        // and unregistering the browser-side push subscription
        if (SignalRClient is not null)
            await SignalRClient.Logout();
        NavManager.NavigateTo("/", forceLoad: true);
    }



    private bool CheckForBasicInfo()
    {
        // Check if the user is missing any of the basic information in their profile.
        // The layout renders the EnterBasicInfo gate directly when this returns false.
        var user = SignalRClient?.CurrentUser;
        if (user == null) return false;

        if (user.Description == ""
            || user.Gender <= 1
            || string.IsNullOrWhiteSpace(user.Name)
            || user.DateOfBirth == null
            || user.Geonameid == 0
            || string.IsNullOrWhiteSpace(user.Description)
            || user.Thumbnail == Guid.Empty
        )
        {
            return false;
        }
        return true;
    }

    private bool NeedsTermsAcceptance()
    {
        var user = SignalRClient?.CurrentUser;
        if (user == null) return false;
        return (user.AcceptedTermsVersion ?? 0) < CompanioNationPWA.Pages.Terms.CURRENT_TERMS_VERSION;
    }

    private void HandleTermsAccepted()
    {
        _showTerms = false;
        _needsBasicInfo = !CheckForBasicInfo();
        _needsEmailVerification = !_needsBasicInfo && !IsVerified();
        StateHasChanged();
    }

    private bool IsVerified()
    {
        return SignalRClient?.CurrentUser?.Verified ?? false;
    }

    /// <summary>
    /// Marks the basic-info gate as satisfied after EnterBasicInfo saves a
    /// complete profile. Without this, the layout keeps rendering the empty
    /// "needs basic info" placeholder after navigating back to "/".
    /// </summary>
    public void HandleBasicInfoCompleted()
    {
        _needsBasicInfo = false;
        _needsEmailVerification = !IsVerified();
        StateHasChanged();
    }



    private async Task NavigateToSafe(string i_url) {
        await JSRuntime.InvokeVoidAsync("disableScrolling");
        NavManager.NavigateTo(i_url);
        await JSRuntime.InvokeVoidAsync("enableScrolling");
    }
}


<script>
    // JavaScript function to focus the element by ID directly
    window.focusElementById = function (elementId) {
        const element = document.getElementById(elementId);
        if (element) {
            setTimeout(() => {
                element.focus();
            });
        } else {
            console.warn(`Element with ID ${elementId} not found.`);
        }
    };

    window.setDotNetObjectReference = function (dotNetObjectRef) {
        window.dotNetObject = dotNetObjectRef;
        // If a native iOS notification was tapped BEFORE Blazor booted (cold launch),
        // pwa-install.js stashed the target URL on window._cnPendingNavigateUrl.
        // Now that .NET is reachable, flush it so we land on the conversation.
        try {
            if (window._cnPendingNavigateUrl) {
                var pending = window._cnPendingNavigateUrl;
                window._cnPendingNavigateUrl = null;
                console.info('[Push] Flushing pending navigation post-boot:', pending);
                dotNetObjectRef.invokeMethodAsync('NavigateToUrl', pending);

                // NavigateToUrl hides the overlay once the SPA navigation lands; this
                // is a defensive fallback in case the invokable can't be reached.
                if (window.cnHideDeepLinkOverlay) window.cnHideDeepLinkOverlay();
            }
        } catch (e) {
            console.warn('[Push] Failed to flush pending navigation:', e);
            if (window.cnHideDeepLinkOverlay) window.cnHideDeepLinkOverlay();
        }
    }
    window.callSetInstallBannerState = function () {
        if (window.dotNetObject) {
            console.info("callSetInstallBannerState");
            window.dotNetObject.invokeMethodAsync("SetInstallBannerState");
        }
    }
    window.sendPushTokenToServer = function (pushToken) {
        if (window.dotNetObject) {
            console.info("sendPushTokenToServer");
            window.dotNetObject.invokeMethodAsync("SendPushTokenToServer", pushToken);
        }
    }
    window.callMessageReceivedEvent = function (userId) {
        if (window.dotNetObject) {
            console.info('[Push] Forwarding message_received to Blazor. userId:', userId);
            window.dotNetObject.invokeMethodAsync("MessageReceived", userId);
        } else {
            console.warn('[Push] callMessageReceivedEvent: dotNetObject not available yet — Blazor may not have booted.');
        }
    }

    window.addEventListener("appinstalled", (event) => {
        console.info("app installed");
        window.callSetInstallBannerState();
    });

    navigator.serviceWorker.addEventListener('message', (event) => {
        if (event.data.action === 'message_received') {
            console.info('[Push] SW message: message_received. userId:', event.data.userId);
            window.callMessageReceivedEvent(event.data.userId);
        } else if (event.data.action === 'navigate_to' && event.data.url) {
            console.info('[Push] SW message: navigate_to. url:', event.data.url);
            if (window.dotNetObject) {
                window.dotNetObject.invokeMethodAsync("NavigateToUrl", event.data.url);
            } else {
                // Blazor not booted yet — stash the target so the setDotNetObjectReference
                // flush performs the SPA navigation after boot, and show the "Opening link…"
                // overlay so the user isn't staring at the main screen in the meantime.
                console.warn('[Push] navigate_to: dotNetObject not available — stashing for post-boot flush.');
                window._cnPendingNavigateUrl = event.data.url;
                if (window.cnShowDeepLinkOverlay) window.cnShowDeepLinkOverlay(event.data.url);
            }
        } else {
            console.info('[Push] SW message: unhandled action:', event.data.action, event.data);
        }
    });

    //window.postMessage({ action: 'message_received', userId: 0 });

    function disableScrolling() {
        document.body.style.overflow = 'hidden';
    }

    function enableScrolling() {
        document.body.style.overflow = 'auto';
    }

    function shouldShowIosInstallButton() { 
        // iOS stuff
        const iOSCanInstall = 'standalone' in window.navigator;
        const iOSIsInstalled = window.navigator.standalone === true;
        return (iOSCanInstall && !iOSIsInstalled);
    }

    async function shouldShowEnableNotifications() {
        // Native iOS app: only show the banner while permission is still promptable
        // (notDetermined). Once the user has authorized or denied at the OS level,
        // tapping the button can no longer prompt, so keep the banner hidden.
        if (window.isNativeIosApp && window.isNativeIosApp()) {
            try {
                const state = await window.getNativeIosPushState();
                return state === 'notDetermined';
            } catch (e) {
                console.warn('[Push] Could not query native iOS push state — hiding banner:', e);
                return false;
            }
        }

        // Web / Android TWA / installed PWA: show the banner whenever notification
        // permission is still promptable ('default'). Browsers only allow a permission
        // prompt from a user gesture, so this banner is the ONLY way the user can grant
        // permission and get a push token — it must be reachable in every context, not
        // just when installed/standalone.
        if (typeof Notification === 'undefined') return false;
        return Notification.permission === 'default';
    }

    // Wait for any pending service worker update to finish, then reload.
    // The new SW's onActivate handler cleans up old caches automatically —
    // we must NOT delete them here or the new SW loses its freshly-built cache.
    var _refreshInProgress = false;
    async function refreshForUpdate() {
        // Guard against multiple clicks while the update is in progress
        if (_refreshInProgress) return;
        _refreshInProgress = true;

        // Hide the prompt and show the progress bar with phase text
        var prompt = document.querySelector('.update-toast-prompt');
        var progress = document.querySelector('.update-toast-progress');
        var phaseText = document.querySelector('.update-toast-phase');
        if (prompt) prompt.style.display = 'none';
        if (progress) progress.style.display = 'flex';
        if (phaseText) phaseText.textContent = 'Downloading...';

        // Suppress the yellow error bar during reload — any error that fires
        // while we're tearing down is irrelevant since the page is reloading.
        window._isRefreshing = true;
        var errorUi = document.getElementById('blazor-error-ui');
        if (errorUi) errorUi.style.display = 'none';

        try {
            const registration = await navigator.serviceWorker.getRegistration();
            if (registration) {
                // Listen before update() so we catch the new worker even when the
                // browser surfaces it asynchronously via 'updatefound' (which does
                // not always happen before update() resolves).
                const updateFound = new Promise((resolve) =>
                    registration.addEventListener('updatefound', resolve, { once: true }));

                // Kick off an update check so the new SW starts installing
                // if the browser hasn't detected the change yet.
                await registration.update();

                let pending = registration.installing || registration.waiting;
                if (!pending) {
                    // If the active worker already controls this page, the update is
                    // fully applied and we can reload immediately. Otherwise give the
                    // browser a short window to surface the new worker, since some
                    // browsers resolve update() before exposing it.
                    if (!(registration.active && navigator.serviceWorker.controller === registration.active)) {
                        await Promise.race([
                            updateFound,
                            new Promise((resolve) => setTimeout(resolve, 5000))
                        ]);
                        pending = registration.installing || registration.waiting;
                    }
                }

                if (pending) {
                    // Wait for the new SW to reach 'activated' (or 'redundant'
                    // if another update supersedes it). Safety timeout prevents
                    // an infinite hang on flaky connections.
                    await new Promise((resolve) => {
                        const timeout = setTimeout(resolve, 30000);
                        function onStateChange() {
                            if (phaseText) {
                                switch (pending.state) {
                                    case 'installing': phaseText.textContent = 'Downloading...'; break;
                                    case 'installed': phaseText.textContent = 'Installing...'; break;
                                    case 'activating': phaseText.textContent = 'Applying update...'; break;
                                    case 'activated': phaseText.textContent = 'Reloading...'; break;
                                }
                            }
                            if (pending.state === 'activated' || pending.state === 'redundant') {
                                clearTimeout(timeout);
                                pending.removeEventListener('statechange', onStateChange);
                                resolve();
                            }
                        }
                        pending.addEventListener('statechange', onStateChange);
                        onStateChange();
                    });
                }

                // Do not reload until this page is actually controlled by the new
                // worker. Reloading while the old worker still controls the page
                // serves the old cached _framework assets, boots the stale client,
                // and immediately re-triggers the "new version" toast.
                const active = registration.active;
                if (active && navigator.serviceWorker.controller !== active) {
                    await new Promise((resolve) => {
                        const timeout = setTimeout(resolve, 10000);
                        const onControllerChange = () => {
                            clearTimeout(timeout);
                            navigator.serviceWorker.removeEventListener('controllerchange', onControllerChange);
                            resolve();
                        };
                        navigator.serviceWorker.addEventListener('controllerchange', onControllerChange);
                    });
                }
            }
        } catch (e) {
            console.warn('Service worker update check failed, reloading anyway:', e);
        }

        window.location.reload();
    }
    window.refreshForUpdate = refreshForUpdate;

    function navigateToCurrentPage() {
        console.info("navigating to current page...");
        // Redirect to the current URL, forcing Blazor to handle it
        window.dotNetObject.invokeMethodAsync("NavigateToCurrentPage");
    }
    window.navigateToCurrentPage = navigateToCurrentPage;

</script>


@* The Login popup must always be rendered (hidden by default) so it is
   available even while the startup loading overlay is still showing. A
