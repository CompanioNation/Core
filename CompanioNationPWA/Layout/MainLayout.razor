<div class="@wrapperDivClass" inert="@disableMainContent">
        <main id="fullPageDiv" class="fullPage">
            @if ((IsPage("Home") || IsPage("")) && !string.IsNullOrWhiteSpace(_verificationMessage))
            {
                <div class="@(_verificationMessageIsError ? "error-message" : "success-message")">@_verificationMessage</div>
            }
            @if (IsPage("Home") || IsPage(""))
            {
                <div id="installBanner" class="topBanner @showInstallBanner">
                    <button class="greenButton" onclick="window.promptPWAInstall()"><img src="favicon.png" alt="" width="512" height="512" class="installIcon" /> &nbsp; @Loc["MainLayout_Install"] </button>
                    <br />
                    @Loc["MainLayout_AgreePrivacyPrefix"]<a href="/PrivacyPolicy">@Loc["MainLayout_PrivacyPolicy"]</a>@Loc["MainLayout_AgreePrivacySuffix"]
                </div>
                <div id="iosInstallBanner" class="topBanner @showIosInstallBanner">
                    <img src="favicon.png" alt="" width="512" height="512" class="installIcon" /> &nbsp; @Loc["MainLayout_Install"]
                    <br /><br />
                    @Loc["MainLayout_IosInstallHintBefore"] <img src="images/768px-Ei-share-apple.svg.png" alt="" width="768" height="768" class="installIcon" /> @Loc["MainLayout_IosInstallHintAfter"]
                    <br />
                    @Loc["MainLayout_AgreePrivacyInstallPrefix"]<a href="/PrivacyPolicy">@Loc["MainLayout_PrivacyPolicy"]</a>@Loc["MainLayout_AgreePrivacySuffix"]
                </div>
                <div id="enableNotificationsBanner" class="topBanner @showEnableNotificationsBanner">
                    @* IMPORTANT: For web/Android we must call Notification.requestPermission()
                       synchronously from this click handler. Going through a Blazor
                       [JSInvokable] first (button -> invokeMethodAsync -> C# await ->
                       JSRuntime.InvokeAsync) crosses two async boundaries and Chrome on
                       Android drops the prompt silently (the console shows "Current
                       permission state: default" but never a "Permission prompt result:"
                       line, so the button appears dead). enableNotificationsFromClick()
                       runs the prompt first, then hands the result back to Blazor. On
                       native iOS the JS shim short-circuits and defers to the existing
                       Blazor EnableNotifications flow. *@
                    <button id="enableNotificationsButton" onclick="if (window.isNativeIosApp && window.isNativeIosApp()) { window.dotNetObject.invokeMethodAsync('EnableNotifications'); } else { window.enableNotificationsFromClick(); }">
                        <span class="notification-icon">🔔</span> @Loc["MainLayout_EnableNotifications"]
                    </button>
                </div>
            }
            @if (IsPage("PrivacyPolicy") || IsPage("ResetPassword") || IsPage("EnterBasicInfo") 
            || IsPage("CompanioNitasCorner") || IsPage("ConfirmConnection") || IsPage("auth") || IsPage("Contact"))
            {
                <CompanioNationLogo />
                <CascadingValue Value="@this">
                    @Body
                </CascadingValue>
                <Footer />
            } 
            else if (!isLoggedIn)
            {
                @if (SignalRClient is not null && SignalRClient.IsPrerendering && IsDeepLinkRoute())
                {
                    @* During SSR we don't know the auth state yet. For a deep link
                       (e.g. /Settings?emailChangeCode=... from an email) show an
                       "Opening link…" placeholder instead of the landing page, so the
                       main screen doesn't flash while the WASM runtime boots. *@
                    <CompanioNationLogo />
                    <div class="loading">
                        <p>@Loc["MainLayout_OpeningLink"]</p>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-label="@Loc["MainLayout_OpeningLink"]" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width: 100%"></div>
                        </div>
                    </div>
                }
                else
                {
                    <CompanioNationPWA.Pages.LandingPage MainLayoutInstance="@this"></CompanioNationPWA.Pages.LandingPage>
                }
            }
            else if (_showTerms)
            {
                <CompanioNationPWA.Pages.Terms OnTermsAccepted="HandleTermsAccepted" />
            }
            else if (_needsBasicInfo)
            {
                <CompanioNationLogo />
                <CascadingValue Value="@this">
                    <CompanioNationPWA.Pages.EnterBasicInfo />
                </CascadingValue>
                <Footer />
            }
            else if (_needsEmailVerification)
            {
                <CompanioNationLogo />
                <div class="content" style="max-width:600px;margin:0 auto;padding:2rem 1rem;text-align:center;">
                    <h3>@Loc["MainLayout_CheckEmailTitle"]</h3>
                    <p>@Loc["MainLayout_CheckEmailBody"]</p>
                    <button class="btn btn-primary" @onclick="ResendVerificationEmail" disabled="@_resendingVerification">
                        @(_resendingVerification ? Loc["MainLayout_ResendVerificationSending"] : Loc["MainLayout_ResendVerification"])
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_resendVerificationMessage))
                    {
                        <p>@_resendVerificationMessage</p>
                    }
                </div>
                <Footer />
            }
            else
            {
                <CustomErrorBoundary>
                    <div id="mainlayout_content" class="content">
                        <CascadingValue Value="@this">
                            @Body
                        </CascadingValue>
                    </div>
                </CustomErrorBoundary>


                <div class="button-container">
                    <a class="button ai" href="/" @onclick='() => NavigateToSafe("/")' @onclick:preventDefault>
                        <img src="/images/CompanioNita.png" alt="" width="512" height="512" />
                        <span>@Loc["MainLayout_NavAdvice"]</span>
                    </a>
                    <a class="button messages" href="/Messages" @onclick='() => NavigateToSafe("/Messages")' @onclick:preventDefault>
                        <img src="/images/messages.png" alt="" width="800" height="700" />
                        <span>@Loc["MainLayout_NavMessages"]</span>
                        @if (SignalRClient?.CurrentUser?.UnreadMessagesCount > 0)
                        {
                            <span class="unread-badge">@SignalRClient?.CurrentUser?.UnreadMessagesCount</span>
                        }
                    </a>
                    <a class="button find" href="/FindCompanion" @onclick='() => NavigateToSafe("/FindCompanion")' @onclick:preventDefault>
                        <img src="/images/find.png" alt="" width="500" height="500" />
                        <span>@Loc["MainLayout_NavFind"]</span>
                    </a>
                    <a class="button guarantee" href="/Link" @onclick='() => NavigateToSafe("/Link")' @onclick:preventDefault>
                        <img src="/images/rope.png" alt="" width="256" height="256" />
                        <span>@Loc["MainLayout_NavLink"]</span>
                    </a>
                    <a class="button settings" href="/Settings" @onclick='() => NavigateToSafe("/Settings")' @onclick:preventDefault>
                        <img src="/images/settings.png" alt="" width="500" height="500" />
                        <span>@Loc["MainLayout_NavSettings"]</span>
                    </a>
                </div>

            }

        </main>
    </div>

@if (_maintenanceActive)
{
