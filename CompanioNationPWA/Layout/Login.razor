@inject IJSRuntime JSRuntime
@inject ICompanioNationSignalRClient? SignalRClient
@inject NavigationManager NavManager
@inject IStringLocalizer<Login> Loc
@using CompanioNation.Shared
@using System.Text.RegularExpressions
@implements IAsyncDisposable

<div id="loginPopup" class="loginPopupClass" hidden="@loginHidden">
    <div id="centerPane">
        @if (_loggingIn)
        {
            <div class="loading-indicator">@Loc["Login_Processing"]</div>
        }
        else if (!_isEmailChecked)
        {
            <h2>@Loc["Login_Title"]</h2>
            <h3>@Loc["Login_EnterEmail"]</h3>
            <input id="email" name="email" @ref="emailText" @bind="email" type="text" class="loginText" placeholder="@Loc["Login_EmailPlaceholder"]" @onkeyup="HandleKeyPress" autocomplete="username email" required />

            @if (HasAnyOAuthProvider)
            {
                <div class="login-divider">@Loc["Login_OrContinueWith"]</div>
            }
            @if (_isNativeIos)
            {
                if (_oauthConfig?.AppleServiceId is { Length: > 0 })
                {
                    <AppleSignInButton OnClick="LoginWithApple" />
                }
                if (_oauthConfig?.GoogleClientId is { Length: > 0 })
                {
                    <GoogleSignInButton OnClick="LoginWithGoogle" />
                }
            }
            else
            {
                if (_oauthConfig?.GoogleClientId is { Length: > 0 })
                {
                    <GoogleSignInButton OnClick="LoginWithGoogle" />
                }
                if (_oauthConfig?.AppleServiceId is { Length: > 0 })
                {
                    <AppleSignInButton OnClick="LoginWithApple" />
                }
            }
            @if (_oauthConfig?.FacebookAppId is { Length: > 0 })
            {
                <FacebookSignInButton OnClick="LoginWithFacebook" />
            }
            @if (_oauthConfig?.TwitterClientId is { Length: > 0 })
            {
                <XSignInButton OnClick="LoginWithX" />
            }
            @if (_oauthConfig?.MicrosoftClientId is { Length: > 0 })
            {
                <MicrosoftSignInButton OnClick="LoginWithMicrosoft" />
            }

        }
        else if (_isEmailChecked && !_isNewAccount && _oauthRequired)
        {
            <div>
                <h3>@Loc["Login_AccountFound"]</h3>
                <p>@Loc["Login_AccountNoPassword"]</p>

                @if (_isNativeIos)
                {
                    if (_oauthConfig?.AppleServiceId is { Length: > 0 })
                    {
                        <AppleSignInButton OnClick="LoginWithApple" />
                    }
                    if (_oauthConfig?.GoogleClientId is { Length: > 0 })
                    {
                        <GoogleSignInButton OnClick="LoginWithGoogle" />
                    }
                }
                else
                {
                    if (_oauthConfig?.GoogleClientId is { Length: > 0 })
                    {
                        <GoogleSignInButton OnClick="LoginWithGoogle" />
                    }
                    if (_oauthConfig?.AppleServiceId is { Length: > 0 })
                    {
                        <AppleSignInButton OnClick="LoginWithApple" />
                    }
                }
                @if (_oauthConfig?.FacebookAppId is { Length: > 0 })
                {
                    <FacebookSignInButton OnClick="LoginWithFacebook" />
                }
                @if (_oauthConfig?.TwitterClientId is { Length: > 0 })
                {
                    <XSignInButton OnClick="LoginWithX" />
                }
                @if (_oauthConfig?.MicrosoftClientId is { Length: > 0 })
                {
                    <MicrosoftSignInButton OnClick="LoginWithMicrosoft" />
                }

                <br />
                <button type="button" @onclick="ForgotPassword" class="blueButton" style="margin-top:0.75em;">@Loc["Login_AssignPassword"]</button>
            </div>
        }
        else if (_isEmailChecked && !_isNewAccount)
        {
            <div>
                <h3>@Loc["Login_EnterPassword"]</h3>
                <input id="password" name="password" @bind="password" type="password" class="loginText" placeholder="@Loc["Login_PasswordPlaceholder"]" @onkeyup="HandleKeyPress" autocomplete="current-password" required />
                <br />
                <a @onclick="ForgotPassword">@Loc["Login_ForgotPassword"]</a>
            </div>
        }
        else if (_isEmailChecked && _isNewAccount)
        {
            <div>
                <h3>@Loc["Login_CreateAccountTitle"]</h3>
                <input id="password" name="password" @bind="password" type="password" class="loginText" placeholder="@Loc["Login_PasswordPlaceholder"]" @onkeyup="HandleKeyPress" autocomplete="new-password" required />
                <br /><br />
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-message">@_errorMessage</div>
        }
        else if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="success-message">@_successMessage</div>
        }
        else
        {
            <div class="success-message">&nbsp;</div>
        }

        <div class="button-container">
            @if (!_isEmailChecked)
            {
                <button @ref="loginButton" @onclick="CheckEmail" type="submit" class="blueButton">@Loc["Login_Next"]</button>
            }
            else if (_isNewAccount)
            {
                <button @ref="loginButton" @onclick="CreateAccountAndLogin" type="submit" class="blueButton">@Loc["Login_CreateAccount"]</button>
            }
            else if (!_oauthRequired)
            {
                <button @ref="loginButton" @onclick="DoLogin" type="submit" class="blueButton">@Loc["Login_Login"]</button>
            }
            &nbsp;
            <button @onclick="Cancel" class="grayButton">@Loc["Login_Cancel"]</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnLoginFinished { get; set; }

    private ElementReference loginButton;
    private ElementReference emailText;
    private IJSObjectReference? _mod;

    bool loginHidden = true;
    string email = "";
    string password = "";

    bool _loggingIn = false;
    string _errorMessage = "";
    string _successMessage = "";

    bool _isEmailChecked = false;
    bool _isNewAccount = false;
    bool _oauthRequired = false;
    bool _isNativeIos = false;
    private OAuthConfig? _oauthConfig;

    // The "or continue with" divider only makes sense when at least one
    // OAuth button is rendered below it.
    private bool HasAnyOAuthProvider =>
        _oauthConfig?.AppleServiceId is { Length: > 0 } ||
        _oauthConfig?.GoogleClientId is { Length: > 0 } ||
        _oauthConfig?.FacebookAppId is { Length: > 0 } ||
        _oauthConfig?.TwitterClientId is { Length: > 0 } ||
        _oauthConfig?.MicrosoftClientId is { Length: > 0 };


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _mod = await JSRuntime.ImportModuleAsync(
                "/Layout/Login.razor.js",
                SignalRClient is not null ? SignalRClient.LogError : null);

            // Fetch public OAuth client IDs from the server (reads from environment variables)
            if (SignalRClient is not null)
            {
                try
                {
                    var oauthConfig = await SignalRClient.GetOAuthConfig();
                    if (oauthConfig.IsSuccess && oauthConfig.Data != null)
                    {
                        _oauthConfig = oauthConfig.Data;
                        var cfg = oauthConfig.Data;
                        await JSRuntime.InvokeVoidAsync("eval",
                            $"window.googleClientId='{EscapeJsString(cfg.GoogleClientId)}';" +
                            $"window.appleServiceId='{EscapeJsString(cfg.AppleServiceId)}';" +
                            $"window.facebookAppId='{EscapeJsString(cfg.FacebookAppId)}';" +
                            $"window.twitterClientId='{EscapeJsString(cfg.TwitterClientId)}';" +
                            $"window.microsoftClientId='{EscapeJsString(cfg.MicrosoftClientId)}';");
                        StateHasChanged();
                    }
                }
                catch { /* best effort — JS helpers guard against missing IDs */ }
            }

            // Detect native iOS so we can show Apple Sign-In first on that platform.
            try
            {
                _isNativeIos = await JSRuntime.InvokeAsync<bool>("isNativeIosApp");
                if (_isNativeIos)
                {
                    StateHasChanged();
                }
            }
            catch
            {
                _isNativeIos = false;
            }
        }
    }

    public async ValueTask DisposeAsync()
        => await (_mod?.DisposeAsync() ?? ValueTask.CompletedTask);

    public Task ShowLogin()
    {
        // If the popup is already visible, don't reset the form — a second
        // hub-error arriving while the user is mid-login shouldn't wipe their
        // typed email/password.
        if (!loginHidden)
            return Task.CompletedTask;

        _errorMessage = "";
        _loggingIn = false;
        loginHidden = false;
        _isEmailChecked = false;
        _isNewAccount = false;
        _oauthRequired = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public async Task HideLogin()
    {
        loginHidden = true;
        await OnLoginFinished.InvokeAsync();
    }

    private bool IsValidEmail(string email)
    {
        email = email.Trim(); // Trim whitespace
        var emailPattern = @"^[^@\s]+@[^@\s]+\.[^@\s]+$";
        return Regex.IsMatch(email, emailPattern);
    }

    private async Task CheckEmail()
    {
        _loggingIn = true;
        _errorMessage = "";

        email = email.Trim(); // Trim whitespace

        if (!IsValidEmail(email))
        {
            _errorMessage = Loc["Login_InvalidEmail"];
            _loggingIn = false;
            StateHasChanged();
            return;
        }

        // Return value indicates whether OAuth login is required
        if (SignalRClient is null) return;
        CheckEmailResult result = await SignalRClient.CheckEmailExists(email);
        _loggingIn = false;

        // If the email exists and we do not require oauth (because there is a password assigned, then prompt for a password)
        if (result.emailExists)
        {
            _isEmailChecked = true;
            _isNewAccount = false;
            if (result.oauthRequired)
            {
                _oauthRequired = true;
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("focusElementById", "password");
            }
        }
        else
        {
            _isEmailChecked = true;
            _isNewAccount = true;
            _oauthRequired = false;
            await JSRuntime.InvokeVoidAsync("focusElementById", "password");
        }

        StateHasChanged();
    }

    private async Task CreateAccountAndLogin()
    {
        if (SignalRClient is null) return;

        _loggingIn = true;
        _errorMessage = "";
        StateHasChanged();

        bool result = await SignalRClient.CreateNewUser(email, password);

        if (result)
        {
            await EmitAnalyticsEvent("sign_up", new { method = "email" });
            _successMessage = Loc["Login_AccountCreated"];
            await DoLogin();
        }
        else
        {
            // The account may have been created by a concurrent request or the
            // email may already exist. Re-check and redirect to login if so.
            CheckEmailResult checkResult = await SignalRClient.CheckEmailExists(email);
            if (checkResult.emailExists)
            {
                _isEmailChecked = true;
                _isNewAccount = false;
                _oauthRequired = checkResult.oauthRequired;
                if (!_oauthRequired)
                {
                    _errorMessage = Loc["Login_EmailExists"];
                    await JSRuntime.InvokeVoidAsync("focusElementById", "password");
                }
            }
            else
            {
                _errorMessage = Loc["Login_CreateFailed"];
            }

            _loggingIn = false;
            StateHasChanged();
        }
    }

    public async Task ForgotPassword()
    {
        NavManager.NavigateTo("/ResetPassword");
        await HideLogin();
    }

    private async Task Cancel()
    {
        await HideLogin();

        // If the user dismissed the login popup from a page that requires
        // authentication (e.g. a deep-linked conversation from a push
        // notification), send them back to the entry/landing page so they
        // aren't stranded on a page that can't function without a valid login.
        var currentPath = new Uri(NavManager.Uri).AbsolutePath.TrimStart('/');
        if (!string.IsNullOrEmpty(currentPath))
        {
            NavManager.NavigateTo("/", forceLoad: false);
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (!_isEmailChecked)
            {
                await CheckEmail();
            }
            else if (_isNewAccount)
            {
                await CreateAccountAndLogin();
            }
            else if (!_oauthRequired)
            {
                await DoLogin();
            }
        }
        else if (e.Key == "Escape")
        {
            await Cancel();
        }
    }

    private async Task DoLogin()
    {
        if (SignalRClient is null) return;

        _loggingIn = true;
        _errorMessage = "";

        ResponseWrapper<UserDetails> result = await SignalRClient.Login(email, password);

        if (result.IsSuccess)
        {
            await EmitAnalyticsEvent("login", new { method = "email" });
            await HideLogin();
            // Client-side navigation keeps the SignalR singleton alive, so the
            // layout sees CurrentUser immediately and no second boot happens.
            NavManager.NavigateTo("/", false);
        }
        else if (result.ErrorCode == 100000)
        {
            _errorMessage = Loc["Login_InvalidCredentials"];
        }
        else
        {
            _errorMessage = Loc["Login_UnknownError"];
        }

        _loggingIn = false;
        StateHasChanged();
    }

    private async Task LoginWithGoogle()
    {
        try
        {
            _loggingIn = true;
            _errorMessage = "";
            StateHasChanged();

            // Trigger full-page redirect to Google via GIS Code flow.
            // If the redirect succeeds the page unloads and nothing below runs.
            // In PWA/native-app scenarios the OAuth URL opens externally, so the
            // spinner stays visible until the callback page completes the login
            // and force-reloads the app.
            await JSRuntime.InvokeVoidAsync("googleLogin");
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Login.Google");
            _errorMessage = $"{Loc["Login_ErrorOccurred"]} {ex.Message}";
            _loggingIn = false;
            StateHasChanged();
        }
    }

    private async Task LoginWithApple()
    {
        try
        {
            _loggingIn = true;
            _errorMessage = "";
            StateHasChanged();

            // Same pattern as LoginWithGoogle — see comment there.
            await JSRuntime.InvokeVoidAsync("appleLogin");
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Login.Apple");
            _errorMessage = $"{Loc["Login_ErrorOccurred"]} {ex.Message}";
            _loggingIn = false;
            StateHasChanged();
        }
    }

    private async Task LoginWithFacebook()
    {
        try
        {
            _loggingIn = true;
            _errorMessage = "";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("facebookLogin");
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Login.Facebook");
            _errorMessage = $"{Loc["Login_ErrorOccurred"]} {ex.Message}";
            _loggingIn = false;
            StateHasChanged();
        }
    }

    private async Task LoginWithX()
    {
        try
        {
            _loggingIn = true;
            _errorMessage = "";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("twitterLogin");
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Login.X");
            _errorMessage = $"{Loc["Login_ErrorOccurred"]} {ex.Message}";
            _loggingIn = false;
            StateHasChanged();
        }
    }

    private async Task LoginWithMicrosoft()
    {
        try
        {
            _loggingIn = true;
            _errorMessage = "";
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("microsoftLogin");
        }
        catch (Exception ex)
        {
            SignalRClient?.LogError(ex, "Login.Microsoft");
            _errorMessage = $"{Loc["Login_ErrorOccurred"]} {ex.Message}";
            _loggingIn = false;
            StateHasChanged();
        }
    }

    // Escape a string for safe embedding
    private static string EscapeJsString(string value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return value.Replace("\\", "\\\\").Replace("'", "\\'");
    }

    // Fire-and-forget GA4 analytics event via the JS gaEvent() helper.
    // Never throws — analytics failures must not break auth flows.
    private async Task EmitAnalyticsEvent(string eventName, object? parameters = null)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("gaEvent", eventName, parameters);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Analytics] Failed to emit '{eventName}': {ex.Message}");
        }
    }
}
