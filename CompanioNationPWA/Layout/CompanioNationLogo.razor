@inject CompanioNationSignalRClient? SignalRClient
@inject IStringLocalizer<CompanioNationLogo> Loc
@code {
    string versionNumber = "";

    protected override async Task OnInitializedAsync()
    {
    }
    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && SignalRClient is not null)
        {
            string v = await SignalRClient.GetCurrentVersion();
            if (!string.IsNullOrEmpty(v)) versionNumber = "v" + v;
            StateHasChanged();
        }

    }
}
<div class="topLogo">
    <NavLink href="/"><img src="images/companionation_rounded_background.png" alt="@Loc["CompanioNationLogo_Alt"]" width="2200" height="512" fetchpriority="high" loading="eager" decoding="async" /></NavLink>

    <h4 class="companionation-tagline">@Loc["CompanioNationLogo_Tagline"] @(versionNumber)</h4>
</div>

<div class="separator"></div>
