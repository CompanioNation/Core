@namespace CompanioNation.Components
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SubscribeToCompanioNita> Loc

@*
    Open Source Stub Implementation of SubscribeToCompanioNita
    This is a simplified placeholder version for the open source repository.
    The full subscription functionality is available via CompanioNation.Components package.
*@

<div id="subscribePopup" class="subscribePopupClass" hidden="@subscribeHidden">
    <div id="centerPane">
        <h2>@Loc["Subscribe_Title"]</h2>

        @if (_processing)
        {
            <div class="loading-indicator">@Loc["Subscribe_Processing"]</div>
        }
        else
        {
            <div>
                <h3>@Loc["Subscribe_Heading"]</h3>
                <p>@Loc["Subscribe_Intro"]</p>
                <p>@Loc["Subscribe_UnderDevelopment"]</p>
                <br />
                <p>@Loc["Subscribe_CheckBack"]</p>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="error-message">@_errorMessage</div>
        }
        else if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="success-message">@_successMessage</div>
        }
        else
        {
            <div class="success-message">&nbsp;</div>
        }

        <div class="button-container">
            <button @onclick="Close" class="blueButton">@Loc["Subscribe_Ok"]</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? UserEmail { get; set; }

    [Parameter]
    public EventCallback OnSubscribeFinished { get; set; }

    private bool subscribeHidden = true;
    private bool _processing = false;
    private string _errorMessage = "";
    private string _successMessage = "";

    /// <summary>
    /// Host initialization hook. The host calls this once after first render and passes:
    ///   - <paramref name="registerHubConnected"/>: a delegate to subscribe a callback to the
    ///     host's hub-connected lifecycle event.
    ///   - <paramref name="logError"/>: the host's error sink, so the component can report
    ///     failures through the host's logging pipeline.
    /// This stub build has no background work to register, so the hook is intentionally a
    /// no-op; it exists only to keep the public surface identical to the full component package.
    /// </summary>
    public void Initialize(Action<Action> registerHubConnected, Func<Exception, string?, Task> logError)
    {
        // No-op in the open-source stub.
    }

    public async Task ShowSubscribe()
    {
        _errorMessage = "";
        _successMessage = "";
        _processing = false;
        subscribeHidden = false;
        StateHasChanged();
    }

    public async Task HideSubscribe()
    {
        subscribeHidden = true;
        await OnSubscribeFinished.InvokeAsync();
    }

    private async Task Close()
    {
        await HideSubscribe();
    }
}
