# Environment variables for the CompanioNation API
# Copy this file to myapp.env and adjust values as needed for local development.

# Database connection string (required)
COMPANIONATION_DATABASE=Server=(localdb)\MSSqlLocalDB;Database=CompanioNationDB;Trusted_Connection=True;TrustServerCertificate=True;

# Azure App Service slot name (Local in dev; set by Azure in staging/production)
SLOT_HOSTNAME=Local

# Azure storage settings (optional - local development uses Azurite if enabled)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER_NAME=companionation-dev

# Azure Base URL where photos are served from
COMPANIONATION_PHOTO_BASE_URL=http://localhost:10000/devstoreaccount1/companionation-dev/

# Public site origin used to build absolute links in outbound emails (password reset,
# email verification, LINK invites, subscription pages) and the sitemap.
# Defaults to https://companionation.com when unset.
# In Azure this MUST be a STICKY (slot) setting: production points at
# https://companionation.com, the staging (alt) slot at its own hostname.
COMPANIONATION_SITE_BASE_URL=

# Secret key for signing/verifying LINK QR code payloads (HMAC-SHA256, base64)
COMPANIONATION_LINK_SECRET=

# Google OAuth (optional - required only if enabling Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dedicated iOS OAuth client (native app sign-in via ASWebAuthenticationSession; PKCE-only)
GOOGLE_IOS_CLIENT_ID=

# Apple Sign-In (optional - required only if enabling Apple sign-in)
APPLE_TEAM_ID=
APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Facebook OAuth (optional - required only if enabling Facebook sign-in)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# X (Twitter) OAuth 2.0 (optional - required only if enabling X sign-in)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Microsoft OAuth (optional - required only if enabling Microsoft sign-in)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Tag Manager container ID (optional)
GTM_ID=

# Web Push Notifications - VAPID Private Key (Public key is in CompanioNation.Shared)
VAPID_PRIVATE_KEY=

# FCM (Firebase Cloud Messaging) - Native iOS/Android push notifications (optional).
# Paste the entire JSON content (on ONE line) from Firebase Console > Project Settings
# > Service Accounts > Generate New Private Key. Leave blank to disable native pushes.
FCM_SERVICE_ACCOUNT_JSON=

# Enable detailed SignalR error messages outside dev (dev/staging already have them on)
SIGNALR_DETAILED_ERRORS=false
